# ==============================================================================
# Enterprise Standard .gitignore for QR Code Maker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Environment & Bytecode Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
env/
venv/
ENV/
env.bak/
venv.bak/
.env
.venv/
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. Node & Frontend Build / Dependency Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.astro/
frontend/.astro/
dist/
frontend/dist/
coverage/
frontend/coverage/
.vite/
frontend/.vite/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Test & Temporary Scratch Artifacts
# ------------------------------------------------------------------------------
backend/test_*.png
backend/test_*.pdf
backend/test_out*.pdf
backend/test_out2.pdf
tmp/
temp/
*.tmp

# ------------------------------------------------------------------------------
# 4. Graphify Caches, Temporary Data & Misplaced Directories
# ------------------------------------------------------------------------------
graphify-out/cache/
graphify-out/memory/
graphify-out/.*
graphify-out/[0-9]*/
backend/graphify-out/
frontend/graphify-out/
frontend/src/graphify-out/

# ------------------------------------------------------------------------------
# 5. Local Vendor, Backups & Generated Audit Reports
# ------------------------------------------------------------------------------
Skills/
backups/
*.zip
seo_audit_report.json

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*.swp
*.swo
*~
.idea/
