---
import { getLocaleFromUrl, getLocalizedUrl, t } from '../../i18n/utils';
import { type Locale } from '../../i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
}

const currentLocale = (Astro.props.locale || getLocaleFromUrl(Astro.url)) as Locale;
const currentPath = Astro.url.pathname;

const homeUrl = getLocalizedUrl(currentLocale, '/');
const howToUrl = getLocalizedUrl(currentLocale, '/how-to-use');
const blogUrl = getLocalizedUrl(currentLocale, '/blog');
const scannerUrl = getLocalizedUrl(currentLocale, '/qr-code-scanner');

const isHome = currentPath === homeUrl || currentPath === `${homeUrl}/`;
const isHowTo = currentPath.startsWith(howToUrl);
const isBlog = currentPath.startsWith(blogUrl);
const isScanner = currentPath.startsWith(scannerUrl);
---
<nav class="w-full top-0 z-50 bg-surface-container-lowest border-b border-outline-variant shadow-sm backdrop-blur-md bg-opacity-95 safe-top sticky">
  <div class="flex justify-between items-center h-14 sm:h-16 px-4 sm:px-6 max-w-[1400px] mx-auto w-full">
    <div class="flex items-center gap-4 sm:gap-8">
      <!-- Premium Brand Wordmark -->
      <a href={homeUrl} class="flex items-center gap-2.5 group shrink-0" title="GenerateCustomQR — Home">
        <div class="w-8 h-8 flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-full h-full drop-shadow-sm group-hover:drop-shadow-md transition-all">
            <defs>
              <mask id="header-logo-mask">
                <rect width="100" height="100" fill="white"/>
                <rect x="21" y="21" width="14" height="14" rx="4" fill="black"/>
                <rect x="65" y="21" width="14" height="14" rx="4" fill="black"/>
                <rect x="21" y="65" width="14" height="14" rx="4" fill="black"/>
              </mask>
            </defs>
            <g mask="url(#header-logo-mask)" fill="#18181b">
              <rect x="8" y="8" width="40" height="40" rx="12"/>
              <rect x="52" y="8" width="40" height="40" rx="12"/>
              <rect x="8" y="52" width="40" height="40" rx="12"/>
            </g>
            <g>
              <rect x="54" y="54" width="18" height="18" rx="6" fill="#18181b"/>
              <rect x="54" y="76" width="12" height="12" rx="4" fill="#71717a"/>
              <rect x="70" y="76" width="12" height="12" rx="4" fill="#18181b"/>
            </g>
          </svg>
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-[14px] font-bold tracking-tight bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent whitespace-nowrap">GenerateCustomQR</span>
          <span class="text-[9px] font-medium text-on-surface-variant tracking-wider hidden sm:block whitespace-nowrap">{t(currentLocale, 'nav.brandTagline')}</span>
        </div>
      </a>
      <div class="hidden md:flex items-center gap-5 lg:gap-6">
        <a
          href={homeUrl}
          class={`text-sm font-semibold transition-colors duration-200 ${isHome ? "text-on-surface border-b-2 border-primary pb-1" : "text-on-surface-variant hover:text-on-surface"}`}
          {...(isHome ? { "aria-current": "page" } : {})}
        >
          {t(currentLocale, 'nav.generator')}
        </a>
        <a
          href={howToUrl}
          class={`text-sm font-semibold transition-colors duration-200 flex items-center gap-1 ${isHowTo ? "text-on-surface border-b-2 border-primary pb-1" : "text-on-surface-variant hover:text-on-surface"}`}
          {...(isHowTo ? { "aria-current": "page" } : {})}
        >
          <span class="material-symbols-outlined text-[16px]">help_outline</span>
          {t(currentLocale, 'nav.guide')}
        </a>
        <a
          href={blogUrl}
          class={`text-sm font-semibold transition-colors duration-200 flex items-center gap-1 ${isBlog ? "text-on-surface border-b-2 border-primary pb-1" : "text-on-surface-variant hover:text-on-surface"}`}
          {...(isBlog ? { "aria-current": "page" } : {})}
        >
          <span class="material-symbols-outlined text-[16px]">rss_feed</span>
          {t(currentLocale, 'nav.blog')}
        </a>
        <a
          href={scannerUrl}
          class={`text-sm font-bold transition-colors flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border ${isScanner ? "text-primary bg-primary/10 border-primary/30" : "text-on-surface hover:text-primary hover:bg-surface-container border-outline-variant/30"}`}
          {...(isScanner ? { "aria-current": "page" } : {})}
        >
          <span class="material-symbols-outlined text-[16px]">qr_code_scanner</span>
          {t(currentLocale, 'nav.scan')}
        </a>
      </div>
    </div>

    <!-- Right Area: Language Switcher + Mobile Menu Button -->
    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageSwitcher />

      <!-- Mobile Menu Button (requires client-side JS) -->
      <button
        id="mobile-menu-btn"
        class="md:hidden w-10 h-10 flex items-center justify-center rounded-xl hover:bg-surface-container transition-colors touch-press text-on-surface"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
  
  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-outline-variant bg-surface-container-lowest px-4 py-3 space-y-1 shadow-lg">
    <a
      href={homeUrl}
      class={`w-full flex items-center gap-3 p-2.5 rounded-xl min-h-[44px] font-bold ${isHome ? "bg-primary/10 text-primary" : "text-on-surface-variant hover:bg-surface-container"}`}
    >
      <span class="material-symbols-outlined text-[20px]">qr_code_2</span>
      {t(currentLocale, 'nav.generator')}
    </a>
    <a
      href={howToUrl}
      class={`w-full flex items-center gap-3 p-2.5 rounded-xl min-h-[44px] font-bold ${isHowTo ? "bg-primary/10 text-primary" : "text-on-surface-variant hover:bg-surface-container"}`}
    >
      <span class="material-symbols-outlined text-[20px]">help_outline</span>
      {t(currentLocale, 'nav.guide')}
    </a>
    <a
      href={blogUrl}
      class={`w-full flex items-center gap-3 p-2.5 rounded-xl min-h-[44px] font-bold ${isBlog ? "bg-primary/10 text-primary" : "text-on-surface-variant hover:bg-surface-container"}`}
    >
      <span class="material-symbols-outlined text-[20px]">rss_feed</span>
      {t(currentLocale, 'nav.blog')}
    </a>
    <a
      href={scannerUrl}
      class={`w-full flex items-center gap-3 p-2.5 rounded-xl min-h-[44px] font-bold ${isScanner ? "text-primary bg-primary/5 border border-primary/20" : "text-on-surface-variant hover:bg-surface-container"}`}
    >
      <span class="material-symbols-outlined text-[20px]">qr_code_scanner</span>
      {t(currentLocale, 'nav.scanQR')}
    </a>
  </div>
</nav>

<script>
  // Fast, idempotent mobile menu toggle script
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    
    if (btn && menu) {
      if (btn.dataset.initialized === 'true') return;
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const isHidden = menu.classList.toggle('hidden');
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden', !isHidden);
          iconClose.classList.toggle('hidden', isHidden);
        }
        btn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });
    }
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
