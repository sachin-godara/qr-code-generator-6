---
const currentPath = Astro.url.pathname;
---
<nav class="w-full top-0 z-50 bg-surface-container-lowest border-b border-outline-variant shadow-sm backdrop-blur-md bg-opacity-95 safe-top sticky">
  <div class="flex justify-between items-center h-14 sm:h-16 px-4 sm:px-6 max-w-[1400px] mx-auto w-full">
    <div class="flex items-center gap-4 sm:gap-8">
      <!-- Premium Brand Wordmark -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0" title="GenerateCustomQR — Home">
        <div class="w-8 h-8 flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-full h-full drop-shadow-sm group-hover:drop-shadow-md transition-all">
            <defs>
              <mask id="header-logo-mask">
                <rect width="100" height="100" fill="white"/>
                <rect x="21" y="21" width="14" height="14" rx="4" fill="black"/>
                <rect x="65" y="21" width="14" height="14" rx="4" fill="black"/>
                <rect x="21" y="65" width="14" height="14" rx="4" fill="black"/>
              </mask>
            </defs>
            <g mask="url(#header-logo-mask)" fill="#18181b">
              <rect x="8" y="8" width="40" height="40" rx="12"/>
              <rect x="52" y="8" width="40" height="40" rx="12"/>
              <rect x="8" y="52" width="40" height="40" rx="12"/>
            </g>
            <g>
              <rect x="54" y="54" width="18" height="18" rx="6" fill="#18181b"/>
              <rect x="54" y="76" width="12" height="12" rx="4" fill="#71717a"/>
              <rect x="70" y="76" width="12" height="12" rx="4" fill="#18181b"/>
            </g>
          </svg>
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-[14px] font-bold tracking-tight bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent whitespace-nowrap">GenerateCustomQR</span>
          <span class="text-[9px] font-medium text-on-surface-variant tracking-wider hidden sm:block whitespace-nowrap">40+ styles · 100% free</span>
        </div>
      </a>
      <div class="hidden md:flex items-center gap-5 lg:gap-6">
        <a
          href="/"
          class={`text-sm font-semibold transition-colors duration-200 ${currentPath === "/" ? "text-on-surface border-b-2 border-primary pb-1" : "text-on-surface-variant hover:text-on-surface"}`}
          {...(currentPath === "/" ? { "aria-current": "page" } : {})}
        >
          Generator
        </a>
        <a
          href="/how-to-use"
          class={`text-sm font-semibold transition-colors duration-200 flex items-center gap-1 ${currentPath === "/how-to-use" ? "text-on-surface border-b-2 border-primary pb-1" : "text-on-surface-variant hover:text-on-surface"}`}
          {...(currentPath === "/how-to-use" ? { "aria-current": "page" } : {})}
        >
          <span class="material-symbols-outlined text-[16px]">help_outline</span>
          Guide
        </a>
        <a
          href="/blog"
          class={`text-sm font-semibold transition-colors duration-200 flex items-center gap-1 ${currentPath.startsWith("/blog") ? "text-on-surface border-b-2 border-primary pb-1" : "text-on-surface-variant hover:text-on-surface"}`}
          {...(currentPath.startsWith("/blog") ? { "aria-current": "page" } : {})}
        >
          <span class="material-symbols-outlined text-[16px]">rss_feed</span>
          Blog
        </a>
        <a
          href="/qr-code-scanner"
          class={`text-sm font-bold transition-colors flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border ${currentPath === "/qr-code-scanner" ? "text-primary bg-primary/10 border-primary/30" : "text-on-surface hover:text-primary hover:bg-surface-container border-outline-variant/30"}`}
          {...(currentPath === "/qr-code-scanner" ? { "aria-current": "page" } : {})}
        >
          <span class="material-symbols-outlined text-[16px]">qr_code_scanner</span>
          Scan
        </a>
      </div>
    </div>
    
    <!-- Mobile Menu Button (requires client-side JS) -->
    <button
      id="mobile-menu-btn"
      class="md:hidden w-10 h-10 flex items-center justify-center rounded-xl hover:bg-surface-container transition-colors touch-press"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="material-symbols-outlined text-on-surface" id="menu-icon">menu</span>
    </button>
  </div>
  
  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-outline-variant bg-surface-container-lowest px-4 py-3 space-y-1 shadow-lg">
    <a
      href="/"
      class={`w-full flex items-center gap-3 p-2.5 rounded-xl min-h-[44px] font-bold ${currentPath === "/" ? "bg-primary/10 text-primary" : "text-on-surface-variant hover:bg-surface-container"}`}
    >
      <span class="material-symbols-outlined text-[20px]">qr_code_2</span>
      Generator
    </a>
    <a
      href="/how-to-use"
      class={`w-full flex items-center gap-3 p-2.5 rounded-xl min-h-[44px] font-bold ${currentPath === "/how-to-use" ? "bg-primary/10 text-primary" : "text-on-surface-variant hover:bg-surface-container"}`}
    >
      <span class="material-symbols-outlined text-[20px]">help_outline</span>
      Guide
    </a>
    <a
      href="/blog"
      class={`w-full flex items-center gap-3 p-2.5 rounded-xl min-h-[44px] font-bold ${currentPath.startsWith("/blog") ? "bg-primary/10 text-primary" : "text-on-surface-variant hover:bg-surface-container"}`}
    >
      <span class="material-symbols-outlined text-[20px]">rss_feed</span>
      Blog
    </a>
    <a
      href="/qr-code-scanner"
      class={`w-full flex items-center gap-3 p-2.5 rounded-xl min-h-[44px] font-bold ${currentPath === "/qr-code-scanner" ? "text-primary bg-primary/5 border border-primary/20" : "text-on-surface-variant hover:bg-surface-container"}`}
    >
      <span class="material-symbols-outlined text-[20px]">qr_code_scanner</span>
      Scan QR Code
    </a>
  </div>
</nav>

<script>
  // Simple mobile menu toggle script for static pages
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const icon = document.getElementById('menu-icon');
    
    if (btn && menu && icon) {
      btn.addEventListener('click', () => {
        const isHidden = menu.classList.toggle('hidden');
        icon.textContent = isHidden ? 'menu' : 'close';
        btn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });
    }
  });
</script>
