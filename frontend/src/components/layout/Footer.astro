---
const currentYear = new Date().getFullYear();
---
<!-- PREMIUM SEO FOOTER -->
<footer class="border-t border-outline-variant/60 bg-surface-container-lowest mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 lg:py-16 space-y-12">
    
    <!-- Footer Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Brand & Description -->
      <div class="space-y-4 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-full h-full drop-shadow-sm">
              <defs>
                <mask id="footer-logo-mask">
                  <rect width="100" height="100" fill="white"/>
                  <rect x="21" y="21" width="14" height="14" rx="4" fill="black"/>
                  <rect x="65" y="21" width="14" height="14" rx="4" fill="black"/>
                  <rect x="21" y="65" width="14" height="14" rx="4" fill="black"/>
                </mask>
              </defs>
              <g mask="url(#footer-logo-mask)" fill="#18181b">
                <rect x="8" y="8" width="40" height="40" rx="12"/>
                <rect x="52" y="8" width="40" height="40" rx="12"/>
                <rect x="8" y="52" width="40" height="40" rx="12"/>
              </g>
              <g>
                <rect x="54" y="54" width="18" height="18" rx="6" fill="#18181b"/>
                <rect x="54" y="76" width="12" height="12" rx="4" fill="#71717a"/>
                <rect x="70" y="76" width="12" height="12" rx="4" fill="#18181b"/>
              </g>
            </svg>
          </div>
          <span class="text-xl font-black tracking-tight text-on-surface">GenerateCustomQR</span>
        </a>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          Create stunning, fully customizable QR codes with logo embedding. 100% free, no signup required, no expiration limits.
        </p>
      </div>

      <!-- Product Links -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">QR Code Tools</h3>
        <ul class="space-y-3">
          <li><a href="/wifi-qr-code" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">WiFi QR Code</a></li>
          <li><a href="/vcard-qr-code" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">vCard / Contact QR</a></li>
          <li><a href="/qr-code-with-logo" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">QR Code with Logo</a></li>
          <li><a href="/event-qr-code" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">Event (iCal) QR Code</a></li>
          <li><a href="/email-qr-code" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">Email QR Code</a></li>
          <li><a href="/free-qr-code-generator" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">Free Generator</a></li>
          <li><a href="/qr-code-scanner" class="text-sm font-bold text-primary hover:text-primary-hover transition-colors flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">qr_code_scanner</span> QR Scanner</a></li>
        </ul>
      </div>

      <!-- Resources Links -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Resources</h3>
        <ul class="space-y-3">
          <li><a href="/how-to-use" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">How to Make a QR Code</a></li>
          <li><a href="/about" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">About Us</a></li>
          <li><a href="/contact" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">Contact Support</a></li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Legal</h3>
        <ul class="space-y-3">
          <li><a href="/privacy-policy" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">Terms & Conditions</a></li>
        </ul>
      </div>

    </div>

    <!-- Copyright & Standards Badge -->
    <div class="border-t border-outline-variant/40 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 pb-24 lg:pb-0">
      <div class="flex items-center gap-2">
        <p class="text-xs text-on-surface-variant font-medium">&copy; {currentYear} GenerateCustomQR. All rights reserved.</p>
      </div>

      <div class="flex items-center gap-2 text-[11px] font-bold text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200">
        <span class="material-symbols-outlined text-[14px]">verified</span>
        <span>ISO/IEC 18004 Standard Compliant</span>
      </div>
    </div>
  </div>
</footer>
