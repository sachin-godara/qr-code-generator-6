---
import { localeConfig, type Locale } from '../i18n/config';
import { getLocaleFromUrl, getAllLocaleUrls } from '../i18n/utils';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  keywords?: string;
  pageType?: 'generator' | 'scanner' | 'article' | 'website';
  googleSiteVerification?: string;
  breadcrumbs?: { name: string; url: string }[];
  howTo?: {
    name: string;
    description: string;
    steps: { name: string; text: string }[];
  };
  faqs?: { q: string; a: string }[];
}

const {
  locale,
  title,
  description,
  ogImage = '/og-image.png',
  canonicalUrl,
  keywords,
  pageType,
  googleSiteVerification,
  breadcrumbs,
  howTo,
  faqs,
} = Astro.props;

const currentLocale = (locale || getLocaleFromUrl(Astro.url)) as Locale;
const currentLocaleInfo = localeConfig[currentLocale] || localeConfig.en;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://generatecustomqr.com';
let canonicalPath = Astro.url.pathname;
if (!canonicalPath.endsWith('/')) {
  canonicalPath = `${canonicalPath}/`;
}
const resolvedCanonical = canonicalUrl ? (canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`) : `${siteUrl}${canonicalPath}`;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
const alternateUrls = getAllLocaleUrls(Astro.url.pathname, siteUrl);
const xDefaultUrl = alternateUrls.find((a) => a.locale === 'en')?.url || `${siteUrl}/`;

const isArticle = pageType === 'article' || (Astro.url.pathname.includes('/blog/') && !Astro.url.pathname.endsWith('/blog') && !Astro.url.pathname.endsWith('/blog/'));
const isScanner = pageType === 'scanner' || Astro.url.pathname.includes('/qr-code-scanner');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/es/' || Astro.url.pathname === '/pt/' || Astro.url.pathname === '/de/' || Astro.url.pathname === '/tr/' || Astro.url.pathname === '/es' || Astro.url.pathname === '/pt' || Astro.url.pathname === '/de' || Astro.url.pathname === '/tr';

const generatorFeatureLists: Record<Locale, string[]> = {
  en: [
    "40+ dot module styles including flower, star, heart, diamond, hexagon",
    "19 eye frame shapes and 23 eyeball styles",
    "51 decorative text and CTA frames",
    "Custom logo upload with automatic background removal",
    "12 content types: URL, Text, WiFi, vCard, Email, SMS, Event, Phone, Crypto, Location, PayPal, App Store",
    "Download as PNG (custom resolution), SVG (vector), or PDF (300 DPI)",
    "Batch generation up to 500 QR codes from CSV",
    "100% free with no signup required and no watermarks"
  ],
  es: [
    "Más de 40 estilos de puntos: flor, estrella, corazón, diamante y hexágono",
    "19 formas de marcos de ojos y 23 estilos de pupilas",
    "51 marcos decorativos con llamadas a la acción personalizadas",
    "Subida de logo personalizado con eliminación automática de fondo",
    "12 tipos de contenido: URL, Texto, WiFi, vCard, Correo, SMS, Evento, Teléfono, Cripto, Ubicación",
    "Descarga en PNG (resolución personalizada), SVG vectorial o PDF (300 DPI)",
    "Generación por lotes de hasta 500 códigos QR desde CSV",
    "100% gratis, sin marca de agua y sin necesidad de registro"
  ],
  de: [
    "Über 40 Punkt-Muster inklusive Blume, Stern, Herz, Diamant und Sechseck",
    "19 Augen-Rahmen und 23 Augen-Punkte",
    "51 dekorative Rahmen mit individuellem Call-to-Action-Text",
    "Eigenes Logo hochladen mit automatischer Hintergrundentfernung",
    "12 Inhaltstypen: URL, Text, WLAN, vCard, E-Mail, SMS, Termin, Telefon, Krypto, Standort",
    "Download als PNG, Vektor-SVG oder druckfertiges PDF (300 DPI)",
    "Stapelverarbeitung für bis zu 500 QR-Codes per CSV-Upload",
    "100% kostenlos ohne Wasserzeichen und ohne Anmeldung"
  ],
  pt: [
    "Mais de 40 estilos de pontos incluindo flor, estrela, coração, diamante e hexágono",
    "19 molduras de cantos e 23 estilos de centro",
    "51 molduras decorativas com texto de chamada para ação",
    "Upload de logo próprio com remoção automática de fundo",
    "12 tipos de conteúdo: URL, Texto, Wi-Fi, vCard, E-mail, SMS, Evento, Telefone, Cripto, Localização",
    "Download em PNG de alta resolução, vetor SVG e PDF (300 DPI)",
    "Geração em lote de até 500 códigos QR via planilha CSV",
    "100% gratuito sem marcas d'água e sem cadastro"
  ],
  tr: [
    "Çiçek, yıldız, kalp, elmas ve altıgen dahil 40'tan fazla nokta deseni",
    "19 göz çerçevesi ve 23 göz bebeği stili",
    "Özel eylem çağrısı metinlerine sahip 51 dekoratif çerçeve",
    "Otomatik arka plan kaldırma özellikli özel logo yükleme",
    "12 içerik türü: URL, Metin, Wi-Fi, vCard, E-posta, SMS, Etkinlik, Telefon, Kripto, Konum",
    "Yüksek çözünürlüklü PNG, vektörel SVG veya baskıya hazır PDF (300 DPI) indirme",
    "CSV yüklemesiyle aynı anda 500 adede kadar toplu QR kod oluşturma",
    "Filigransız, kayıtsız ve %100 tamamen ücretsiz"
  ]
};

const scannerFeatureLists: Record<Locale, string[]> = {
  en: [
    "Real-time camera QR code scanning with auto-focus",
    "Image and screenshot upload QR code reader",
    "Barcode scanning support: EAN-13, UPC-A, Code 128, ITF, QR Code",
    "Zero server uploads — 100% private in-browser decoding via WebAssembly",
    "Copy decoded content to clipboard with 1 tap",
    "100% free with no app downloads or registration required"
  ],
  es: [
    "Escaneo de códigos QR en tiempo real con cámara y enfoque automático",
    "Lector de códigos QR desde fotos, archivos e imágenes pegadas",
    "Soporte para códigos de barras: EAN-13, UPC-A, Code 128, ITF y QR",
    "Sin envíos a servidores: decodificación 100% privada mediante WebAssembly",
    "Copia el contenido decodificado al portapapeles con 1 toque",
    "100% gratis, sin instalar aplicaciones y sin registro"
  ],
  de: [
    "Echtzeit-Kamera-QR-Code-Scan mit Autofokus",
    "QR-Codes aus Bildern, Fotos und Screenshots einlesen",
    "Barcode-Unterstützung: EAN-13, UPC-A, Code 128, ITF, QR-Code",
    "Keine Server-Uploads — 100% private Entschlüsselung im Browser via WebAssembly",
    "Erkannten Inhalt mit 1 Klick in die Zwischenablage kopieren",
    "100% kostenlos ohne App-Download oder Registrierung"
  ],
  pt: [
    "Leitura de QR code em tempo real com câmera e foco automático",
    "Leitor de QR code a partir de fotos e capturas de tela",
    "Suporte a códigos de barras: EAN-13, UPC-A, Code 128, ITF e QR Code",
    "Sem envios para servidores — decodificação 100% privada via WebAssembly",
    "Copie o conteúdo lido para a área de transferência com 1 toque",
    "100% gratuito sem download de aplicativo e sem cadastro"
  ],
  tr: [
    "Otomatik odaklamalı gerçek zamanlı kamera ile QR kod tarama",
    "Fotoğraf ve ekran görüntüsü yükleyerek QR kod okuma",
    "Barkod desteği: EAN-13, UPC-A, Code 128, ITF, QR Kod",
    "Sunucuya yükleme yok — WebAssembly ile tarayıcıda %100 gizli ve yerel çözümleme",
    "Çözülen içeriği tek dokunuşla panoya kopyalama",
    "Uygulama indirmeden ve kayıt olmadan %100 ücretsiz"
  ]
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content="GenerateCustomQR" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={resolvedCanonical} />
{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

<!-- Internationalization (Hreflang) -->
{alternateUrls.map((item) => (
  <link rel="alternate" hreflang={item.hreflang} href={item.url} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? "article" : "website"} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="GenerateCustomQR" />
<meta property="og:locale" content={currentLocaleInfo.ogLocale} />
{alternateUrls
  .filter((a) => a.locale !== currentLocale)
  .map((a) => (
    <meta property="og:locale:alternate" content={localeConfig[a.locale].ogLocale} />
  ))}
<meta property="og:updated_time" content="2026-10-25T00:00:00Z" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={resolvedCanonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedOgImage} />

<!-- WebSite Structured Data with Sitelinks SearchAction -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://generatecustomqr.com/#website",
  "name": "GenerateCustomQR",
  "url": "https://generatecustomqr.com",
  "inLanguage": currentLocaleInfo.hreflang,
  "description": "Free custom QR code generator with logo, 40+ dot styles, and vector SVG/PDF export.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://generatecustomqr.com/blog?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
})} />

<!-- JSON-LD Structured Data — WebApplication (Generator or Scanner) -->
{!isArticle && (
  <script type="application/ld+json" set:html={JSON.stringify(isScanner ? {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${resolvedCanonical}#webapp`,
    "name": "GenerateCustomQR Scanner",
    "inLanguage": currentLocaleInfo.hreflang,
    "description": description,
    "url": resolvedCanonical,
    "datePublished": "2026-01-01T00:00:00Z",
    "dateModified": "2026-10-25T00:00:00Z",
    "applicationCategory": "UtilitiesApplication",
    "applicationSubCategory": "QR Code & Barcode Scanner",
    "operatingSystem": "All",
    "browserRequirements": "Requires Camera access and JavaScript. Works on iPhone, Android, Windows, Mac.",
    "permissions": "camera",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": scannerFeatureLists[currentLocale] || scannerFeatureLists.en,
    "screenshot": resolvedOgImage
  } : {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${resolvedCanonical}#webapp`,
    "name": "GenerateCustomQR",
    "inLanguage": currentLocaleInfo.hreflang,
    "description": description,
    "url": resolvedCanonical,
    "datePublished": "2026-01-01T00:00:00Z",
    "dateModified": "2026-10-25T00:00:00Z",
    "applicationCategory": "DesignApplication",
    "applicationSubCategory": "QR Code Generator",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript. Works in Chrome, Firefox, Safari, Edge.",
    "permissions": "none",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": generatorFeatureLists[currentLocale] || generatorFeatureLists.en,
    "screenshot": resolvedOgImage
  })} />
)}

<!-- Organization Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://generatecustomqr.com/#organization",
  "name": "GenerateCustomQR",
  "url": "https://generatecustomqr.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://generatecustomqr.com/favicon-96x96.png",
    "width": 96,
    "height": 96
  },
  "description": "Free custom QR code generator with logo embedding, 40+ dot styles, and vector SVG/PDF export.",
  "foundingDate": "2025",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "url": "https://generatecustomqr.com/contact"
  }
})} />

<!-- BreadcrumbList Structured Data (if breadcrumbs provided) -->
{breadcrumbs && breadcrumbs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name,
      "item": crumb.url.startsWith('http')
        ? crumb.url
        : `${siteUrl}${crumb.url.startsWith('/') ? '' : '/'}${crumb.url}`
    }))
  })} />
)}

<!-- HowTo Structured Data (if howTo provided) -->
{howTo && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": howTo.name,
    "description": howTo.description,
    "totalTime": "PT2M",
    "tool": {
      "@type": "HowToTool",
      "name": "GenerateCustomQR (web browser)"
    },
    "step": howTo.steps.map((step, index) => ({
      "@type": "HowToStep",
      "position": index + 1,
      "name": step.name,
      "text": step.text
    }))
  })} />
)}

<!-- FAQPage Structured Data (if faqs provided) -->
{faqs && faqs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  })} />
)}

