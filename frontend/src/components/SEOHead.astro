---
import { localeConfig, type Locale } from '../i18n/config';
import { getLocaleFromUrl, getAllLocaleUrls } from '../i18n/utils';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  keywords?: string;
  pageType?: 'generator' | 'scanner' | 'article' | 'website';
  googleSiteVerification?: string;
  breadcrumbs?: { name: string; url: string }[];
  howTo?: {
    name: string;
    description: string;
    steps: { name: string; text: string }[];
  };
  faqs?: { q: string; a: string }[];
}

const {
  locale,
  title,
  description,
  ogImage = '/og-image.png',
  canonicalUrl,
  keywords,
  pageType,
  googleSiteVerification,
  breadcrumbs,
  howTo,
  faqs,
} = Astro.props;

const currentLocale = (locale || getLocaleFromUrl(Astro.url)) as Locale;
const currentLocaleInfo = localeConfig[currentLocale] || localeConfig.en;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://generatecustomqr.com';
let canonicalPath = Astro.url.pathname;
if (!canonicalPath.endsWith('/')) {
  canonicalPath = `${canonicalPath}/`;
}
const resolvedCanonical = canonicalUrl ? (canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`) : `${siteUrl}${canonicalPath}`;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
const alternateUrls = getAllLocaleUrls(Astro.url.pathname, siteUrl);
const xDefaultUrl = alternateUrls.find((a) => a.locale === 'en')?.url || `${siteUrl}/`;

const isArticle = pageType === 'article' || (Astro.url.pathname.includes('/blog/') && !Astro.url.pathname.endsWith('/blog') && !Astro.url.pathname.endsWith('/blog/'));
const isScanner = pageType === 'scanner' || Astro.url.pathname.includes('/qr-code-scanner');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/es/' || Astro.url.pathname === '/pt/' || Astro.url.pathname === '/de/' || Astro.url.pathname === '/tr/' || Astro.url.pathname === '/es' || Astro.url.pathname === '/pt' || Astro.url.pathname === '/de' || Astro.url.pathname === '/tr';
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content="GenerateCustomQR" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="last-modified" content={new Date().toISOString()} />
<meta name="revised" content={new Date().toISOString()} />
<link rel="canonical" href={resolvedCanonical} />
{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

<!-- Internationalization (Hreflang) -->
{alternateUrls.map((item) => (
  <link rel="alternate" hreflang={item.hreflang} href={item.url} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? "article" : "website"} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="GenerateCustomQR" />
<meta property="og:locale" content={currentLocaleInfo.ogLocale} />
{alternateUrls
  .filter((a) => a.locale !== currentLocale)
  .map((a) => (
    <meta property="og:locale:alternate" content={localeConfig[a.locale].ogLocale} />
  ))}
<meta property="og:updated_time" content={new Date().toISOString()} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={resolvedCanonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedOgImage} />

<!-- WebSite Structured Data with Sitelinks SearchAction -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GenerateCustomQR",
  "url": "https://generatecustomqr.com",
  "inLanguage": currentLocaleInfo.hreflang,
  "description": "Free custom QR code generator with logo, 40+ dot styles, and vector SVG/PDF export.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://generatecustomqr.com/blog?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
})} />

<!-- JSON-LD Structured Data — WebApplication (Generator or Scanner) -->
{!isArticle && (
  <script type="application/ld+json" set:html={JSON.stringify(isScanner ? {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "GenerateCustomQR Scanner",
    "inLanguage": currentLocaleInfo.hreflang,
    "description": description,
    "url": resolvedCanonical,
    "datePublished": "2026-01-01T00:00:00Z",
    "dateModified": new Date().toISOString(),
    "applicationCategory": "UtilitiesApplication",
    "applicationSubCategory": "QR Code & Barcode Scanner",
    "operatingSystem": "All",
    "browserRequirements": "Requires Camera access and JavaScript. Works on iPhone, Android, Windows, Mac.",
    "permissions": "camera",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Real-time camera QR code scanning with auto-focus",
      "Image and screenshot upload QR code reader",
      "Barcode scanning support: EAN-13, UPC-A, Code 128, ITF, QR Code",
      "Zero server uploads — 100% private in-browser decoding",
      "Copy decoded content to clipboard with 1 tap",
      "Auto-detect URLs, Wi-Fi networks, vCards, SMS, and geolocation coordinates",
      "Torch/Flashlight toggle and front/rear camera switcher",
      "100% free with no app downloads or registration required"
    ],
    "screenshot": resolvedOgImage
  } : {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "GenerateCustomQR",
    "inLanguage": currentLocaleInfo.hreflang,
    "description": description,
    "url": resolvedCanonical,
    "datePublished": "2026-01-01T00:00:00Z",
    "dateModified": new Date().toISOString(),
    "applicationCategory": "DesignApplication",
    "applicationSubCategory": "QR Code Generator",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript. Works in Chrome, Firefox, Safari, Edge.",
    "permissions": "none",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "40+ dot module styles including flower, star, heart, diamond, hexagon",
      "19 eye frame shapes and 23 eyeball styles",
      "51 decorative text and CTA frames",
      "22 layout frame designs",
      "121 preset QR code templates",
      "46 preset logo icons with brand colors",
      "Custom logo upload with background removal",
      "Logo dot clearance control",
      "4 gradient types: vertical, horizontal, radial, diagonal",
      "Shadow effects: soft, elevated, neon",
      "12 content types: URL, Text, WiFi, vCard, Email, SMS, Event, Phone, Crypto, Location, PayPal, App Store",
      "Download as PNG (custom resolution), SVG (vector), or PDF (300 DPI)",
      "Transparent background export",
      "Batch generation up to 500 QR codes from CSV",
      "Per-eye independent styling for all 3 corners",
      "Background image with blend modes",
      "Copy to clipboard",
      "100% free, no signup required, no watermarks"
    ],
    "screenshot": resolvedOgImage
  })} />
)}

<!-- Organization Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GenerateCustomQR",
  "url": "https://generatecustomqr.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://generatecustomqr.com/favicon-96x96.png",
    "width": 96,
    "height": 96
  },
  "description": "Free custom QR code generator with logo embedding, 40+ dot styles, and vector SVG/PDF export.",
  "foundingDate": "2025",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "url": "https://generatecustomqr.com/contact"
  }
})} />

<!-- BreadcrumbList Structured Data (if breadcrumbs provided) -->
{breadcrumbs && breadcrumbs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name,
      "item": crumb.url.startsWith('http')
        ? crumb.url
        : `${siteUrl}${crumb.url.startsWith('/') ? '' : '/'}${crumb.url}`
    }))
  })} />
)}

<!-- HowTo Structured Data (if howTo provided) -->
{howTo && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": howTo.name,
    "description": howTo.description,
    "totalTime": "PT2M",
    "tool": {
      "@type": "HowToTool",
      "name": "GenerateCustomQR (web browser)"
    },
    "step": howTo.steps.map((step, index) => ({
      "@type": "HowToStep",
      "position": index + 1,
      "name": step.name,
      "text": step.text
    }))
  })} />
)}

<!-- FAQPage Structured Data (if faqs provided) -->
{faqs && faqs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  })} />
)}

