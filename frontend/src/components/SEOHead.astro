---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  keywords?: string;
  breadcrumbs?: { name: string; url: string }[];
  howTo?: {
    name: string;
    description: string;
    steps: { name: string; text: string }[];
  };
  faqs?: { q: string; a: string }[];
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  canonicalUrl,
  keywords,
  breadcrumbs,
  howTo,
  faqs,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const resolvedCanonical = canonicalUrl || Astro.url.href;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content="GenerateCustomQR" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={resolvedCanonical} />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Courier+Prime:wght@400;700&family=Dancing+Script:wght@400;700&family=Fira+Code:wght@400;700&family=Lora:wght@400;700&family=Montserrat:wght@400;700&family=Oswald:wght@400;700&family=Outfit:wght@400;700&family=Playfair+Display:wght@400;700&family=Poppins:wght@400;700&family=Roboto:wght@400;700&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="GenerateCustomQR" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={resolvedCanonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedOgImage} />

<!-- JSON-LD Structured Data — WebApplication -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GenerateCustomQR",
  "description": description,
  "url": resolvedCanonical,
  "applicationCategory": "DesignApplication",
  "applicationSubCategory": "QR Code Generator",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript. Works in Chrome, Firefox, Safari, Edge.",
  "permissions": "none",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "40+ dot module styles including flower, star, heart, diamond, hexagon",
    "19 eye frame shapes and 23 eyeball styles",
    "51 decorative text and CTA frames",
    "22 layout frame designs",
    "121 preset QR code templates",
    "46 preset logo icons with brand colors",
    "Custom logo upload with background removal",
    "Logo dot clearance control",
    "4 gradient types: vertical, horizontal, radial, diagonal",
    "Shadow effects: soft, elevated, neon",
    "12 content types: URL, Text, WiFi, vCard, Email, SMS, Event, Phone, Crypto, Location, PayPal, App Store",
    "Download as PNG (custom resolution), SVG (vector), or PDF (300 DPI)",
    "Transparent background export",
    "Batch generation up to 500 QR codes from CSV",
    "Per-eye independent styling for all 3 corners",
    "Background image with blend modes",
    "Copy to clipboard",
    "100% free, no signup required, no watermarks"
  ],
  "screenshot": resolvedOgImage
})} />

<!-- FAQ Structured Data for Rich Snippets -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I create a custom QR code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Enter your URL, text, or contact information, choose from 39 dot styles and 28 eye patterns, customize colors and gradients, add a logo from 46 Presets or upload your own, pick a decorative frame, and download your QR code in PNG, SVG, or PDF format — completely free."
      }
    },
    {
      "@type": "Question",
      "name": "Is the QR code generator free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, GenerateCustomQR is 100% free with all features unlocked — no signup, no watermarks, no usage limits. You get full access to 40+ dot styles, 51 text frames, 48 templates, logo embedding, batch generation, and PNG/SVG/PDF export at no cost."
      }
    },
    {
      "@type": "Question",
      "name": "What types of QR codes can I create?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can create QR codes for 12 different content types: URLs, plain text, WiFi credentials, vCards (contact cards), emails, SMS messages, calendar events, phone numbers, cryptocurrency addresses, Google Maps locations, PayPal payment links, and App Store links."
      }
    },
    {
      "@type": "Question",
      "name": "Can I add a logo to my QR code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can upload your own logo or choose from 46 preset brand icons including Instagram, WhatsApp, YouTube, Facebook, and more. Features include automatic background removal, adjustable dot clearance around the logo, multiple card shapes, and brand or custom color modes."
      }
    },
    {
      "@type": "Question",
      "name": "What download formats are available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can download QR codes in three formats: PNG (up to 4096×4096 pixels for print), SVG (infinitely scalable vector for designers), and PDF (300 DPI print-ready). All formats are free with no watermarks. You can also copy the QR code directly to your clipboard."
      }
    },
    {
      "@type": "Question",
      "name": "Can I generate QR codes in bulk?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, GenerateCustomQR supports batch generation of up to 500 QR codes at once. Upload a CSV file with your data, map the columns, choose your design settings, and download all QR codes as a ZIP file in PNG, SVG, or PDF format."
      }
    }
  ]
})} />

<!-- BreadcrumbList Structured Data (if breadcrumbs provided) -->
{breadcrumbs && breadcrumbs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name,
      "item": crumb.url
    }))
  })} />
)}

<!-- HowTo Structured Data (if howTo provided) -->
{howTo && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": howTo.name,
    "description": howTo.description,
    "totalTime": "PT2M",
    "tool": {
      "@type": "HowToTool",
      "name": "GenerateCustomQR (web browser)"
    },
    "step": howTo.steps.map((step, index) => ({
      "@type": "HowToStep",
      "position": index + 1,
      "name": step.name,
      "text": step.text
    }))
  })} />
)}

<!-- FAQPage Structured Data (if faqs provided) -->
{faqs && faqs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  })} />
)}
