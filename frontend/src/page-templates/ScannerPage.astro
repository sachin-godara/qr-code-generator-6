---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import QRScannerApp from '../react/scanner/QRScannerApp';
import Footer from '../components/layout/Footer.astro';
import { type Locale } from '../i18n/config';
import { getPageSeo, getLocalizedUrl, t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = getPageSeo(locale, 'scanner');

const breadcrumbs = [
  { name: t(locale, 'nav.generator'), url: getLocalizedUrl(locale, '/') },
  { name: t(locale, 'nav.scan'), url: getLocalizedUrl(locale, '/qr-code-scanner') }
];

const faqs = seo.faqs || [];

const scannerLocMap: Record<Locale, {
  redirect: string;
  chat: string;
  wifi: string;
  vcard: string;
  gps: string;
  cal: string;
  barcode: string;
  payload: string;
  waTitle: string;
  waDesc: string;
  barcodeTitle: string;
  barcodeDesc: string;
  exploreTools: string;
}> = {
  en: {
    redirect: "Instant Redirect",
    chat: "Direct Chat",
    wifi: "1-Tap Connect",
    vcard: "Phonebook .vcf",
    gps: "Live GPS",
    cal: ".ics Calendar",
    barcode: "Multi-Format",
    payload: "Raw Payload",
    waTitle: "WhatsApp Web & Direct Chat",
    waDesc: "Scan wa.me links to initiate chats with pre-filled messages instantly.",
    barcodeTitle: "1D/2D Barcodes & Aztec",
    barcodeDesc: "Read DataMatrix, UPC, EAN, Aztec, and Code-128 alongside QR codes.",
    exploreTools: "Explore Free QR Code Generator Tools"
  },
  es: {
    redirect: "Redirección Instantánea",
    chat: "Chat Directo",
    wifi: "Conexión en 1 Toque",
    vcard: "Agenda .vcf",
    gps: "GPS en Directo",
    cal: "Calendario .ics",
    barcode: "Multiformato",
    payload: "Datos Directos",
    waTitle: "WhatsApp Web y Chat Directo",
    waDesc: "Escanea enlaces wa.me para abrir conversaciones con texto prefijado al instante.",
    barcodeTitle: "Códigos de Barras 1D/2D y Aztec",
    barcodeDesc: "Lee DataMatrix, UPC, EAN, Aztec y Code-128 además de códigos QR estándar.",
    exploreTools: "Explora Generadores de Códigos QR Gratuitos"
  },
  pt: {
    redirect: "Redirecionamento Rápido",
    chat: "Chat Direto",
    wifi: "Conexão em 1 Toque",
    vcard: "Agenda .vcf",
    gps: "GPS em Tempo Real",
    cal: "Calendário .ics",
    barcode: "Multiformato",
    payload: "Dados Diretos",
    waTitle: "WhatsApp Web e Conversa Direta",
    waDesc: "Escaneie links wa.me para iniciar conversas com mensagens prontas instantaneamente.",
    barcodeTitle: "Códigos de Barras 1D/2D e Aztec",
    barcodeDesc: "Decodifique DataMatrix, UPC, EAN, Aztec e Code-128 além de QR codes.",
    exploreTools: "Conheça Outras Ferramentas de QR Code Gratuitas"
  },
  de: {
    redirect: "Sofort-Weiterleitung",
    chat: "Direkt-Chat",
    wifi: "1-Klick-Verbindung",
    vcard: "Adressbuch .vcf",
    gps: "Live-Standort",
    cal: ".ics-Kalender",
    barcode: "Multi-Format",
    payload: "Rohdaten",
    waTitle: "WhatsApp Web & Direkt-Chat",
    waDesc: "Scannen Sie wa.me-Links für sofortige Chat-Starts mit vorausgefülltem Text.",
    barcodeTitle: "1D/2D Barcodes & Aztec",
    barcodeDesc: "Liest neben QR-Codes auch DataMatrix, UPC, EAN, Aztec und Code-128.",
    exploreTools: "Weitere kostenlose QR-Code Generatoren entdecken"
  },
  tr: {
    redirect: "Anında Yönlendirme",
    chat: "Doğrudan Sohbet",
    wifi: "Tek Dokunuşla Bağlan",
    vcard: "Rehber .vcf",
    gps: "Canlı GPS",
    cal: ".ics Takvim",
    barcode: "Çoklu Format",
    payload: "Ham Veri",
    waTitle: "WhatsApp Web & Doğrudan Sohbet",
    waDesc: "Hazır mesajlı sohbetleri anında başlatmak için wa.me bağlantılarını tarayın.",
    barcodeTitle: "1D/2D Barkodlar & Aztec",
    barcodeDesc: "QR kodların yanı sıra DataMatrix, UPC, EAN, Aztec ve Code-128 okuyun.",
    exploreTools: "Ücretsiz QR Kod Oluşturucu Araçlarını Keşfedin"
  }
};

const locStrings = scannerLocMap[locale] || scannerLocMap.en;

const supportedTypes = [
  { icon: "link", title: t(locale, 'scanner.formats.urlsTitle'), desc: t(locale, 'scanner.formats.urlsDesc'), color: "text-blue-600 bg-blue-50 border-blue-200/60", badge: locStrings.redirect },
  { icon: "chat", title: locStrings.waTitle, desc: locStrings.waDesc, color: "text-emerald-600 bg-emerald-50 border-emerald-200/60", badge: locStrings.chat },
  { icon: "wifi", title: t(locale, 'scanner.formats.wifiTitle'), desc: t(locale, 'scanner.formats.wifiDesc'), color: "text-amber-600 bg-amber-50 border-amber-200/60", badge: locStrings.wifi },
  { icon: "contact_page", title: t(locale, 'scanner.formats.vcardTitle'), desc: t(locale, 'scanner.formats.vcardDesc'), color: "text-indigo-600 bg-indigo-50 border-indigo-200/60", badge: locStrings.vcard },
  { icon: "location_on", title: t(locale, 'scanner.formats.mapsTitle'), desc: t(locale, 'scanner.formats.mapsDesc'), color: "text-rose-600 bg-rose-50 border-rose-200/60", badge: locStrings.gps },
  { icon: "event", title: t(locale, 'scanner.formats.eventsTitle'), desc: t(locale, 'scanner.formats.eventsDesc'), color: "text-purple-600 bg-purple-50 border-purple-200/60", badge: locStrings.cal },
  { icon: "barcode_scanner", title: locStrings.barcodeTitle, desc: locStrings.barcodeDesc, color: "text-cyan-600 bg-cyan-50 border-cyan-200/60", badge: locStrings.barcode },
  { icon: "description", title: t(locale, 'scanner.formats.textTitle'), desc: t(locale, 'scanner.formats.textDesc'), color: "text-zinc-600 bg-zinc-100 border-zinc-200/60", badge: locStrings.payload }
];
---
<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  pageType="scanner"
  ogImage="/og-scanner.png"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- Import global styles -->
  <style is:global>
    @import '../styles/global.css';
  </style>

  <Header locale={locale} />

  <main class="pt-6 sm:pt-10 pb-20 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">

      <!-- Sleek Modern Hero Header -->
      <div class="text-center space-y-2 max-w-xl mx-auto mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-on-surface tracking-tight">
          {t(locale, 'scanner.pageTitle')}
        </h1>
        <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed">
          {t(locale, 'scanner.pageSubtitle')}
        </p>
      </div>

      <!-- React QR Scanner Interactive Island -->
      <QRScannerApp client:load locale={locale} />

      <!-- Educational Device Guides (iOS & Android) -->
      <section class="mt-16 sm:mt-24 pt-10 sm:pt-14 border-t border-zinc-200/60 space-y-8">
        <div class="text-center space-y-2 max-w-xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-black text-on-surface tracking-tight">{t(locale, 'scanner.guideTitle')}</h2>
          <p class="text-sm sm:text-base text-on-surface-variant">{t(locale, 'scanner.guideSubtitle')}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
          {/* iOS Card */}
          <div class="bg-surface-container-lowest rounded-3xl p-5 sm:p-8 border border-outline-variant/60 shadow-xs hover:shadow-lg hover:border-blue-200/70 hover:-translate-y-1 transition-all duration-300">
            <div class="flex items-center justify-between mb-4 sm:mb-5">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shadow-xs">
                <span class="material-symbols-outlined text-2xl">phone_iphone</span>
              </div>
              <span class="px-2.5 sm:px-3 py-1 rounded-full bg-blue-50 border border-blue-200/60 text-blue-700 text-[10px] sm:text-[11px] font-bold">
                Built-in Camera
              </span>
            </div>
            <h3 class="text-base sm:text-xl font-bold text-on-surface mb-2">{t(locale, 'scanner.iosTitle')}</h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-4 sm:mb-5">
              {t(locale, 'scanner.iosDesc')}
            </p>
            <ul class="space-y-2.5 sm:space-y-3 text-xs text-on-surface-variant">
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center shrink-0 text-[10px] shadow-xs">1</span>
                <span>{t(locale, 'scanner.iosStep1')}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center shrink-0 text-[10px] shadow-xs">2</span>
                <span>{t(locale, 'scanner.iosStep2')}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center shrink-0 text-[10px] shadow-xs">3</span>
                <span>{t(locale, 'scanner.iosStep3')}</span>
              </li>
            </ul>
          </div>

          {/* Android Card */}
          <div class="bg-surface-container-lowest rounded-3xl p-5 sm:p-8 border border-outline-variant/60 shadow-xs hover:shadow-lg hover:border-emerald-200/70 hover:-translate-y-1 transition-all duration-300">
            <div class="flex items-center justify-between mb-4 sm:mb-5">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shadow-xs">
                <span class="material-symbols-outlined text-2xl">android</span>
              </div>
              <span class="px-2.5 sm:px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-700 text-[10px] sm:text-[11px] font-bold">
                Camera / Google Lens
              </span>
            </div>
            <h3 class="text-base sm:text-xl font-bold text-on-surface mb-2">{t(locale, 'scanner.androidTitle')}</h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-4 sm:mb-5">
              {t(locale, 'scanner.androidDesc')}
            </p>
            <ul class="space-y-3 text-xs text-on-surface-variant">
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center shrink-0 text-[10px] shadow-xs">1</span>
                <span>{t(locale, 'scanner.androidStep1')}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center shrink-0 text-[10px] shadow-xs">2</span>
                <span>{t(locale, 'scanner.androidStep2')}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center shrink-0 text-[10px] shadow-xs">3</span>
                <span>{t(locale, 'scanner.androidStep3')}</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Supported Formats Section -->
      <section class="mt-16 sm:mt-24 pt-10 sm:pt-14 border-t border-zinc-200/60 space-y-8">
        <div class="text-center space-y-2 max-w-xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-black text-on-surface tracking-tight">{t(locale, 'scanner.supportedTitle')}</h2>
          <p class="text-sm sm:text-base text-on-surface-variant">{t(locale, 'scanner.supportedSub')}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4">
          {supportedTypes.map((item) => (
            <div class="flex flex-col justify-between p-4.5 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 hover:border-zinc-300 hover:shadow-md hover:-translate-y-0.5 transition-all group">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <div class={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border ${item.color} shadow-2xs group-hover:scale-105 transition-transform`}>
                    <span class="material-symbols-outlined text-xl">{item.icon}</span>
                  </div>
                  {item.badge && (
                    <span class="px-2 py-0.5 rounded-md bg-zinc-100 border border-zinc-200/70 text-[10px] font-bold text-zinc-600">
                      {item.badge}
                    </span>
                  )}
                </div>
                <h3 class="text-sm font-bold text-on-surface mb-1">{item.title}</h3>
                <p class="text-xs text-on-surface-variant leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ Section -->
      {faqs.length > 0 && (
        <section class="mt-16 sm:mt-24 pt-10 sm:pt-14 border-t border-zinc-200/60 space-y-8">
          <div class="text-center space-y-2">
            <h2 class="text-2xl sm:text-3xl font-black text-on-surface tracking-tight">{t(locale, 'landing.faqHeading')}</h2>
            <p class="text-sm text-on-surface-variant">{t(locale, 'scanner.subtitle')}</p>
          </div>

          <div class="space-y-3">
            {faqs.map((faq: any) => (
              <details class="group bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-5 open:bg-surface-container-low transition-all">
                <summary class="flex justify-between items-center font-bold text-on-surface cursor-pointer list-none gap-4 text-sm sm:text-base">
                  <span>{faq.q}</span>
                  <span class="material-symbols-outlined text-on-surface-variant group-open:rotate-180 transition-transform">
                    expand_more
                  </span>
                </summary>
                <p class="text-sm text-on-surface-variant mt-3 leading-relaxed border-t border-outline-variant/30 pt-3">
                  {faq.a}
                </p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Explore Other Tools Ribbon -->
      <section class="mt-16 sm:mt-24 pt-10 sm:pt-14 border-t border-zinc-200/60 space-y-6">
        <h2 class="text-2xl sm:text-3xl font-black text-center text-on-surface tracking-tight">{locStrings.exploreTools}</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {[
            { icon: "link", title: t(locale, 'footer.urlQR'), desc: t(locale, 'landing.formats.items.urlDesc'), url: getLocalizedUrl(locale, '/url-qr-code-generator') },
            { icon: "wifi", title: t(locale, 'footer.wifiQR'), desc: t(locale, 'landing.formats.items.wifiDesc'), url: getLocalizedUrl(locale, '/wifi-qr-code') },
            { icon: "contact_page", title: t(locale, 'footer.vcardQR'), desc: t(locale, 'landing.formats.items.vcardDesc'), url: getLocalizedUrl(locale, '/vcard-qr-code') },
            { icon: "image", title: t(locale, 'footer.logoQR'), desc: t(locale, 'landing.features.card2Title'), url: getLocalizedUrl(locale, '/qr-code-with-logo') },
            { icon: "event", title: t(locale, 'footer.eventQR'), desc: t(locale, 'landing.formats.items.eventDesc'), url: getLocalizedUrl(locale, '/event-qr-code') },
            { icon: "mail", title: t(locale, 'footer.emailQR'), desc: t(locale, 'landing.formats.items.emailDesc'), url: getLocalizedUrl(locale, '/email-qr-code') }
          ].map((tool) => (
            <a
              href={tool.url}
              class="p-3.5 rounded-xl bg-surface-container-lowest border border-outline-variant/60 hover:border-primary/40 hover:-translate-y-1 hover:shadow-xs transition-all text-center group flex flex-col items-center justify-between"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 group-hover:bg-primary group-hover:text-white flex items-center justify-center transition-colors mb-2">
                <span class="material-symbols-outlined text-lg">{tool.icon}</span>
              </div>
              <span class="font-bold text-xs text-on-surface group-hover:text-primary transition-colors block">{tool.title}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Bottom CTA to Generator -->
      <div class="mt-16 sm:mt-24 bg-gradient-to-r from-neutral-900 via-zinc-900 to-neutral-950 rounded-3xl p-8 sm:p-12 text-center text-white shadow-2xl relative overflow-hidden isolate border border-white/10 space-y-4">
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-primary/30 rounded-full blur-3xl pointer-events-none"></div>
        
        <h2 class="text-2xl sm:text-3xl font-black text-white">{t(locale, 'scanner.ctaTitle')}</h2>
        <p class="text-sm sm:text-base text-zinc-300 max-w-xl mx-auto leading-relaxed">
          {t(locale, 'scanner.ctaDesc')}
        </p>
        <div class="pt-2">
          <a
            href={getLocalizedUrl(locale, '/')}
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-white text-neutral-950 font-bold text-sm shadow-xl hover:bg-zinc-100 hover:scale-105 transition-all cursor-pointer"
          >
            <span class="material-symbols-outlined text-lg">qr_code_2</span>
            <span>{t(locale, 'scanner.ctaButton')}</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
