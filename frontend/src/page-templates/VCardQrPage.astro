    guideDesc: "Fiziksel kartvizit baskısı için asgari boyutlar, güvenli kenar boşlukları ve tasarım ipuçları.",
    guideBtn: "Kartvizit Rehberini Oku"
  }
};

const pageMeta = metaMap[locale] || metaMap.en;

const breadcrumbs = [
  { name: t(locale, 'nav.generator'), url: getLocalizedUrl(locale, '/') },
  { name: t(locale, 'footer.vcardQR'), url: getLocalizedUrl(locale, '/vcard-qr-code') }
];

const relatedTools = [
  { icon: "link", title: t(locale, 'footer.urlQR'), desc: t(locale, 'landing.formats.items.urlDesc'), url: getLocalizedUrl(locale, '/url-qr-code-generator') },
  { icon: "wifi", title: t(locale, 'footer.wifiQR'), desc: t(locale, 'landing.formats.items.wifiDesc'), url: getLocalizedUrl(locale, '/wifi-qr-code') },
  { icon: "image", title: t(locale, 'footer.logoQR'), desc: t(locale, 'landing.features.card2Title'), url: getLocalizedUrl(locale, '/qr-code-with-logo') },
  { icon: "event", title: t(locale, 'footer.eventQR'), desc: t(locale, 'landing.formats.items.eventDesc'), url: getLocalizedUrl(locale, '/event-qr-code') },
  { icon: "mail", title: t(locale, 'footer.emailQR'), desc: t(locale, 'landing.formats.items.emailDesc'), url: getLocalizedUrl(locale, '/email-qr-code') },
  { icon: "crop_free", title: t(locale, 'footer.scanner'), desc: t(locale, 'scanner.formats.urlsDesc'), url: getLocalizedUrl(locale, '/qr-code-scanner') }
];

const howTo = {
  name: pageMeta.title,
  description: pageMeta.desc,
  steps: pageMeta.steps.map((s, idx) => ({ name: `${idx + 1}. ${s.title}`, text: s.desc }))
};

const faqs = pageMeta.faqs;
---
<BaseLayout
  locale={locale}
  title={pageMeta.title}
  description={pageMeta.desc}
  keywords={pageMeta.keywords}
  breadcrumbs={breadcrumbs}
  howTo={howTo}
  faqs={faqs}
>
  <style is:global>
    @import '../styles/global.css';
  </style>

  <main id="generator">
    <QRGeneratorApp client:load locale={locale} />
  </main>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-16 text-on-surface" id="about">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-primary bg-primary/10 px-3.5 py-1.5 rounded-full">{pageMeta.badge}</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-on-surface tracking-tight">{pageMeta.title}</h1>
      <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed max-w-2xl mx-auto">
        {pageMeta.desc}
      </p>
    </div>

    <!-- 1. Technical Capabilities Grid -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.specsTitle}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {pageMeta.specs.map((s) => (
          <div class="p-5 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 hover:border-primary/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300 shadow-xs space-y-2">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
              <span class="material-symbols-outlined text-xl">{s.icon}</span>
            </div>
            <h3 class="font-bold text-sm text-on-surface">{s.title}</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. 4-Step Process Guide -->
    <section class="border-t border-zinc-200/60 pt-12 space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.stepsTitle}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {pageMeta.steps.map((step, idx) => (
          <div class="text-center p-5 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 hover:border-primary/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300 shadow-xs">
            <div class="w-10 h-10 mx-auto mb-3 rounded-full bg-primary/10 text-primary font-black text-sm flex items-center justify-center">
              {idx + 1}
            </div>
            <h3 class="font-bold text-sm text-on-surface mb-1">{step.title}</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Why Use vCard Grid -->
    <section class="border-t border-zinc-200/60 pt-12 space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.benefitsTitle}</h2>
      <div class="grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
        {pageMeta.benefits.map((b) => (
          <div class="flex items-start gap-3.5 p-4.5 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 hover:border-primary/30 hover:-translate-y-0.5 hover:shadow-xs transition-all duration-200">
            <span class="material-symbols-outlined text-primary text-2xl shrink-0 mt-0.5">{b.icon}</span>
            <div>
              <h3 class="font-bold text-sm text-on-surface">{b.title}</h3>
              <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Best Practices Guide -->
    <section class="border-t border-zinc-200/60 pt-12 space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.tipsTitle}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {pageMeta.tips.map((tip) => (
          <div class="p-4.5 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 space-y-2">
            <span class="material-symbols-outlined text-emerald-600 text-2xl">{tip.icon}</span>
            <h3 class="font-bold text-sm text-on-surface">{tip.title}</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">{tip.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Companion Educational Guide (Pillar-to-Cluster Link) -->
    <section class="border-t border-zinc-200/60 pt-12">
      <div class="p-6 sm:p-8 rounded-3xl bg-linear-to-br from-zinc-50 via-zinc-100 to-zinc-50 border border-outline-variant/60 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xs">
        <div class="space-y-2 text-left">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold">
            <span class="material-symbols-outlined text-[15px]">menu_book</span>
            <span>{pageMeta.guideBadge}</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-on-surface tracking-tight">{pageMeta.guideTitle}</h3>
          <p class="text-xs sm:text-sm text-on-surface-variant max-w-xl leading-relaxed">{pageMeta.guideDesc}</p>
        </div>
        <a
          href={getLocalizedUrl(locale, '/blog/how-to-add-qr-code-to-business-card')}
          class="shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-full bg-zinc-900 text-white font-bold text-xs sm:text-sm hover:bg-zinc-800 hover:scale-105 active:scale-95 transition-all shadow-md group"
        >
          <span>{pageMeta.guideBtn}</span>
          <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
        </a>
      </div>
    </section>

    <!-- 5. Explore Other Tools Ribbon -->
    <section class="border-t border-zinc-200/60 pt-12 space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.otherToolsTitle}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {relatedTools.map((tool) => (
          <a
            href={tool.url}
            class="p-3.5 rounded-xl bg-surface-container-lowest border border-outline-variant/60 hover:border-primary/40 hover:-translate-y-1 hover:shadow-xs transition-all text-center group flex flex-col items-center justify-between"
          >
            <div class="w-8 h-8 rounded-lg bg-zinc-100 group-hover:bg-primary group-hover:text-white flex items-center justify-center transition-colors mb-2">
              <span class="material-symbols-outlined text-lg" aria-hidden="true">{tool.icon}</span>
            </div>
            <span class="font-bold text-xs text-on-surface group-hover:text-primary transition-colors block">{tool.title}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. FAQs Accordion -->
    <section class="border-t border-zinc-200/60 pt-12 space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.faqsTitle}</h2>
      <div class="space-y-3 max-w-3xl mx-auto">
        {pageMeta.faqs.map((faq) => (
          <details class="group border border-outline-variant/60 rounded-2xl bg-surface-container-lowest overflow-hidden shadow-xs transition-all">
            <summary class="flex justify-between items-center p-4.5 cursor-pointer font-bold text-sm sm:text-base hover:bg-surface-container-low transition-colors select-none text-on-surface">
              <span>{faq.q}</span>
              <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-on-surface-variant">expand_more</span>
            </summary>
            <p class="px-4.5 pb-4.5 pt-1 text-on-surface-variant text-xs sm:text-sm leading-relaxed border-t border-outline-variant/30">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- 7. Bottom CTA Banner -->
    <section class="rounded-3xl bg-linear-to-br from-zinc-900 to-zinc-950 text-white p-8 sm:p-12 text-center space-y-4 shadow-lg border border-zinc-800">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">{pageMeta.ctaTitle}</h2>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-lg mx-auto leading-relaxed">{pageMeta.ctaDesc}</p>
      <div class="pt-2">
        <button
          onclick="document.getElementById('generator')?.scrollIntoView({ behavior: 'smooth' });"
          class="px-6 py-3 rounded-full bg-white text-zinc-900 font-extrabold text-xs sm:text-sm hover:bg-zinc-100 hover:scale-105 transition-all shadow-md cursor-pointer"
        >
          {pageMeta.ctaBtn}
        </button>
      </div>
    </section>

  </div>

  <Footer locale={locale} />
</BaseLayout>
