          <rect x="41" y="9" width="10" height="10" rx="1" fill="#2563eb"/>
          <rect x="2" y="34" width="24" height="24" rx="3" fill="#2563eb"/>
          <rect x="6" y="38" width="16" height="16" rx="2" fill="#ffffff"/>
          <rect x="9" y="41" width="10" height="10" rx="1" fill="#2563eb"/>
