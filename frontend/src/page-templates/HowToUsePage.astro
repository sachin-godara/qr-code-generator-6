          <rect x="60" y="78" width="6" height="6" fill="#7c3aed"/>
        </svg>
      </div>
      <!-- Center-right silhouette -->
      <div class="absolute top-1/3 right-4 sm:right-12 opacity-[0.05] htu-float-c hidden sm:block">
        <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
          <rect x="2" y="2" width="24" height="24" rx="3" fill="#2563eb"/>
          <rect x="6" y="6" width="16" height="16" rx="2" fill="#ffffff"/>
          <rect x="9" y="9" width="10" height="10" rx="1" fill="#2563eb"/>
          <rect x="34" y="2" width="24" height="24" rx="3" fill="#2563eb"/>
