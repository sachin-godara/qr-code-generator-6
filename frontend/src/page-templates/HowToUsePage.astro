        </svg>
      </div>
    </div>

    <!-- Pill badge -->
    <div class="htu-reveal inline-flex items-center gap-2 bg-white/80 border border-white/60 backdrop-blur-sm rounded-full px-4 py-1.5 text-sm font-semibold text-on-surface-variant mb-6 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      {meta.heroBadge}
    </div>

    <!-- Main headline -->
    <h1 class="htu-reveal delay-1 text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight leading-[1.08] mb-6 max-w-4xl">
      {meta.heroH1Pre}
      <span class="htu-accent-text">{meta.heroH1Accent}</span>
      <br /> {meta.heroH1Post}
    </h1>

    <p class="htu-reveal delay-2 text-base sm:text-xl text-on-surface-variant max-w-2xl mb-10 leading-relaxed">
      {meta.heroDesc}
    </p>

    <!-- CTA Buttons -->
    <div class="htu-reveal delay-3 flex flex-wrap items-center justify-center gap-4 mb-16">
      <a
        href={getLocalizedUrl(locale, '/')}
        class="inline-flex items-center gap-2.5 bg-primary text-on-primary font-bold text-base px-7 py-3.5 rounded-xl shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group cursor-pointer"
        id="hero-start-creating-btn"
      >
        <span class="material-symbols-outlined text-[20px] group-hover:rotate-12 transition-transform duration-300">qr_code_2</span>
        {meta.startBtn}
      </a>
      <a
        href="#steps"
        class="inline-flex items-center gap-2.5 bg-white border border-outline-variant text-on-surface font-semibold text-base px-6 py-3.5 rounded-xl hover:shadow-md hover:-translate-y-1 transition-all duration-300 group cursor-pointer"
        id="hero-see-how-btn"
      >
        {meta.seeHowBtn}
        <span class="material-symbols-outlined text-[20px] group-hover:translate-y-0.5 transition-transform duration-300">expand_more</span>
      </a>
    </div>

    <!-- Quick stats row -->
    <div class="htu-reveal delay-4 flex flex-wrap items-center justify-center gap-8 sm:gap-12">
      {meta.stats.map(stat => (
        <div class="text-center">
          <div class="text-3xl font-bold text-on-surface tracking-tight">{stat.value}</div>
          <div class="text-xs font-medium text-on-surface-variant uppercase tracking-widest mt-0.5">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  SECTION 2: 5-STEP WALKTHROUGH          ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section id="steps" class="max-w-5xl mx-auto px-6 py-20 sm:py-24">
    <div class="text-center mb-16 htu-reveal">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-on-surface-variant bg-surface-container px-3.5 py-1 rounded-full mb-4">{meta.stepsBadge}</span>
      <h2 class="text-3xl sm:text-5xl font-bold text-on-surface mb-4">{meta.stepsHeading}</h2>
      <div class="htu-section-divider"></div>
    </div>

    <div class="space-y-6" id="steps-list">
      {steps.map((step, i) => (
        <div
