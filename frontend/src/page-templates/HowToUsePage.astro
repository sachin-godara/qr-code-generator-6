const exportsList = exportsMap[locale] || exportsMap.en;

const faqsMap: Record<Locale, Array<{ q: string; a: string }>> = {
  en: [
    { q: "Is QR Code Maker really 100% free?", a: "Yes — every single feature is completely free. No paywalls, no premium tiers, no watermarks, and no sign-up required. You can generate unlimited QR codes with full customization and download in any format for free." },
    { q: "Can I use generated QR codes commercially?", a: "Yes, all QR codes you create are yours to use freely for any purpose, including commercial products, marketing materials, packaging, and client work." },
    { q: "How do I make sure my QR code will scan reliably?", a: "Use Error Correction level H when adding a logo, maintain a 4.5:1 contrast ratio between dots and background, keep the quiet zone (white border), and test with multiple scanner apps before printing. Our Pro Tips section covers all best practices in detail." },
    { q: "What is the maximum batch size?", a: "The batch generator can handle CSV files with hundreds of rows. Each row generates one unique QR code. All codes are exported as a single ZIP file download." },
    { q: "What's the difference between dot styles?", a: "Dot styles change the shape of every module (data cell) in your QR code. Options include classic squares, perfect circles, rounded corners, flowing fluid shapes, stars, diamonds, leaves, hexagons, and more. Each style creates a distinct visual character while remaining fully scannable." },
    { q: "Can I add my company logo to every QR code?", a: "Yes — upload a PNG, JPG, or SVG logo once and it will be embedded in the center of your QR code. You can control the logo size, padding color, and shape. Error Correction H is automatically recommended when a logo is detected." },
    { q: "Do QR codes expire?", a: "Static QR codes (the type this tool generates) never expire. They are simple data-encoded images with no tracking, no server dependency, and no expiry date. As long as the destination URL exists, the code will always work." },
    { q: "Which scanner apps work best for testing?", a: "We recommend testing with at least 3 apps: the native iOS Camera app, Google Lens on Android, and a dedicated scanner like QR Code Reader by Scan. Testing cross-platform ensures compatibility for all your users." },
    { q: "What's the difference between Eye Frames and Eyeballs?", a: "Eye Frames are the outer border of the three corner squares (finder patterns). Eyeballs are the inner square inside each finder pattern. Mixing different styles for frames and eyeballs creates a highly unique QR code appearance." },
    { q: "Can I undo mistakes while designing?", a: "Yes — every change is tracked in the design history. Press Ctrl+Z (or ⌘+Z on Mac) to undo, and Ctrl+Shift+Z to redo. You can step back through your entire design session." },
  ],
  es: [
    { q: "¿Este generador de códigos QR es realmente 100% gratis?", a: "Sí: todas y cada una de las funciones son completamente gratuitas. Sin pagos, sin planes prémium, sin marcas de agua y sin necesidad de registrarse. Genera códigos ilimitados y descárgalos en alta resolución gratis." },
    { q: "¿Puedo usar los códigos QR con fines comerciales?", a: "Sí, todos los códigos QR que crees te pertenecen y puedes usarlos libremente para productos comerciales, publicidad, packaging y proyectos para clientes." },
    { q: "¿Cómo me aseguro de que el código QR se escanee bien?", a: "Usa corrección de error nivel H al insertar logos, mantén un contraste 4.5:1 entre puntos y fondo, conserva el margen blanco exterior y haz pruebas con varias apps antes de imprimir." },
    { q: "¿Cuál es el tamaño máximo de generación por lote?", a: "El generador por lote admite archivos CSV con cientos de filas. Cada fila genera un código QR único y se descargan todos comprimidos en un archivo ZIP." },
    { q: "¿Qué diferencia hay entre los estilos de puntos?", a: "Los estilos cambian la forma geométrica de cada módulo de datos: cuadrados clásicos, círculos, redondeados, formas fluidas, estrellas, hojas, etc. Cada estilo aporta una estética única sin perder escaneabilidad." },
    { q: "¿Puedo incluir el logo de mi empresa?", a: "Sí: sube cualquier archivo PNG, JPG o SVG. Puedes personalizar el tamaño, el fondo protector y la forma. El generador activa corrección H automáticamente." },
    { q: "¿Los códigos QR caducan?", a: "Los códigos estáticos generados aquí nunca caducan. La información está grabada directamente en la imagen sin depender de servidores externos." },
    { q: "¿Qué apps recomiendan para hacer pruebas?", a: "Recomendamos probar con al menos 3 lectores: la cámara nativa de iOS, Google Lens en Android y una app dedicada de escaneo QR." },
    { q: "¿Qué diferencia hay entre Marcos de Ojos y Centros?", a: "El marco de ojo es el borde exterior cuadrado de las esquinas (patrones de alineación). El centro es el punto interior. Combinar ambos da un aspecto totalmente personalizado." },
    { q: "¿Puedo deshacer cambios mientras diseño?", a: "Sí: cada cambio se guarda en el historial. Pulsa Ctrl+Z (o ⌘+Z en Mac) para deshacer, y Ctrl+Shift+Z para rehacer cualquier paso." },
  ],
  pt: [
    { q: "O QR Code Maker é realmente 100% gratuito?", a: "Sim — todas as ferramentas são 100% gratuitas. Sem taxas ocultas, sem planos pagos, sem marcas d'água e sem necessidade de cadastro. Crie QR codes ilimitados para sempre." },
    { q: "Posso utilizar os QR codes comercialmente?", a: "Sim, todos os QR codes criados são seus para usar livremente em produtos comerciais, campanhas publicitárias, embalagens e projetos para clientes." },
    { q: "Como garantir que meu QR code funcione perfeitamente?", a: "Utilize correção de erro nível H ao adicionar logo, mantenha contraste mínimo de 4.5:1, preserve a margem branca e teste em múltiplos celulares antes de imprimir." },
    { q: "Qual é o limite de geração em lote?", a: "O gerador em lote suporta planilhas CSV com centenas de linhas. Cada linha gera um QR code exclusivo e tudo é baixado em um único arquivo ZIP." },
    { q: "Qual a diferença entre os estilos de pontos?", a: "Os estilos alteram o formato visual de cada módulo de dados: quadrados, círculos perfeitos, cantos arredondados, formas fluidas, diamantes, folhas e muito mais." },
    { q: "Posso incluir o logotipo da minha empresa?", a: "Sim — envie seu logo em PNG, JPG ou SVG. Você controla o tamanho, margem de respiro e formato. O nível H é ativado automaticamente." },
    { q: "Os QR codes possuem prazo de validade?", a: "Não. Os códigos gerados são estáticos e os dados ficam gravados diretamente na imagem. Eles nunca expiram e funcionam para sempre." },
    { q: "Quais aplicativos são ideais para testes?", a: "Recomendamos testar com a Câmera nativa do iPhone, o Google Lens no Android e um leitor dedicado de QR code." },
    { q: "Qual a diferença entre Moldura do Canto e Centro do Olho?", a: "A moldura é o contorno externo dos três cantos do QR code. O centro é o quadrado interno. Misturar estilos cria um visual marcante e único." },
    { q: "Posso desfazer erros durante a criação?", a: "Sim — o estúdio salva todo o histórico da sessão. Use Ctrl+Z (ou ⌘+Z no Mac) para desfazer e Ctrl+Shift+Z para refazer." },
  ],
  de: [
    { q: "Ist der QR-Code-Maker wirklich 100% kostenlos?", a: "Ja — jede einzelne Funktion ist vollkommen kostenlos. Keine Paywalls, keine Abos, keine Wasserzeichen und keine Registrierung erforderlich. Unbegrenzte Downloads in allen Formaten." },
    { q: "Darf ich die QR-Codes gewerblich nutzen?", a: "Ja, alle erstellten QR-Codes gehören Ihnen und dürfen frei für kommerzielle Produkte, Marketingunterlagen, Verpackungen und Kundenprojekte verwendet werden." },
    { q: "Wie stelle ich sicher, dass mein QR-Code zuverlässig scannt?", a: "Nutzen Sie Fehlerkorrektur H bei Logos, achten Sie auf einen Kontrast von 4,5:1, halten Sie die weiße Ruhezone ein und testen Sie mit mehreren Kameras vor dem Druck." },
    { q: "Wie viele Codes kann ich per CSV-Stapelverarbeitung generieren?", a: "Die Stapelverarbeitung verarbeitet Tabellen mit hunderten von Zeilen. Alle generierten QR-Codes werden gebündelt als ZIP-Datei heruntergeladen." },
    { q: "Was bewirken die verschiedenen Punktstile?", a: "Punktstile verändern die Form der einzelnen Datenzellen: Quadrate, Kreise, abgerundet, organisch, Sterne, Rauten und mehr — für einen individuellen Look." },
    { q: "Kann ich mein Firmenlogo einbinden?", a: "Ja — laden Sie ein PNG-, JPG- oder SVG-Logo hoch. Sie bestimmen Größe, Schutzabstand und Form. Fehlerkorrektur Level H wird automatisch gewählt." },
    { q: "Haben die QR-Codes ein Ablaufdatum?", a: "Nein. Die hier erstellten statischen QR-Codes laufen niemals ab. Die Daten sind direkt im Muster gespeichert und bleiben dauerhaft gültig." },
    { q: "Welche Scanner-Apps empfehlen sich zum Testen?", a: "Wir empfehlen Tests mit der iOS-Kamera-App, Google Lens auf Android sowie einem eigenständigen Barcode-Scanner." },
    { q: "Was ist der Unterschied zwischen Eckenrahmen und Mittelpunkt?", a: "Der Eckenrahmen ist die äußere Umrandung der drei Positionierungsquadrate. Der Mittelpunkt ist das innere Quadrat. Die Kombination schafft unverwechselbare Designs." },
    { q: "Kann ich Fehler während der Gestaltung rückgängig machen?", a: "Ja — jeder Schritt wird im Verlauf gespeichert. Mit Strg+Z (bzw. ⌘+Z auf dem Mac) machen Sie Änderungen rückgängig, mit Strg+Umschalt+Z stellen Sie sie wieder her." },
  ],
  tr: [
    { q: "QR Code Maker gerçekten %100 ücretsiz mi?", a: "Evet — her özellik tamamen ücretsizdir. Ödeme duvarı, abonelik, filigran ve kayıt zorunluluğu yoktur. Sınırsız QR kod oluşturup ücretsiz indirebilirsiniz." },
    { q: "Oluşturulan QR kodlarını ticari olarak kullanabilir miyim?", a: "Evet, oluşturduğunuz tüm QR kodları ticari ürünlerde, pazarlamada, ambalajlarda ve müşteri projelerinde serbestçe kullanılabilir." },
    { q: "QR kodumun güvenilir şekilde taranmasını nasıl sağlarım?", a: "Logo eklerken H hata düzeltme seviyesini kullanın, 4.5:1 kontrast oranını koruyun, beyaz sessiz alanı bırakın ve baskı öncesinde test edin." },
    { q: "Toplu üretimde maksimum boyut nedir?", a: "Toplu oluşturucu yüzlerce satırlık CSV dosyalarını işleyebilir. Tüm QR kodları tek bir ZIP arşivi olarak indirilir." },
    { q: "Nokta stilleri arasındaki fark nedir?", a: "Nokta stilleri QR kodunuzdaki her veri hücresinin şeklini değiştirir: klasik kareler, pürüzsüz daireler, yuvarlatılmış köşeler, yıldızlar, yapraklar ve daha fazlası." },
    { q: "Her QR koduna şirket logomu ekleyebilir miyim?", a: "Evet — PNG, JPG veya SVG formatında bir logo yükleyin. Boyutunu, dolgu rengini ve şeklini özelleştirebilirsiniz." },
    { q: "QR kodlarının süresi dolar mı?", a: "Hayır. Statik QR kodları asla sona ermez. Veriler doğrudan görüntünün içine kodlandığı için sonsuza kadar çalışır." },
    { q: "Test için hangi okuyucu uygulamaları en iyisidir?", a: "En az 3 uygulamayla test etmenizi öneririz: iOS yerel Kamera uygulaması, Android'de Google Lens ve bağımsız bir QR okuyucu." },
    { q: "Göz Çerçevesi ile Göz Bebeği arasındaki fark nedir?", a: "Göz çerçevesi 3 köşedeki karelerin dış kenarlığıdır. Göz bebeği ise iç merkezdeki noktadır." },
    { q: "Tasarım yaparken hataları geri alabilir miyim?", a: "Evet — oturumdaki her adım geçmişte kaydedilir. Geri almak için Ctrl+Z (veya Mac'te ⌘+Z), yinelemek için Ctrl+Shift+Z tuşlarına basabilirsiniz." },
  ]
};

const faqs = faqsMap[locale] || faqsMap.en;

const howTo = {
  name: meta.stepsHeading,
  description: meta.desc,
  steps: steps.map(s => ({ name: s.title, text: s.description }))
};
---
<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.desc}
  keywords={meta.keywords}
  breadcrumbs={breadcrumbs}
  howTo={howTo}
  faqs={faqs}
>
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/how-to-use.css';
  </style>

  <Header locale={locale} />

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  SECTION 1: CINEMATIC HERO               ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="htu-hero-bg relative overflow-hidden min-h-[85vh] flex flex-col items-center justify-center px-6 py-20 text-center">
    <!-- Floating QR silhouettes -->
    <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
      <!-- Top-left silhouette -->
      <div class="absolute top-10 left-8 sm:left-16 opacity-[0.07] htu-float-a">
        <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
          <rect x="4" y="4" width="48" height="48" rx="6" fill="#18181b"/>
          <rect x="14" y="14" width="28" height="28" rx="3" fill="#ffffff"/>
          <rect x="19" y="19" width="18" height="18" rx="2" fill="#18181b"/>
          <rect x="68" y="4" width="48" height="48" rx="6" fill="#18181b"/>
          <rect x="78" y="14" width="28" height="28" rx="3" fill="#ffffff"/>
          <rect x="83" y="19" width="18" height="18" rx="2" fill="#18181b"/>
          <rect x="4" y="68" width="48" height="48" rx="6" fill="#18181b"/>
          <rect x="14" y="78" width="28" height="28" rx="3" fill="#ffffff"/>
          <rect x="19" y="83" width="18" height="18" rx="2" fill="#18181b"/>
          <rect x="68" y="68" width="8" height="8" fill="#18181b"/>
          <rect x="80" y="68" width="8" height="8" fill="#18181b"/>
          <rect x="92" y="68" width="8" height="8" fill="#18181b"/>
          <rect x="104" y="68" width="8" height="8" fill="#18181b"/>
          <rect x="68" y="80" width="8" height="8" fill="#18181b"/>
          <rect x="80" y="80" width="8" height="8" fill="#18181b"/>
          <rect x="92" y="92" width="8" height="8" fill="#18181b"/>
          <rect x="104" y="80" width="8" height="8" fill="#18181b"/>
          <rect x="68" y="92" width="8" height="8" fill="#18181b"/>
          <rect x="80" y="104" width="8" height="8" fill="#18181b"/>
          <rect x="104" y="104" width="8" height="8" fill="#18181b"/>
        </svg>
      </div>
      <!-- Bottom-right silhouette -->
      <div class="absolute bottom-16 right-8 sm:right-20 opacity-[0.06] htu-float-b">
        <svg width="90" height="90" viewBox="0 0 90 90" fill="none">
          <rect x="3" y="3" width="36" height="36" rx="5" fill="#7c3aed"/>
          <rect x="10" y="10" width="22" height="22" rx="2" fill="#ffffff"/>
          <rect x="15" y="15" width="12" height="12" rx="1" fill="#7c3aed"/>
          <rect x="51" y="3" width="36" height="36" rx="5" fill="#7c3aed"/>
          <rect x="58" y="10" width="22" height="22" rx="2" fill="#ffffff"/>
          <rect x="63" y="15" width="12" height="12" rx="1" fill="#7c3aed"/>
          <rect x="3" y="51" width="36" height="36" rx="5" fill="#7c3aed"/>
          <rect x="10" y="58" width="22" height="22" rx="2" fill="#ffffff"/>
          <rect x="15" y="63" width="12" height="12" rx="1" fill="#7c3aed"/>
          <rect x="51" y="51" width="6" height="6" fill="#7c3aed"/>
