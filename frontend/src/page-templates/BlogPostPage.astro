---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { type Locale } from '../i18n/config';
import { getLocalizedUrl, t } from '../i18n/utils';

interface Props {
  locale: Locale;
  post: any;
  Content: any;
  relatedPosts: any[];
}

const { locale, post, Content, relatedPosts } = Astro.props;

const title = post.data.title;
const description = post.data.description;

const breadcrumbs = [
  { name: t(locale, 'nav.generator'), url: getLocalizedUrl(locale, '/') },
  { name: t(locale, 'nav.blog'), url: getLocalizedUrl(locale, '/blog') },
  { name: title.length > 40 ? title.substring(0, 40) + '…' : title, url: getLocalizedUrl(locale, `/blog/${post.id}`) }
];

const categoryIconMap: Record<string, string> = {
  'guides': 'menu_book',
  'use-cases': 'cases',
  'design-tips': 'palette',
  'industry': 'business',
  'comparisons': 'compare',
  'news': 'newspaper',
};

const catLabel = t(locale, `blog.categories.${post.data.category}`) || post.data.category;
const catIcon = categoryIconMap[post.data.category] || 'article';

const localeFormatMap: Record<Locale, string> = {
  en: 'en-US',
  es: 'es-ES',
  pt: 'pt-BR',
  de: 'de-DE'
};

function formatDate(date: Date): string {
  return date.toLocaleDateString(localeFormatMap[locale] || 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Article structured data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "inLanguage": locale,
  "headline": title,
  "description": description,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": post.data.author || "GenerateCustomQR Team",
    "url": "https://generatecustomqr.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "GenerateCustomQR",
    "url": "https://generatecustomqr.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://generatecustomqr.com/favicon-96x96.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://generatecustomqr.com${getLocalizedUrl(locale, `/blog/${post.id}`)}`
  }
};

// Build FAQ structured data from frontmatter if available
const faqs = post.data.faqs || [];

// Build HowTo structured data from frontmatter if available
const howTo = post.data.howToSteps && post.data.howToSteps.length > 0 ? {
  name: title,
  description: description,
  steps: post.data.howToSteps
} : undefined;
---
<BaseLayout
  locale={locale}
  title={`${title} | GenerateCustomQR Blog`}
  description={description}
  keywords={post.data.tags && post.data.tags.length > 0 ? post.data.tags.join(', ') : undefined}
  ogImage={post.data.image || "/og-blog.jpg"}
  pageType="article"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  howTo={howTo}
>
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/blog.css';
  </style>

  <!-- Article JSON-LD Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="min-h-screen flex flex-col bg-surface">
    <Header locale={locale} />

    <main class="flex-grow">
      <!-- Reading Progress Bar -->
      <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

      <!-- ═══ ARTICLE HEADER ═══ -->
      <header class="py-12 md:py-20 border-b border-outline-variant/50 bg-surface-container-lowest">
        <div class="max-w-3xl mx-auto px-4 sm:px-6">
          <div class="space-y-6">
            <!-- Category & Reading Time -->
            <div class="flex items-center gap-3 flex-wrap">
              <span class="category-badge" data-cat={post.data.category}>
                <span class="material-symbols-outlined text-[12px]">{catIcon}</span>
                {catLabel}
              </span>
              {post.data.readingTime && (
                <span class="text-xs font-semibold text-on-surface-variant flex items-center gap-1 bg-surface-container px-2.5 py-1 rounded-full border border-outline-variant/40">
                  <span class="material-symbols-outlined text-[14px]">schedule</span>
                  {t(locale, 'blog.minRead', { min: post.data.readingTime }) || `${post.data.readingTime} min read`}
                </span>
              )}
            </div>

            <!-- Title -->
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-on-surface tracking-tight leading-[1.15]">
              {title}
            </h1>

            <!-- Description / Subtitle -->
            <p class="text-lg sm:text-xl text-on-surface-variant leading-relaxed">
              {description}
            </p>

            <!-- Meta Row -->
            <div class="flex items-center justify-between pt-4 border-t border-outline-variant/40 text-xs text-on-surface-variant">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
                  GC
                </div>
                <div>
                  <span class="font-bold text-on-surface block">{post.data.author || "GenerateCustomQR Team"}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- ═══ ARTICLE BODY ═══ -->
      <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16 blog-prose">
        <Content />
      </article>

      <!-- ═══ RELATED POSTS ═══ -->
      {relatedPosts.length > 0 && (
        <section class="border-t border-outline-variant/50 bg-surface-container-low/30 py-12 md:py-16">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
            <div class="flex items-center justify-between">
              <h2 class="text-2xl font-black text-on-surface tracking-tight">{t(locale, 'blog.relatedGuides')}</h2>
              <a href={getLocalizedUrl(locale, '/blog')} class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                {t(locale, 'blog.viewAll')} <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
            <div class="grid sm:grid-cols-3 gap-6">
              {relatedPosts.map((p) => {
                const relCat = t(locale, `blog.categories.${p.data.category}`) || p.data.category;
                return (
                  <a href={getLocalizedUrl(locale, `/blog/${p.id}`)} class="p-5 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 hover-lift space-y-3 block">
                    <span class="px-2 py-0.5 rounded-md bg-surface text-[10px] font-bold text-primary uppercase">
                      {relCat}
                    </span>
                    <h3 class="font-bold text-on-surface text-base line-clamp-2">{p.data.title}</h3>
                    <p class="text-xs text-on-surface-variant line-clamp-2">{p.data.description}</p>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )}

      <!-- ═══ BOTTOM CTA ═══ -->
      <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16">
        <div class="rounded-3xl bg-gradient-to-br from-zinc-950 via-zinc-900 to-zinc-800 text-white p-8 sm:p-10 shadow-2xl text-center space-y-4">
          <h2 class="text-2xl font-black tracking-tight">{t(locale, 'blog.postCtaTitle')}</h2>
          <p class="text-zinc-400 text-sm max-w-md mx-auto">
            {t(locale, 'blog.postCtaDesc')}
          </p>
          <div class="pt-2">
            <a
              href={getLocalizedUrl(locale, '/')}
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-zinc-900 font-bold text-sm hover:bg-zinc-100 shadow-md hover:scale-105 transition-all"
            >
              <span class="material-symbols-outlined text-lg">qr_code_2</span>
              {t(locale, 'blog.postCtaButton')}
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer locale={locale} />
  </div>

  <script>
    // Reading progress bar
    window.addEventListener('scroll', () => {
      const progressBar = document.getElementById('reading-progress');
      if (!progressBar) return;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = (window.scrollY / totalHeight) * 100;
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    });
  </script>
</BaseLayout>
