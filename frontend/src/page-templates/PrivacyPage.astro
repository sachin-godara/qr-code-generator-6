  <p>{pageMeta.s9Lead}</p>
  <ul>
    {pageMeta.s9Rights.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 10: CCPA -->
  <h2 id="section-10">{pageMeta.s10Title}</h2>
  <p>{pageMeta.s10Lead}</p>
  <ul>
    {pageMeta.s10Points.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 11: LGPD -->
  <h2 id="section-11">{pageMeta.s11Title}</h2>
  <p>{pageMeta.s11Text}</p>

  <!-- Section 12: COPPA -->
  <h2 id="section-12">{pageMeta.s12Title}</h2>
  <p>{pageMeta.s12Text}</p>

  <!-- Section 13: Security & Breach Protocol -->
  <h2 id="section-13">{pageMeta.s13Title}</h2>
  <p>{pageMeta.s13Lead}</p>
  <ul>
    {pageMeta.s13Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 14: Business Transfers -->
  <h2 id="section-14">{pageMeta.s14Title}</h2>
  <p>{pageMeta.s14Text}</p>

  <!-- Section 15: External Links -->
  <h2 id="section-15">{pageMeta.s15Title}</h2>
  <p>{pageMeta.s15Text}</p>

  <!-- Section 16: Revisions & Contact -->
  <h2 id="section-16">{pageMeta.s16Title}</h2>
  <p>{pageMeta.s16Text}</p>

  <!-- FAQs Section -->
  <h2 id="privacy-faqs">{pageMeta.faqTitle}</h2>
  <div class="legal-faq-section not-prose">
    {pageMeta.faqs.map((faq) => (
      <details class="legal-faq-item">
        <summary class="legal-faq-summary">
          <span>{faq.q}</span>
          <span class="material-symbols-outlined legal-faq-chevron">expand_more</span>
        </summary>
        <div class="legal-faq-content">
          <p>{faq.a}</p>
        </div>
      </details>
    ))}
  </div>

  <!-- Bottom CTA Card -->
  <div class="legal-cta-card not-prose">
    <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center">
      <span class="material-symbols-outlined text-2xl">mail</span>
    </div>
    <h3>{pageMeta.ctaTitle}</h3>
    <p>{pageMeta.ctaDesc}</p>
    <a href={getLocalizedUrl(locale, '/contact')} class="legal-btn-primary">
      <span class="material-symbols-outlined text-lg">contact_support</span>
      <span>{pageMeta.ctaBtn}</span>
    </a>
  </div>
</LegalLayout>

