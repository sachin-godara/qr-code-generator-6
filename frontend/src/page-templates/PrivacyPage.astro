const pageMeta = metaMap[locale] || metaMap.en;

const breadcrumbs = [
  { name: t(locale, 'nav.generator'), url: getLocalizedUrl(locale, '/') },
  { name: t(locale, 'footer.privacy'), url: getLocalizedUrl(locale, '/privacy-policy') }
];
---
<LegalLayout
  locale={locale}
  title={pageMeta.title}
  description={pageMeta.desc}
  keywords={pageMeta.keywords}
  breadcrumbs={breadcrumbs}
  heading={pageMeta.heading}
  badge={pageMeta.badge}
  lastUpdated={pageMeta.lastUpdated}
  icon="security"
  faqs={pageMeta.faqs}
>
  <!-- Summary Highlights Grid -->
  <div class="legal-highlight-grid not-prose">
    {pageMeta.highlights.map((item) => (
      <div class="legal-highlight-card">
        <div class="legal-card-icon">
          <span class="material-symbols-outlined text-xl">{item.icon}</span>
        </div>
        <h4>{item.title}</h4>
        <p>{item.desc}</p>
      </div>
    ))}
  </div>

  <!-- Table of Contents -->
  <nav class="legal-toc-card not-prose" aria-label="Table of Contents">
    <div class="legal-toc-title">
      <span class="material-symbols-outlined text-primary text-xl">list_alt</span>
      <span>{pageMeta.tocTitle}</span>
    </div>
    <ul class="legal-toc-list">
      {pageMeta.toc.map((item) => (
        <li>
          <a href={`#${item.id}`} class="legal-toc-link">
            <span class="legal-toc-number">•</span>
            <span>{item.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Section 1 -->
  <h2 id="section-1">{pageMeta.s1Title}</h2>
  <p>{pageMeta.s1P1}</p>
  <p>{pageMeta.s1P2}</p>

  <div class="legal-callout legal-callout-success">
    <p><strong>{pageMeta.badge}</strong>: {pageMeta.s1Controller}</p>
  </div>

  <!-- Section 2 -->
  <h2 id="section-2">{pageMeta.s2Title}</h2>
  <p>{pageMeta.s2Lead}</p>
  <ul>
    {pageMeta.s2Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 3 -->
  <h2 id="section-3">{pageMeta.s3Title}</h2>
  <p>{pageMeta.s3Lead}</p>
  <ul>
    {pageMeta.s3Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 4: Matrix Table -->
  <h2 id="section-4">{pageMeta.s4Title}</h2>
  <p>{pageMeta.s4Lead}</p>
  
  <div class="legal-table-container">
    <table class="legal-table">
      <thead>
        <tr>
          <th>{pageMeta.matrixHeaders.category}</th>
          <th>{pageMeta.matrixHeaders.data}</th>
          <th>{pageMeta.matrixHeaders.purpose}</th>
          <th>{pageMeta.matrixHeaders.storage}</th>
          <th>{pageMeta.matrixHeaders.retention}</th>
        </tr>
      </thead>
      <tbody>
        {pageMeta.matrixRows.map((row) => (
          <tr>
            <td><strong>{row.category}</strong></td>
            <td>{row.data}</td>
            <td>{row.purpose}</td>
            <td><span class="legal-badge legal-badge-info">{row.storage}</span></td>
            <td><span class="legal-badge legal-badge-success">{row.retention}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Section 5 -->
  <h2 id="section-5">{pageMeta.s5Title}</h2>
  <p>{pageMeta.s5Lead}</p>
  <ul>
    {pageMeta.s5Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>
  
  <div class="legal-callout">
    <p>{pageMeta.s5ClearTip}</p>
  </div>

  <!-- Section 6 -->
  <h2 id="section-6">{pageMeta.s6Title}</h2>
  <p>{pageMeta.s6Lead}</p>
  <ul>
    {pageMeta.s6Items.map((item) => (
      <li>
        <strong>{item.name}:</strong> {item.role} (<a href={item.privacyUrl} target="_blank" rel="noopener noreferrer">Privacy Policy</a>)
      </li>
    ))}
  </ul>

  <!-- Section 7: International Transfers -->
  <h2 id="section-7">{pageMeta.s7Title}</h2>
  <p>{pageMeta.s7Lead}</p>
  <ul>
    {pageMeta.s7Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 8: DNT & GPC -->
