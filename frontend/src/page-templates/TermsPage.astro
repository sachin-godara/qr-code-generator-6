---
import LegalLayout from '../layouts/LegalLayout.astro';
import { type Locale } from '../i18n/config';
import { getLocalizedUrl, t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const metaMap: Record<Locale, { title: string; desc: string; heading: string; keywords?: string; s1Title: string; s1Text: string; s2Title: string; s2Text: string; s3Title: string; s3Text: string; s4Title: string; s4Text: string; s5Title: string; s5Text: string; lastUpdated: string }> = {
  en: {
    title: "Terms and Conditions — GenerateCustomQR",
    desc: "Terms of service and usage conditions for GenerateCustomQR. Free for both personal and commercial projects with zero restrictions.",
    keywords: "qr code generator terms, commercial use qr code license, free qr code terms of service",
    heading: "Terms & Conditions",
    lastUpdated: "January 1, 2026",
    s1Title: "1. Acceptance of Terms",
    s1Text: "By accessing or using GenerateCustomQR, you agree to be bound by these Terms and Conditions. If you do not agree to these terms, please do not use our service.",
    s2Title: "2. Free & Commercial License",
    s2Text: "All QR codes generated through GenerateCustomQR are 100% free for both personal and commercial use. You own all rights to the generated image files and may print, distribute, or publish them without royalty fees or attribution requirements.",
    s3Title: "3. Acceptable Use & Prohibited Content",
    s3Text: "You agree not to use GenerateCustomQR to encode malicious URLs (phishing, malware distribution, scams), deceptive content, or unlawful materials. We reserve the right to block malicious automated abuse.",
    s4Title: "4. Scannability, Device Compatibility & Warranty Disclaimer",
    s4Text: "The service is provided 'as is' and 'as available' without warranties of any kind. While our QR engine strictly conforms to ISO/IEC 18004 standards and employs automated computer vision quality checks, physical device hardware (including camera sensor resolution, optical quality, lighting conditions, and ambient glare) and user-selected custom styling (such as low contrast, custom dot geometries, or embedded logos) can affect scannability across certain legacy or budget devices. Users bear sole responsibility for conducting physical test-scans across multiple smartphone cameras prior to commercial, bulk, or permanent print production.",
    s5Title: "5. Modifications to Service",
    s5Text: "GenerateCustomQR reserves the right to enhance, modify, or update features at any time to improve system speed, security, and user experience."
  },
  es: {
    title: "Términos y Condiciones — GenerateCustomQR",
    desc: "Términos del servicio y condiciones de uso de GenerateCustomQR. Gratis para proyectos personales y comerciales sin restricciones.",
    keywords: "terminos y condiciones generador qr, licencia comercial qr gratis, terminos de servicio qr",
    heading: "Términos y Condiciones",
    lastUpdated: "1 de Enero de 2026",
    s1Title: "1. Aceptación de los Términos",
    s1Text: "Al acceder o utilizar GenerateCustomQR, aceptas quedar vinculado por estos Términos y Condiciones de uso.",
    s2Title: "2. Licencia Gratuita y Comercial",
    s2Text: "Todos los códigos QR generados son 100% gratuitos para uso personal y comercial. Eres el propietario exclusivo de los archivos descargados y puedes imprimirlos o distribuirlos sin pagar regalías ni incluir atribución.",
    s3Title: "3. Uso Aceptable y Contenido Prohibido",
    s3Text: "Te comprometes a no utilizar GenerateCustomQR para codificar enlaces fraudulentos (phishing, malware, estafas) ni contenidos ilegales.",
    s4Title: "4. Escaneabilidad, Compatibilidad de Dispositivos y Descargo de Responsabilidad",
    s4Text: "El servicio se ofrece 'tal cual' y según disponibilidad. Aunque nuestro motor cumple rigurosamente con el estándar ISO/IEC 18004 e implementa controles de visión artificial, las variaciones ópticas de los dispositivos (sensores de cámara, iluminación, reflejos) y las personalizaciones elegidas por el usuario (contrastes reducidos, puntos personalizados o logotipos) pueden influir en la lectura en teléfonos antiguos o de gama de entrada. El usuario es el único responsable de realizar pruebas de escaneo físicas con múltiples dispositivos móviles antes de iniciar tiradas de impresión comercial o masiva.",
    s5Title: "5. Modificaciones del Servicio",
    s5Text: "GenerateCustomQR se reserva el derecho de añadir nuevas funciones y mejoras continuas para optimizar la experiencia de usuario."
  },
  pt: {
    title: "Termos de Uso — GenerateCustomQR",
    desc: "Termos de serviço e condições de uso do GenerateCustomQR. Gratuito para uso pessoal e comercial sem restrições.",
    keywords: "termos de uso gerador qr code, licenca comercial qr code gratis, termos de servico qr",
    heading: "Termos e Condições",
    lastUpdated: "1 de Janeiro de 2026",
    s1Title: "1. Aceitação dos Termos",
    s1Text: "Ao acessar e utilizar o GenerateCustomQR, você concorda com estes Termos e Condições de Uso.",
    s2Title: "2. Licença Gratuita para Uso Comercial",
    s2Text: "Todos os QR codes gerados são 100% gratuitos para uso pessoal e comercial. Você detém todos os direitos sobre as imagens criadas e pode utilizá-las livremente sem cobrança de taxas.",
    s3Title: "3. Uso Aceitável e Conteúdo Proibido",
    s3Text: "É expressamente proibido utilizar o gerador para criar links maliciosos, golpes virtuais, vírus ou distribuição de conteúdo ilegal.",
    s4Title: "4. Escaneabilidade, Compatibilidade de Dispositivos e Isenção de Garantias",
    s4Text: "O serviço é fornecido 'como está' e 'conforme disponível'. Embora nosso gerador siga rigorosamente o padrão ISO/IEC 18004 e utilize verificação por visão computacional, fatores físicos de hardware (resolução da câmera, qualidade óptica, iluminação ambiente) e customizações visuais definidas pelo usuário (baixo contraste, formatos artísticos de pontos ou inclusão de logotipos) podem afetar a leitura em aparelhos legados ou de entrada. É de responsabilidade exclusiva do usuário realizar testes práticos de escaneamento em múltiplos smartphones antes de qualquer produção gráfica ou distribuição em massa.",
    s5Title: "5. Atualizações da Plataforma",
    s5Text: "O GenerateCustomQR reserva-se o direito de aprimorar ferramentas e recursos constantemente visando a melhor performance."
  },
  de: {
    title: "Nutzungsbedingungen — GenerateCustomQR",
    desc: "Nutzungsbedingungen und Lizenzbestimmungen von GenerateCustomQR. Kostenlos für private und gewerbliche Nutzung ohne Einschränkungen.",
    keywords: "nutzungsbedingungen qr code generator, kommerzielle nutzung qr code lizenz, agb qr code",
    heading: "Nutzungsbedingungen",
    lastUpdated: "1. Januar 2026",
    s1Title: "1. Geltungsbereich und Annahme",
    s1Text: "Mit dem Zugriff auf GenerateCustomQR akzeptieren Sie diese Nutzungsbedingungen vollumfänglich.",
    s2Title: "2. Kostenlose & Gewerbliche Lizenz",
    s2Text: "Alle mit GenerateCustomQR erzeugten QR-Codes sind uneingeschränkt und lizenzfrei für private wie kommerzielle Vorhaben nutzbar. Sie besitzen alle Rechte an den Bilddateien.",
    s3Title: "3. Unzulässige Nutzung",
    s3Text: "Die Erstellung von QR-Codes mit betrügerischen (Phishing), schädlichen (Malware) oder gesetzeswidrigen Inhalten ist streng untersagt.",
    s4Title: "4. Scanbarkeit, Gerätekompatibilität und Haftungsausschluss",
    s4Text: "Der Dienst wird ohne Mängelgewähr und nach Verfügbarkeit bereitgestellt. Obwohl unsere QR-Engine den ISO/IEC 18004-Standards entspricht und automatisierte Computervision-Prüfungen durchführt, können Hardwarefaktoren (Kamerasensorauflösung, optische Qualität, Lichtverhältnisse) sowie benutzerdefinierte Designs (geringe Kontraste, künstlerische Punktformen oder Logos) die Lesbarkeit auf älteren oder leistungsschwächeren Mobilgeräten beeinträchtigen. Nutzer tragen die alleinige Verantwortung dafür, vor dem kommerziellen Druck oder der Massenvervielfältigung physische Probescans auf mehreren Smartphones durchzuführen.",
    s5Title: "5. Änderungen der Plattform",
    s5Text: "GenerateCustomQR behält sich das Recht vor, Funktionen kontinuierlich zu aktualisieren und zu optimieren."
  }
};

const pageMeta = metaMap[locale] || metaMap.en;

const breadcrumbs = [
  { name: t(locale, 'nav.generator'), url: getLocalizedUrl(locale, '/') },
  { name: t(locale, 'footer.terms'), url: getLocalizedUrl(locale, '/terms') }
];
---
<LegalLayout
  locale={locale}
  title={pageMeta.title}
  description={pageMeta.desc}
  keywords={pageMeta.keywords}
  breadcrumbs={breadcrumbs}
  heading={pageMeta.heading}
  lastUpdated={pageMeta.lastUpdated}
  icon="gavel"
>
  <h2>{pageMeta.s1Title}</h2>
  <p>{pageMeta.s1Text}</p>

  <h2>{pageMeta.s2Title}</h2>
  <p>{pageMeta.s2Text}</p>

  <h2>{pageMeta.s3Title}</h2>
  <p>{pageMeta.s3Text}</p>

  <h2>{pageMeta.s4Title}</h2>
  <p>{pageMeta.s4Text}</p>

  <h2>{pageMeta.s5Title}</h2>
  <p>{pageMeta.s5Text}</p>
</LegalLayout>
