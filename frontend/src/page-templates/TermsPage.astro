      { id: "section-5", title: "5. Funktionsweise statischer QR-Codes" },
      { id: "section-6", title: "6. Druckstandards und Scanbarkeit" },
      { id: "section-7", title: "7. Druck- und Größenmatrix" },
      { id: "section-8", title: "8. Haftungsausschluss (Bereitstellung wie gesehen)" },
      { id: "section-9", title: "9. Haftungsbeschränkung" },
      { id: "section-10", title: "10. Freistellungsverpflichtung" },
      { id: "section-11", title: "11. Externe Ziel-Links und Inhalte" },
      { id: "section-12", title: "12. Änderungen der Plattform" },
      { id: "section-13", title: "13. Anwendbares Recht, Salvatorische Klausel & Kontakt" }
    ],
    s1Title: "1. Geltungsbereich und Vertragsannahme",
    s1P1: "Diese Nutzungsbedingungen stellen eine verbindliche Vereinbarung zwischen Ihnen (als Einzelperson oder als Vertreter eines Unternehmens) und GenerateCustomQR Media & Software Technologies ('GenerateCustomQR', 'wir', 'uns' oder 'unser', erreichbar unter generatecustomqr.com) dar, die den Zugriff auf und die Nutzung unseres QR-Code-Generators und unserer Vektortools regelt.",
    s1P2: "Durch den Zugriff auf unsere Website, das Erstellen von QR-Codes oder das Herunterladen von Bilddateien erklären Sie sich mit diesen Bedingungen uneingeschränkt einverstanden. Sollten Sie den Bedingungen nicht zustimmen, ist die Nutzung des Dienstes einzustellen.",
    s2Title: "2. Gewerbliche Lizenz & Rechte an erzeugten Bilddateien",
    s2Lead: "Wir gewähren Ihnen umfassende und rechtssichere Nutzungsrechte an allen erstellten Grafiken:",
    s2Items: [
      {
        title: "Unbefristete Kommerzielle und Private Lizenz",
        desc: "Alle über GenerateCustomQR erzeugten Bilddateien (PNG-Raster, SVG-Vektoren, PDF-Druckdateien) sind weltweit, zeitlich unbegrenzt und zu 100% lizenzgebührenfrei für private wie gewerbliche Zwecke nutzbar."
      },
      {
        title: "Volles Eigentum an Ihren Resultaten",
        desc: "Sie behalten sämtliche Rechte an den heruntergeladenen Bilddateien. GenerateCustomQR erhebt keinerlei Urheberrechtsansprüche auf Ihre erstellten QR-Codes."
      },
      {
        title: "Keine Lizenz- oder Folgegebühren",
        desc: "Sie dürfen Ihre QR-Codes ohne zusätzliche Kosten auf Verpackungen drucken, in Büchern veröffentlichen, auf Plakaten plazieren oder in TV-Beiträgen zeigen."
      },
      {
        title: "Keine Kennzeichnungspflicht (Attribution)",
        desc: "Es ist nicht erforderlich, Wasserzeichen, Quellenangaben oder Links zu GenerateCustomQR auf Ihren Druckerzeugnissen oder Medien anzubringen."
      }
    ],
    s3Title: "3. Urheberrechte an der Plattform",
    s3Lead: "Während Sie die erzeugten Bilddateien uneingeschränkt besitzen, verbleiben die Rechte an der Software bei uns:",
    s3Items: [
      {
        title: "Plattformsoftware & Quellcode",
        desc: "Der Programmcode, die Matrix-Algorithmen, das Interface-Design, Logos und benutzerdefinierte SVG-Rahmengeometrien sind das geistige Eigentum von GenerateCustomQR."
      },
      {
        title: "Untersagung von Klon-Diensten",
        desc: "Es ist untersagt, die Benutzeroberfläche oder den Code zu kopieren, um einen konkurrierenden Dienst unter unserer Marke oder mit unseren Grafiken zu betreiben."
      }
    ],
    s4Title: "4. Zulässige Nutzung und Verbotene Inhalte",
    s4Lead: "Um die Sicherheit im Internet zu gewährleisten, ist die Erstellung von QR-Codes mit folgenden Inhalten streng untersagt:",
    s4Items: [
      {
        title: "Phishing & Schadsoftware ('Quishing')",
        desc: "Zieladressen, die dem Diebstahl von Zugangsdaten, Passwörtern oder Bankdaten dienen, sowie Links, die automatische Malware- oder Ransomware-Downloads auslösen."
      },
      {
        title: "Betrügerische & Illegale Angebote",
        desc: "Seiten mit Schneeballsystemen, Krypto-Betrugsmaschen oder unerlaubten Finanzdienstleistungen."
      },
      {
        title: "Rechtswidrige & Diffamierende Inhalte",
        desc: "Inhalte, die gegen geltendes Recht verstoßen, Hassrede, Terrorismus, Jugendschutzverletzungen oder Urheberrechtsverletzungen darstellen."
      },
      {
        title: "Automatisierter Plattform-Missbrauch",
        desc: "Einsatz von Scraping-Bots oder Denial-of-Service-Angriffen (DDoS) zur absichtlichen Überlastung unserer Server-Infrastruktur."
      }
    ],
    s5Title: "5. Funktionsweise statischer QR-Codes & Lebensdauer",
    s5Lead: "Das Verständnis der technischen Funktionsweise statischer QR-Codes ist entscheidend für den erfolgreichen Einsatz:",
    s5Items: [
      {
        title: "Direkte Matrix-Codierung (Statisch)",
        desc: "GenerateCustomQR erzeugt standardkonforme statische 2D-Barcodes nach ISO/IEC 18004. Die Nutzinformationen (URL, Text, WLAN-Passwort) sind direkt in das Punktmuster eingearbeitet."
      },
      {
        title: "Vollständige Serverunabhängigkeit",
        desc: "Beim Scan kommuniziert das Smartphone direkt mit der Zielseite. Da keine Weiterleitung über unsere Server erfolgt, funktionieren die Codes dauerhaft, selbst wenn unsere Website offline sein sollte."
      },
      {
        title: "Keine nachträgliche Änderbarkeit",
        desc: "Gedruckte statische QR-Codes können nachträglich nicht umgeleitet werden. Ändert sich Ihre Ziel-URL, muss ein neuer Code gedruckt werden. Prüfen Sie URLs vor dem Druck sorgfältig."
      }
    ],
    s6Title: "6. Druckstandards & Richtlinien zur Scanbarkeit",
    s6Lead: "Die Scanbarkeit eines QR-Codes hängt von optischem Kontrast, Druckauflösung und Umgebungslicht ab. Beachten Sie folgende Druckvorgaben:",
    s6Items: [
      {
        title: "Mindestkontrast (≥ 4.5:1)",
        desc: "Gewährleisten Sie stets einen hohen Helligkeitsunterschied zwischen den dunklen Modulen und dem hellen Hintergrund. Vermeiden Sie kontrastarme Farbkombinationen."
      },
      {
        title: "Ruhezone einhalten (4 Module Rand)",
        desc: "Halten Sie an allen vier Seiten einen unbedruckten Rand von mindestens 4 Modulbreiten frei von Grafiken oder Texten."
      },
      {
        title: "Abstandsformel für die Dimensionierung (10:1)",
        desc: "Die Breite des QR-Codes sollte mindestens ein Zehntel des Leseabstands betragen. Für Flyer (20 cm Leseabstand) mindestens 2 cm × 2 cm; für Plakate (2 m Abstand) mindestens 20 cm."
      },
      {
        title: "Logo-Größe im Zentrum begrenzen",
        desc: "Ein zentrales Logo darf maximal 25% bis 30% der Fläche verdecken und erfordert die Fehlerkorrekturstufe 'H' (High) oder 'Q' (Quartile)."
      },
      {
        title: "Exportformate & Vektor-Architektur",
        desc: "Standard-QR-Codes ohne Styling werden als reine mathematische Vektorpfade (<path>) ausgegeben. Individuell gestaltete QR-Codes (mit speziellen Punktmustern, Farbverläufen, Schatten oder Logos) nutzen hochauflösende 300-DPI-Grafikcontainer in SVG und PDF für maximale optische Detailschärfe und zuverlässige Scanbarkeit."
      },
      {
        title: "Verpflichtende Physische Probescans",
        desc: "Der Nutzer trägt die alleinige Verantwortung dafür, vor dem kommerziellen Massendruck physische Probedrucke mit verschiedenen Mobilgeräten (iOS, Android, Standardkameras) unter realen Lichtbedingungen zu testen."
      }
    ],
    s7Title: "7. Druckstandards & Größenmatrix",
    s7Lead: "Orientieren Sie sich an unserer technischen Größentabelle für den professionellen Druck:",
    matrixHeaders: {
      medium: "Anwendungsbereich / Medium",
      minSize: "Empfohlene Mindestgröße",
      distance: "Optimaler Scanabstand",
      format: "Empfohlenes Exportformat",
      tip: "Wichtiger Praxistipp"
    },
    matrixRows: [
      {
        medium: "Visitenkarten (vCard)",
        minSize: "20 mm × 20 mm",
        distance: "15 cm – 30 cm",
        format: "SVG-Vektor / PNG 300 DPI",
        tip: "Verwenden Sie klassische quadratische Punkte für hohe Dichte."
      },
      {
        medium: "Speisekarten & Tischaufsteller",
        minSize: "30 mm × 30 mm",
        distance: "30 cm – 50 cm",
        format: "SVG-Vektor / High-Res PNG",
        tip: "Nutzen Sie matte Laminierung, um Deckenlicht-Reflexionen zu vermeiden."
      },
      {
        medium: "Produktverpackungen & Etiketten",
        minSize: "25 mm × 25 mm",
        distance: "20 cm – 40 cm",
        format: "SVG-Vektor (Beliebig skalierbar)",
        tip: "Achten Sie auf dunklen Schachteln auf eine weiße 4-Modul-Ruhezone."
      },
      {
        medium: "Flyer & Plakate (A4 / A3)",
        minSize: "50 mm × 50 mm",
        distance: "0.5 m – 1.5 m",
        format: "Druckfertiges PDF / SVG",
        tip: "Kombinieren Sie den Code mit einem klaren Call-to-Action-Rahmen."
      },
      {
        medium: "Messewände & Roll-ups",
        minSize: "150 mm × 150 mm",
        distance: "1.5 m – 3.0 m",
        format: "SVG-Vektor (Beliebig skalierbar)",
        tip: "Positionieren Sie den Code auf Augenhöhe (1,3 m – 1,6 m über Boden)."
      },
      {
        medium: "Großflächenplakate & Fassaden",
        minSize: "100 cm × 100 cm",
        distance: "10 m – 15 m",
        format: "SVG-Vektorexport",
        tip: "Wählen Sie Fehlerkorrektur 'H' und maximalen Schwarz-Weiß-Kontrast."
      }
    ],
    s8Title: "8. Haftungsausschluss (Bereitstellung wie gesehen)",
    s8Lead: "GenerateCustomQR wird ohne Mängelgewähr und nach Verfügbarkeit bereitgestellt:",
    s8Items: [
      {
        title: "Ausschluss stillschweigender Gewährleistungen",
        desc: "Soweit gesetzlich zulässig, schließen wir alle ausdrücklichen oder stillschweigenden Gewährleistungen hinsichtlich Marktgängigkeit oder Eignung für einen bestimmten Zweck aus."
      },
      {
        title: "Hardware- und Kamerasensorkompatibilität",
        desc: "Obwohl unsere Codes dem Standard ISO/IEC 18004 entsprechen, können wir nicht garantieren, dass jede veraltete oder beschädigte Handykamera benutzerdefinierte Designs fehlerfrei scannt."
      },
      {
        title: "Verfügbarkeit des Webdienstes",
        desc: "Wir garantieren keine ununterbrochene oder fehlerfreie Verfügbarkeit des Online-Generators zu jeder Zeit."
      }
    ],
    s9Title: "9. Haftungsbeschränkung",
    s9Text: "Soweit gesetzlich zulässig, haften GenerateCustomQR, die Entwickler und Hosting-Provider nicht für direkte, indirekte, Folge- oder Begleitschäden, einschließlich entgangenen Gewinns, Druckkosten für Fehldrucke, Werbeausgaben oder Betriebsunterbrechungen, die aus der Nutzung des Dienstes resultieren.",
    s10Title: "10. Freistellungsverpflichtung",
    s10Text: "Sie verpflichten sich, GenerateCustomQR von allen Ansprüchen Dritter, Schäden und Kosten freizustellen, die aus Ihren QR-Code-Inhalten, hochgeladenen Markenlogos oder einer Verletzung dieser Nutzungsbedingungen entstehen.",
    s11Title: "11. Externe Ziel-Links und fremde Inhalte",
    s11Text: "GenerateCustomQR kontrolliert und billigt keine externen Webseiten, die in Nutzer-QR-Codes verlinkt sind, und übernimmt keine Verantwortung für deren Sicherheit oder Rechtmäßigkeit.",
    s12Title: "12. Änderungen der Plattform und Bedingungen",
    s12Text: "Wir behalten uns das Recht vor, Funktionen und diese Bedingungen jederzeit zu aktualisieren. Die fortgesetzte Nutzung gilt als Annahme der geänderten Bedingungen.",
    s13Title: "13. Anwendbares Recht, Rechtsnachfolge & Kontakt",
    s13Text: "Sollte eine Bestimmung dieser AGB unwirksam oder undurchsetzbar sein, bleibt die Gültigkeit der übrigen Bestimmungen unberührt. Im Falle einer Fusion, Übernahme oder Veräußerung von Vermögenswerten können diese Bedingungen an den Rechtsnachfolger übertragen werden. Für rechtliche Anfragen, Urheberrechtshinweise (DMCA) oder Lizenzierungsfragen wenden Sie sich bitte an legal@generatecustomqr.com oder nutzen Sie unser Kontaktformular unter /contact.",
    faqTitle: "Häufig gestellte Fragen zu Lizenzen und AGB",
    faqs: [
      {
        q: "Darf ich mit GenerateCustomQR erstellte Codes für kommerzielle Kundenaufträge und Produkte nutzen?",
        a: "Ja, absolut. Alle generierten QR-Codes sind zu 100% gebührenfrei für gewerbliche Zwecke nutzbar. Sie besitzen alle Rechte an den Bilddateien."
      },
      {
        q: "Laufen die erstellten QR-Codes nach 30 Tagen oder einem Jahr ab?",
        a: "Nein. Wir erzeugen dauerhafte statische QR-Codes. Da die Daten direkt in die Pixel codiert sind, gibt es kein Ablaufdatum."
      },
      {
        q: "Muss ich ein Wasserzeichen oder einen Link zu Ihrer Website einfügen?",
        a: "Nein. Wir fügen niemals Wasserzeichen oder verpflichtende Quellenangaben in Ihre QR-Codes ein."
      },
      {
        q: "Kann ich das Linkziel eines bereits gedruckten QR-Codes nachträglich ändern?",
        a: "Nein. Bei statischen QR-Codes ist der Link fest im Pixelmuster verankert. Für ein neues Ziel muss ein neuer Code erstellt und gedruckt werden."
      },
      {
        q: "Wer haftet für Druckkosten, falls ein gedrucktes Plakat nicht scannt?",
        a: "Der Nutzer trägt die alleinige Verantwortung für die Durchführung physischer Probedruck-Scans vor der Massenproduktion. GenerateCustomQR haftet nicht für Druckkosten."
      },
      {
        q: "Gibt es ein Limit für die Anzahl der Scans?",
        a: "Nein. Da die Codes statisch sind und nicht über unsere Server laufen, haben Sie unbegrenzte Scans auf Lebenszeit."
      }
    ],
    ctaTitle: "Bereit für Ihren druckfertigen QR-Code?",
    ctaDesc: "Erstellen Sie professionelle, kontrastreiche QR-Codes mit unserem 100% kostenlosen Online-Studio.",
    ctaBtn: "QR-Code Generator starten"
  }
};

const pageMeta = metaMap[locale] || metaMap.en;

const breadcrumbs = [
  { name: t(locale, 'nav.generator'), url: getLocalizedUrl(locale, '/') },
  { name: t(locale, 'footer.terms'), url: getLocalizedUrl(locale, '/terms') }
];
---
<LegalLayout
  locale={locale}
  title={pageMeta.title}
  description={pageMeta.desc}
  keywords={pageMeta.keywords}
  breadcrumbs={breadcrumbs}
  heading={pageMeta.heading}
  badge={pageMeta.badge}
  lastUpdated={pageMeta.lastUpdated}
  icon="gavel"
  faqs={pageMeta.faqs}
>
  <!-- Summary Highlights Grid -->
  <div class="legal-highlight-grid not-prose">
    {pageMeta.highlights.map((item) => (
      <div class="legal-highlight-card">
        <div class="legal-card-icon">
          <span class="material-symbols-outlined text-xl">{item.icon}</span>
        </div>
        <h4>{item.title}</h4>
        <p>{item.desc}</p>
      </div>
    ))}
  </div>

  <!-- Table of Contents -->
  <nav class="legal-toc-card not-prose" aria-label="Table of Contents">
    <div class="legal-toc-title">
      <span class="material-symbols-outlined text-primary text-xl">list_alt</span>
      <span>{pageMeta.tocTitle}</span>
    </div>
    <ul class="legal-toc-list">
      {pageMeta.toc.map((item) => (
        <li>
          <a href={`#${item.id}`} class="legal-toc-link">
            <span class="legal-toc-number">•</span>
            <span>{item.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Section 1 -->
  <h2 id="section-1">{pageMeta.s1Title}</h2>
  <p>{pageMeta.s1P1}</p>
  <p>{pageMeta.s1P2}</p>

  <div class="legal-callout legal-callout-success">
    <p><strong>{pageMeta.badge}</strong>: {pageMeta.s1P1}</p>
  </div>

  <!-- Section 2 -->
  <h2 id="section-2">{pageMeta.s2Title}</h2>
  <p>{pageMeta.s2Lead}</p>
  <ul>
    {pageMeta.s2Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 3 -->
  <h2 id="section-3">{pageMeta.s3Title}</h2>
  <p>{pageMeta.s3Lead}</p>
  <ul>
    {pageMeta.s3Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 4 -->
  <h2 id="section-4">{pageMeta.s4Title}</h2>
  <p>{pageMeta.s4Lead}</p>
  <ul>
    {pageMeta.s4Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 5 -->
  <h2 id="section-5">{pageMeta.s5Title}</h2>
  <p>{pageMeta.s5Lead}</p>
  <ul>
    {pageMeta.s5Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 6 -->
  <h2 id="section-6">{pageMeta.s6Title}</h2>
  <p>{pageMeta.s6Lead}</p>
  <ul>
    {pageMeta.s6Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <div class="legal-callout legal-callout-warning">
    <p><strong>Pre-Press Verification Requirement:</strong> Always test-scan your physical printed proofs with at least 2 different smartphone models prior to initiating mass commercial printing.</p>
  </div>

  <!-- Section 7: Print Sizing Matrix -->
  <h2 id="section-7">{pageMeta.s7Title}</h2>
  <p>{pageMeta.s7Lead}</p>

  <div class="legal-table-container">
    <table class="legal-table">
      <thead>
        <tr>
          <th>{pageMeta.matrixHeaders.medium}</th>
          <th>{pageMeta.matrixHeaders.minSize}</th>
          <th>{pageMeta.matrixHeaders.distance}</th>
          <th>{pageMeta.matrixHeaders.format}</th>
          <th>{pageMeta.matrixHeaders.tip}</th>
        </tr>
      </thead>
      <tbody>
        {pageMeta.matrixRows.map((row) => (
          <tr>
            <td><strong>{row.medium}</strong></td>
            <td><span class="legal-badge legal-badge-info">{row.minSize}</span></td>
            <td>{row.distance}</td>
            <td><span class="legal-badge legal-badge-success">{row.format}</span></td>
            <td>{row.tip}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Section 8 -->
  <h2 id="section-8">{pageMeta.s8Title}</h2>
  <p>{pageMeta.s8Lead}</p>
  <ul>
    {pageMeta.s8Items.map((item) => (
      <li>
        <strong>{item.title}:</strong> {item.desc}
      </li>
    ))}
  </ul>

  <!-- Section 9 -->
  <h2 id="section-9">{pageMeta.s9Title}</h2>
  <p>{pageMeta.s9Text}</p>

  <!-- Section 10 -->
  <h2 id="section-10">{pageMeta.s10Title}</h2>
  <p>{pageMeta.s10Text}</p>

  <!-- Section 11 -->
  <h2 id="section-11">{pageMeta.s11Title}</h2>
  <p>{pageMeta.s11Text}</p>

  <!-- Section 12 -->
  <h2 id="section-12">{pageMeta.s12Title}</h2>
  <p>{pageMeta.s12Text}</p>

  <!-- Section 13 -->
  <h2 id="section-13">{pageMeta.s13Title}</h2>
  <p>{pageMeta.s13Text}</p>

  <!-- FAQs Section -->
  <h2 id="terms-faqs">{pageMeta.faqTitle}</h2>
  <div class="legal-faq-section not-prose">
    {pageMeta.faqs.map((faq) => (
      <details class="legal-faq-item">
        <summary class="legal-faq-summary">
          <span>{faq.q}</span>
          <span class="material-symbols-outlined legal-faq-chevron">expand_more</span>
        </summary>
        <div class="legal-faq-content">
          <p>{faq.a}</p>
        </div>
      </details>
    ))}
  </div>

  <!-- Bottom CTA Card -->
  <div class="legal-cta-card not-prose">
    <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center">
      <span class="material-symbols-outlined text-2xl">qr_code_2</span>
    </div>
    <h3>{pageMeta.ctaTitle}</h3>
    <p>{pageMeta.ctaDesc}</p>
    <a href={getLocalizedUrl(locale, '/')} class="legal-btn-primary">
      <span class="material-symbols-outlined text-lg">rocket_launch</span>
      <span>{pageMeta.ctaBtn}</span>
    </a>
  </div>
</LegalLayout>

