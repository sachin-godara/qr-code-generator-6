      "121 modelos profissionais prontos",
      "46 ícones de marcas populares",
      "Upload de logo com respiro de fundo",
      "Downloads em PNG, SVG e PDF 300 DPI",
      "Fundo transparente suportado",
      "Degradês de cores personalizados",
      "Efeitos de sombra 3D e brilho neon",
      "Sem necessidade de fornecer e-mail",
      "Direito de uso comercial e pessoal"
    ],
    faqsTitle: "Dúvidas Frequentes",
    faqs: [
      { q: "O gerador é realmente gratuito para sempre?", a: "Sim! Você tem acesso irrestrito a todos os recursos de customização, logos e vetores sem pagar nada." },
      { q: "Os QR codes gerados expiram?", a: "Não. Nossos QR codes são estáticos e funcionam para sempre sem limites de leituras." },
      { q: "Posso utilizar comercialmente?", a: "Sim, os códigos são 100% livres para uso em marcas, embalagens e campanhas comerciais." },
      { q: "O download em SVG e PDF é gratuito?", a: "Sim, todos os formatos de alta resolução estão disponíveis gratuitamente." }
    ],
    otherToolsTitle: "Conheça Nossas Ferramentas QR Gratuitas",
    ctaTitle: "Pronto para Criar seu QR Code Grátis?",
    ctaDesc: "Gere códigos QR personalizados em alta resolução com logotipo e cores em segundos.",
    ctaBtn: "Criar QR Code Grátis Agora ↑"
  },
  de: {
    title: "100% Kostenloser QR-Code Generator — Ohne Anmeldung & Wasserzeichen",
    desc: "Erstellen Sie unbegrenzt individuelle QR-Codes kostenlos. Ohne Registrierung, ohne Ablaufdatum und ohne Wasserzeichen. PNG, SVG und PDF Downloads.",
    keywords: "kostenloser qr code generator, qr code ersteller ohne wasserzeichen, qr code generator ohne anmeldung, gratis qr-codes erstellen, qr code generator ohne abofalle",
    badge: "Dauerhaft 100% Kostenlos",
    compTitle: "Vergleich mit kostenpflichtigen Anbietern",
    compSub: "Sehen Sie, warum Kreative und Unternehmen auf GenerateCustomQR setzen.",
    compHeaders: { feature: "Funktion", us: "GenerateCustomQR", others: "Andere Generatoren" },
    compRows: [
      { feat: "Preis", us: "100% Kostenlos", others: "5 € – 50 € / Monat" },
      { feat: "Anmeldung nötig", us: "Nein", others: "Meist erforderlich" },
      { feat: "Wasserzeichen", us: "Keine", others: "In der Gratis-Version" },
      { feat: "Punktstile", us: "40+", others: "8–15" },
      { feat: "Textrahmen", us: "51", others: "3–10" },
      { feat: "Vektor-SVG & PDF", us: "Kostenlos inklusive", others: "Nur im Abo" },
      { feat: "Gültigkeitsdauer", us: "Dauerhaft (Statisch)", others: "Kann ablaufen" }
    ],
    perksTitle: "Alles, was Sie kostenlos erhalten",
    perks: [
      "40+ einzigartige Punktmuster",
      "28 Eckenrahmen & Mittelpunkte",
      "51 dekorative Text- und Aktionsrahmen",
      "121 fertige Design-Vorlagen",
      "46 vordefinierte Marken-Icons",
      "Eigenes Logo mit automatischem Schutzrand",
      "Export als PNG, Vektor-SVG und 300 DPI PDF",
      "Transparenter Hintergrund unterstützt",
      "Lineare und radiale Farbverläufe",
      "3D-Schatten und Neon-Glow Effekte",
      "Keine Datenspeicherung oder E-Mail-Pflicht",
      "Freigabe für kommerzielle Nutzung"
    ],
    faqsTitle: "Häufige Fragen",
    faqs: [
      { q: "Ist das Angebot wirklich 100% kostenlos?", a: "Ja — alle Funktionen stehen Ihnen uneingeschränkt und dauerhaft gratis zur Verfügung." },
      { q: "Haben die QR-Codes ein Verfallsdatum?", a: "Nein. Alle erzeugten Codes sind statisch im Bild codiert und laufen niemals ab." },
      { q: "Darf ich die Codes kommerziell nutzen?", a: "Ja, alle QR-Codes dürfen frei für geschäftliche Zwecke und Verpackungen eingesetzt werden." },
      { q: "Ist der Vektor-Download in SVG kostenlos?", a: "Ja, SVG und 300 DPI PDF sind ohne Einschränkungen kostenlos downloadbar." }
    ],
    otherToolsTitle: "Weitere kostenlose QR-Code Tools",
    ctaTitle: "Bereit für Ihren kostenlosen QR-Code?",
    ctaDesc: "Erstellen Sie individuelle QR-Codes mit Logo und Rahmen in wenigen Sekunden.",
    ctaBtn: "Jetzt kostenlosen QR-Code erstellen ↑"
  },
  tr: {
    title: "%100 Ücretsiz QR Kod Oluşturucu — Kayıtsız & Filigransız",
    desc: "Sınırsız özel QR kodlarını ücretsiz oluşturun. Kayıt yok, süre sonu yok ve filigran yok. PNG, SVG ve PDF indirmeleri dahil.",
    keywords: "ucretsiz qr kod olusturucu, filigransiz qr kod yapma, kayitsiz qr kod olusturma, bedava qr kod olusturucu, aboneliksiz qr kod",
    badge: "Sonsuza Kadar %100 Ücretsiz",
    compTitle: "Ücretli QR Oluşturucularla Karşılaştırma",
    compSub: "Tasarımcıların ve işletmelerin neden GenerateCustomQR'ı tercih ettiğini görün.",
    compHeaders: { feature: "Özellik", us: "GenerateCustomQR", others: "Diğer Oluşturucular" },
    compRows: [
      { feat: "Fiyat", us: "%100 Ücretsiz", others: "5 $ – 50 $ / ay" },
      { feat: "Kayıt Zorunluluğu", us: "Yok", others: "Genellikle Zorunlu" },
      { feat: "Filigran", us: "Yok", others: "Ücretsiz planda var" },
      { feat: "Nokta Stilleri", us: "40+", others: "8–15" },
      { feat: "Metin Çerçeveleri", us: "51", others: "3–10" },
      { feat: "Vektör SVG & PDF", us: "Ücretsiz Dahil", others: "Yalnızca Ücretli Plan" },
      { feat: "Geçerlilik Süresi", us: "Süresiz (Statik)", others: "Süresi dolabilir" }
    ],
    perksTitle: "Ücretsiz Olarak Sahip Olduğunuz Her Şey",
    perks: [
      "40+ benzersiz matris nokta deseni",
      "28 göz çerçevesi ve göz bebeği stili",
      "51 dekoratif metin çerçevesi",
      "121 hazır tasarım şablonu",
      "46 hazır marka simgesi",
      "Otomatik arka plan korumalı özel logo yükleme",
      "PNG, Vektör SVG ve 300 DPI PDF dışa aktarma",
      "Şeffaf arka plan desteği",
      "Doğrusal ve radyal renk degradeleri",
      "3D gölge ve neon ışıma efektleri",
      "Veri depolama veya e-posta zorunluluğu yok",
      "Kişisel ve ticari kullanım için serbest"
    ],
    faqsTitle: "Sıkça Sorulan Sorular",
    faqs: [
      { q: "Gerçekten sonsuza kadar ücretsiz mi?", a: "Evet — tüm özelleştirme özellikleri, logolar ve vektör indirmeleri tamamen ücretsizdir." },
      { q: "QR kodlarının süresi dolar mı?", a: "Hayır. Kodlarımız statik olarak doğrudan görüntüye yazılır ve sonsuza kadar çalışır." },
      { q: "Ticari amaçla kullanabilir miyim?", a: "Evet, tüm QR kodları ticari markalarda, ambalajlarda ve pazarlamada serbestçe kullanılabilir." },
      { q: "SVG ve PDF indirmeleri ücretsiz mi?", a: "Evet, tüm yüksek çözünürlüklü ve vektörel formatlar tamamen ücretsizdir." }
    ],
    otherToolsTitle: "Diğer Ücretsiz QR Kod Araçlarımız",
    ctaTitle: "Ücretsiz QR Kodunuzu Oluşturmaya Hazır mısınız?",
    ctaDesc: "Logo ve çerçevelerle saniyeler içinde yüksek çözünürlüklü özel QR kodları oluşturun.",
    ctaBtn: "Hemen Ücretsiz QR Kod Oluştur ↑"
  }
};

const pageMeta = metaMap[locale] || metaMap.en;

const breadcrumbs = [
  { name: t(locale, 'nav.generator'), url: getLocalizedUrl(locale, '/') },
  { name: t(locale, 'footer.freeQR'), url: getLocalizedUrl(locale, '/free-qr-code-generator') }
];

const relatedTools = [
  { icon: "link", title: t(locale, 'footer.urlQR'), desc: t(locale, 'landing.formats.items.urlDesc'), url: getLocalizedUrl(locale, '/url-qr-code-generator') },
  { icon: "wifi", title: t(locale, 'footer.wifiQR'), desc: t(locale, 'landing.formats.items.wifiDesc'), url: getLocalizedUrl(locale, '/wifi-qr-code') },
  { icon: "contact_page", title: t(locale, 'footer.vcardQR'), desc: t(locale, 'landing.formats.items.vcardDesc'), url: getLocalizedUrl(locale, '/vcard-qr-code') },
  { icon: "image", title: t(locale, 'footer.logoQR'), desc: t(locale, 'landing.features.card2Title'), url: getLocalizedUrl(locale, '/qr-code-with-logo') },
  { icon: "event", title: t(locale, 'footer.eventQR'), desc: t(locale, 'landing.formats.items.eventDesc'), url: getLocalizedUrl(locale, '/event-qr-code') },
  { icon: "qr_code_scanner", title: t(locale, 'footer.scanner'), desc: t(locale, 'scanner.formats.urlsDesc'), url: getLocalizedUrl(locale, '/qr-code-scanner') }
];

const howTo = {
  name: pageMeta.title,
  description: pageMeta.desc,
  steps: [
    { name: t(locale, 'landing.howTo.step1Title') || "1. Enter Content", text: t(locale, 'landing.howTo.step1Desc') || "Select your content type (URL, Text, WiFi, vCard, Email, etc.) and enter your data." },
    { name: t(locale, 'landing.howTo.step2Title') || "2. Customize Design", text: t(locale, 'landing.howTo.step2Desc') || "Choose from 39 dot styles, custom corner eyes, and brand colors or gradients." },
    { name: t(locale, 'landing.howTo.step3Title') || "3. Add Logo & CTA Frame", text: t(locale, 'landing.howTo.step3Desc') || "Upload your brand logo and select a stylish 'Scan Me' text frame." },
    { name: t(locale, 'landing.howTo.step4Title') || "4. Free Instant Download", text: t(locale, 'landing.howTo.step4Desc') || "Export in high-resolution PNG, vector SVG, or 300 DPI PDF without signup." }
  ]
};

const faqs = pageMeta.faqs;
---
<BaseLayout
  locale={locale}
  title={pageMeta.title}
  description={pageMeta.desc}
  keywords={pageMeta.keywords}
  breadcrumbs={breadcrumbs}
  howTo={howTo}
  faqs={faqs}
>
  <style is:global>
    @import '../styles/global.css';
  </style>

  <main id="generator">
    <QRGeneratorApp client:load locale={locale} />
  </main>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-16 text-on-surface" id="about">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-primary bg-primary/10 px-3.5 py-1.5 rounded-full">{pageMeta.badge}</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-on-surface tracking-tight">{pageMeta.title}</h1>
      <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed max-w-2xl mx-auto">
        {pageMeta.desc}
      </p>
    </div>

    <!-- Comparison Table -->
    <section class="space-y-6">
      <div class="text-center space-y-1">
        <h2 class="text-2xl font-bold text-on-surface">{pageMeta.compTitle}</h2>
        <p class="text-xs sm:text-sm text-on-surface-variant max-w-xl mx-auto">{pageMeta.compSub}</p>
      </div>
      
      <div class="overflow-x-auto rounded-2xl border border-outline-variant/60 shadow-xs bg-surface-container-lowest">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="bg-surface-container-low border-b border-outline-variant/60">
              <th class="text-left py-3.5 px-4 font-bold text-on-surface">{pageMeta.compHeaders.feature}</th>
              <th class="text-center py-3.5 px-4 font-bold text-emerald-700 bg-emerald-50/50">{pageMeta.compHeaders.us}</th>
              <th class="text-center py-3.5 px-4 font-bold text-on-surface-variant">{pageMeta.compHeaders.others}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-outline-variant/40">
            {pageMeta.compRows.map((row) => (
              <tr class="hover:bg-zinc-50/50 transition-colors">
                <td class="py-3 px-4 font-medium text-on-surface">{row.feat}</td>
                <td class="text-center py-3 px-4 font-bold text-emerald-600 bg-emerald-50/30">{row.us}</td>
                <td class="text-center py-3 px-4 text-on-surface-variant">{row.others}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 12 Perks Checklist -->
    <section class="border-t border-zinc-200/60 pt-12 space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.perksTitle}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 max-w-4xl mx-auto">
        {pageMeta.perks.map((p) => (
          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant/60 hover:border-primary/30 transition-all">
            <span class="material-symbols-outlined text-emerald-600 text-lg shrink-0">check_circle</span>
            <span class="text-xs sm:text-sm text-on-surface font-medium">{p}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Explore Other Tools Ribbon -->
    <section class="border-t border-zinc-200/60 pt-12 space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.otherToolsTitle}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {relatedTools.map((tool) => (
          <a
            href={tool.url}
            class="p-3.5 rounded-xl bg-surface-container-lowest border border-outline-variant/60 hover:border-primary/40 hover:-translate-y-1 hover:shadow-xs transition-all text-center group flex flex-col items-center justify-between"
          >
            <div class="w-8 h-8 rounded-lg bg-zinc-100 group-hover:bg-primary group-hover:text-white flex items-center justify-center transition-colors mb-2">
              <span class="material-symbols-outlined text-lg">{tool.icon}</span>
            </div>
            <span class="font-bold text-xs text-on-surface group-hover:text-primary transition-colors block">{tool.title}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs Accordion -->
    <section class="border-t border-zinc-200/60 pt-12 space-y-6">
      <h2 class="text-2xl font-bold text-center text-on-surface">{pageMeta.faqsTitle}</h2>
      <div class="space-y-3 max-w-3xl mx-auto">
        {pageMeta.faqs.map((faq) => (
          <details class="group border border-outline-variant/60 rounded-2xl bg-surface-container-lowest overflow-hidden shadow-xs transition-all">
            <summary class="flex justify-between items-center p-4.5 cursor-pointer font-bold text-sm sm:text-base hover:bg-surface-container-low transition-colors select-none text-on-surface">
              <span>{faq.q}</span>
              <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-on-surface-variant">expand_more</span>
            </summary>
            <p class="px-4.5 pb-4.5 pt-1 text-on-surface-variant text-xs sm:text-sm leading-relaxed border-t border-outline-variant/30">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="rounded-3xl bg-linear-to-br from-zinc-900 to-zinc-950 text-white p-8 sm:p-12 text-center space-y-4 shadow-lg border border-zinc-800">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">{pageMeta.ctaTitle}</h2>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-lg mx-auto leading-relaxed">{pageMeta.ctaDesc}</p>
      <div class="pt-2">
        <button
          onclick="document.getElementById('generator')?.scrollIntoView({ behavior: 'smooth' });"
          class="px-6 py-3 rounded-full bg-white text-zinc-900 font-extrabold text-xs sm:text-sm hover:bg-zinc-100 hover:scale-105 transition-all shadow-md cursor-pointer"
        >
          {pageMeta.ctaBtn}
        </button>
      </div>
    </section>

  </div>

  <Footer locale={locale} />
</BaseLayout>
