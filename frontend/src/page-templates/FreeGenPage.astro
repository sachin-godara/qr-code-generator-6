---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRGeneratorApp from '../react/QRGeneratorApp';
import Footer from '../components/layout/Footer.astro';
import { type Locale } from '../i18n/config';
import { getLocalizedUrl, t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const metaMap: Record<Locale, {
  title: string;
  desc: string;
  badge: string;
  compTitle: string;
  compSub: string;
  compHeaders: { feature: string; us: string; others: string };
  compRows: Array<{ feat: string; us: string; others: string }>;
  perksTitle: string;
  perks: string[];
  faqsTitle: string;
  faqs: Array<{ q: string; a: string }>;
  keywords?: string;
}> = {
  en: {
    title: "100% Free QR Code Generator — No Signup & No Watermark",
    desc: "Generate unlimited custom QR codes for free with no account, no expiration, and no watermarks. Full access to 40+ dot styles, logos, frames, and 8K downloads.",
