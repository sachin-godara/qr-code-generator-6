      { q: "Is it really 100% free with no hidden charges?", a: "Yes — every feature is completely free with no strings attached. No signup required, no watermarks, no usage limits, and no premium paywalls." },
      { q: "Do the QR codes expire?", a: "No. The QR codes you create are static — the data is encoded directly into the image matrix. They will work forever without expiration." },
      { q: "Can I use generated QR codes for commercial projects?", a: "Yes. You have full commercial ownership and rights to print or distribute all generated QR codes anywhere." },
      { q: "Are vector SVG and print PDF downloads free?", a: "Yes. High-resolution PNG up to 8K, vector SVG, and 300 DPI PDF are completely free for all users." }
    ],
    otherToolsTitle: "Explore Our Free QR Code Tools",
    ctaTitle: "Ready to Create Your Free QR Code?",
    ctaDesc: "Generate unlimited, high-resolution custom QR codes with logos, frames, and colors in seconds.",
    ctaBtn: "Create Free QR Code Now ↑"
  },
  es: {
    title: "Generador de Códigos QR 100% Gratis — Sin Registro ni Marcas",
    desc: "Genera códigos QR personalizados ilimitados gratis, sin registro, sin caducidad y sin marcas de agua. 40+ estilos de puntos, logos y descargas en 8K.",
    keywords: "generador de codigos qr gratis, crear qr gratis sin marca de agua, creador de codigos qr gratis sin registro, generador qr ilimitado, codigo qr sin suscripcion",
    badge: "100% Gratis para Siempre",
    compTitle: "Comparativa con Servicios de Pago",
    compSub: "Descubre por qué miles de usuarios eligen GenerateCustomQR.",
    compHeaders: { feature: "Característica", us: "GenerateCustomQR", others: "Otros Generadores" },
    compRows: [
      { feat: "Precio", us: "100% Gratis", others: "$5–$50 / mes" },
      { feat: "Requiere Registro", us: "No", others: "Casi siempre sí" },
      { feat: "Marcas de Agua", us: "Ninguna", others: "En versión gratis" },
      { feat: "Estilos de Puntos", us: "40+", others: "8–15" },
      { feat: "Marcos con Texto", us: "51", others: "3–10" },
      { feat: "Exportación SVG y PDF", us: "Gratis Incluido", others: "Solo de pago" },
      { feat: "Caducidad de Escaneos", us: "Nunca (Estáticos)", others: "Pueden caducar" }
    ],
    perksTitle: "Todo lo que Obtienes Gratis",
    perks: [
      "40+ estilos de puntos únicos",
      "28 marcos de esquinas y centros",
      "51 marcos con texto para llamada a la acción",
      "121 plantillas prediseñadas",
      "46 iconos de marcas reconocidas",
      "Subida de logo propio con respiro automático",
      "Exportación en PNG, SVG y PDF",
      "Soporte para fondo transparente",
      "Degradados lineales y radiales",
      "Efectos de sombra 3D y brillo neón",
      "Sin registro ni recopilación de emails",
      "Derechos de uso comercial y personal"
    ],
    faqsTitle: "Preguntas Frecuentes",
    faqs: [
      { q: "¿Es realmente 100% gratis sin cobros ocultos?", a: "¡Sí! Todas las herramientas son completamente gratuitas sin suscripciones, sin marcas de agua y sin límites de descarga." },
      { q: "¿Los códigos QR caducan?", a: "No. Todos los códigos son estáticos con datos grabados de forma permanente en la matriz." },
      { q: "¿Puedo usarlos en proyectos comerciales?", a: "Sí, todos los códigos generados cuentan con derechos de uso comercial ilimitado." },
      { q: "¿La descarga vectorial en SVG es gratuita?", a: "Sí, las descargas en SVG vectorial y PDF a 300 DPI están incluidas de forma gratuita." }
    ],
    otherToolsTitle: "Explora Nuestras Herramientas QR Gratuitas",
    ctaTitle: "¿Listo para Crear tu Código QR Gratis?",
    ctaDesc: "Crea códigos QR ilimitados con estilos personalizados, logotipo y vectores en segundos.",
    ctaBtn: "Crear Código QR Gratis Ahora ↑"
  },
  pt: {
    title: "Gerador de QR Code 100% Grátis — Sem Cadastro e Sem Marca d'Água",
    desc: "Gere códigos QR personalizados ilimitados gratuitamente, sem expiração e sem marcas. 40+ estilos de pontos, logos, molduras e exportação em 8K.",
    keywords: "gerador de qr code gratis, criar qr code gratuito sem marca d'agua, gerador qr code sem cadastro, qr code gratis para sempre, criar qr code sem pagar",
    badge: "100% Grátis para Sempre",
    compTitle: "Comparativo com Serviços Pagos",
    compSub: "Entenda por que empresas e profissionais migram para o GenerateCustomQR.",
    compHeaders: { feature: "Recurso", us: "GenerateCustomQR", others: "Outros Geradores" },
    compRows: [
      { feat: "Preço", us: "100% Grátis", others: "R$ 30–250 / mês" },
      { feat: "Exige Cadastro", us: "Não", others: "Geralmente sim" },
      { feat: "Marcas d'Água", us: "Nenhuma", others: "Na versão grátis" },
      { feat: "Estilos de Pontos", us: "40+", others: "8–15" },
      { feat: "Molduras com Texto", us: "51", others: "3–10" },
      { feat: "Vetor SVG e PDF", us: "Grátis Incluído", others: "Apenas planos pagos" },
      { feat: "Validade do Código", us: "Eterno (Estático)", others: "Pode expirar" }
    ],
    perksTitle: "Tudo Incluído Gratuitamente",
    perks: [
