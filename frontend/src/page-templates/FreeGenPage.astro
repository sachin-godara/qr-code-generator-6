    compTitle: "How We Compare to Paid Services",
    compSub: "See why creators and businesses switch to GenerateCustomQR.",
    compHeaders: { feature: "Feature", us: "GenerateCustomQR", others: "Other Generators" },
    compRows: [
      { feat: "Price", us: "100% Free", others: "$5–$50 / month" },
      { feat: "Signup Required", us: "No", others: "Usually required" },
      { feat: "Watermarks", us: "None", others: "On free tier" },
      { feat: "Dot Styles", us: "40+", others: "8–15" },
      { feat: "Text Frames", us: "51", others: "3–10" },
      { feat: "Vector SVG & PDF", us: "Free Included", others: "Paid only" },
      { feat: "Scan Expiration", us: "Never (Static)", others: "May expire" }
    ],
    perksTitle: "Everything You Get for Free",
    perks: [
      "40+ unique dot module styles",
      "28 eye frames + custom eyeballs",
      "51 decorative text & CTA frames",
      "121 ready-made templates",
      "46 preset brand logo icons",
      "Custom logo upload + auto clearance",
      "PNG, SVG, and 300 DPI PDF export",
      "Transparent background support",
      "Linear & radial color gradients",
      "3D shadow and neon glow effects",
      "No account or email registration",
      "Commercial & personal use rights"
    ],
    faqsTitle: "Free QR Code Generator FAQ",
