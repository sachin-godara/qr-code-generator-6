---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { type Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  keywords?: string;
  breadcrumbs: { name: string; url: string }[];
  heading: string;
  badge?: string;
  lastUpdated?: string;
  icon?: string;
  faqs?: { q: string; a: string }[];
}

const { locale, title, description, keywords, breadcrumbs, heading, badge, lastUpdated, icon, faqs } = Astro.props;
---
<BaseLayout
  locale={locale}
  title={title}
  description={description}
  keywords={keywords}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/legal.css';
  </style>

  <div class="min-h-screen flex flex-col bg-surface">
    <Header locale={locale} />

    <!-- Main Content Area -->
    <main class="flex-grow">
      
      <!-- Page Header -->
      <header class="bg-surface-container py-12 md:py-16 border-b border-outline-variant/50">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
          {badge && (
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-bold uppercase tracking-wider mb-4">
              <span class="material-symbols-outlined text-sm">verified_user</span>
              <span>{badge}</span>
            </div>
          )}
          {icon && (
            <div class="w-16 h-16 mx-auto bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-6 shadow-xs">
              <span class="material-symbols-outlined text-3xl">{icon}</span>
            </div>
          )}
          <h1 class="text-3xl md:text-5xl font-black text-on-surface tracking-tight mb-4">{heading}</h1>
          {lastUpdated && (
            <p class="text-sm font-medium text-on-surface-variant flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-base">update</span>
              <span>{lastUpdated}</span>
            </p>
          )}
        </div>
      </header>

      <!-- Prose Content -->
      <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16 legal-prose">
        <slot />
      </article>

    </main>

    <Footer locale={locale} />
  </div>
</BaseLayout>

