---
import SEOHead from '../components/SEOHead.astro';
import { localeConfig, type Locale } from '../i18n/config';
import { getLocaleFromUrl } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  keywords?: string;
  pageType?: 'generator' | 'scanner' | 'article' | 'website';
  googleSiteVerification?: string;
  breadcrumbs?: { name: string; url: string }[];
  howTo?: {
    name: string;
    description: string;
    steps: { name: string; text: string }[];
  };
  faqs?: { q: string; a: string }[];
}

const currentLocale = (Astro.props.locale || getLocaleFromUrl(Astro.url)) as Locale;
const currentLocaleInfo = localeConfig[currentLocale] || localeConfig.en;

const {
  title = 'GenerateCustomQR — Free Custom QR Code Generator',
  description = 'Create stunning custom QR codes with 39 dot styles, 51 text frames, 121 Templates, and logo embedding. Download in PNG, SVG, or PDF — 100% free, no signup.',
  ogImage = '/og-image.png',
  canonicalUrl,
  keywords = 'QR code generator, custom QR code, QR code maker, free QR code, QR code with logo, QR code design, wifi QR code, vcard QR code, batch QR generator',
  pageType,
  googleSiteVerification,
  breadcrumbs,
  howTo,
  faqs,
} = Astro.props;
---
<!doctype html>
<html lang={currentLocale} dir={currentLocaleInfo.dir}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SW78MHH9B2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-SW78MHH9B2');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=5" />
    
    <!-- Security Headers -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000 https://qr-code-generator-6-shry.onrender.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com https://api.web3forms.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Permissions-Policy" content="camera=(self), microphone=(), geolocation=(), payment=()" />
    <meta http-equiv="Strict-Transport-Security" content="max-age=31536000; includeSubDomains" />


    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="msapplication-TileImage" content="/mstile-150x150.png" />
    <meta name="msapplication-TileColor" content="#863bff" />
    <meta name="apple-mobile-web-app-title" content="My QR" />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />
    
    <!-- Mobile Native Experience -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191c1e" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="GenerateCustomQR" />
    <meta name="application-name" content="GenerateCustomQR" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    
    <!-- SEO Head -->
    <SEOHead
      locale={currentLocale}
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={canonicalUrl}
      keywords={keywords}
      pageType={pageType}
      googleSiteVerification={googleSiteVerification}
      breadcrumbs={breadcrumbs}
      howTo={howTo}
      faqs={faqs}
    />
    
    <!-- RSS Feed Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="GenerateCustomQR Blog" href="/rss.xml" />

    <!-- Global Styles & Self-Hosted Fonts -->
    <script>
      // Force scroll to top on page refresh
      if (history.scrollRestoration) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
