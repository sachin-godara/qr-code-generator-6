---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const relatedPosts = sortedPosts
  .filter(p => p.id !== post.id)
  .slice(0, 3);

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog" },
  { name: post.data.title.length > 40 ? post.data.title.substring(0, 40) + '…' : post.data.title, url: `/blog/${post.id}` }
];

const categoryLabels: Record<string, { label: string; icon: string }> = {
  'guides': { label: 'Guide', icon: 'menu_book' },
  'use-cases': { label: 'Use Case', icon: 'cases' },
  'design-tips': { label: 'Design Tips', icon: 'palette' },
  'industry': { label: 'Industry', icon: 'business' },
  'comparisons': { label: 'Comparison', icon: 'compare' },
  'news': { label: 'News', icon: 'newspaper' },
};

const cat = categoryLabels[post.data.category] || { label: post.data.category, icon: 'article' };

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Article structured data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": post.data.author || "GenerateCustomQR Team",
    "url": "https://generatecustomqr.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "GenerateCustomQR",
    "url": "https://generatecustomqr.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://generatecustomqr.com/favicon-96x96.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://generatecustomqr.com/blog/${post.id}`
  }
};
---
<BaseLayout
  title={`${post.data.title} | GenerateCustomQR Blog`}
  description={post.data.description}
  keywords={post.data.keywords}
  breadcrumbs={breadcrumbs}
>
  <style is:global>
    @import '../../styles/global.css';
    @import '../../styles/blog.css';
  </style>

  <!-- Article Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="min-h-screen flex flex-col bg-surface">
    <Header />

    <!-- Reading Progress Bar -->
    <div class="reading-progress" id="reading-progress" style="width: 0%"></div>

    <main class="flex-grow">

      <!-- ═══ ARTICLE HEADER ═══ -->
      <header class="blog-hero py-12 md:py-20 border-b border-outline-variant/50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center blog-reveal">
          <!-- Category + Reading Time -->
          <div class="flex items-center justify-center gap-3 mb-6">
            <span class="category-badge" data-cat={post.data.category}>
              <span class="material-symbols-outlined text-[12px]">{cat.icon}</span>
              {cat.label}
            </span>
            {post.data.readingTime && (
              <span class="text-xs font-medium text-on-surface-variant flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">schedule</span>
                {post.data.readingTime} min read
              </span>
            )}
          </div>

          <!-- Title -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-on-surface tracking-tight mb-6 leading-[1.15]">
            {post.data.title}
          </h1>

          <!-- Description -->
          <p class="text-on-surface-variant text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
            {post.data.description}
          </p>

          <!-- Meta Info -->
          <div class="flex items-center justify-center gap-4 text-sm text-on-surface-variant">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-zinc-900 text-white flex items-center justify-center text-xs font-bold">
                GQ
              </div>
              <span class="font-medium">{post.data.author}</span>
            </div>
            <span class="text-outline-variant">·</span>
            <time datetime={post.data.pubDate.toISOString()} class="font-medium">
              {formatDate(post.data.pubDate)}
            </time>
          </div>
        </div>
      </header>

      <!-- ═══ ARTICLE BODY ═══ -->
      <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14 blog-reveal">
        <div class="blog-prose">
          <Content />
        </div>
      </article>

      <!-- ═══ IN-ARTICLE CONVERSION CTA BOX ═══ -->
      <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-10 blog-reveal">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary/10 via-surface-container to-surface-container-high border border-primary/20 p-6 sm:p-8 shadow-xs text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="space-y-2 max-w-lg">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/15 text-primary text-xs font-bold uppercase tracking-wider">
              <span class="material-symbols-outlined text-[14px]">auto_awesome</span> Free Design Studio
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-on-surface tracking-tight">Ready to Create Your Custom QR Code?</h3>
            <p class="text-sm text-on-surface-variant leading-relaxed">
              Design and download pixel-perfect QR codes with custom logos, 40+ dot styles, and color gradients. 100% free with no watermarks or signup required.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto shrink-0">
            <a
              href="/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-zinc-900 text-white font-bold text-sm shadow-md hover:bg-zinc-800 transition-all hover:scale-[1.02]"
            >
              <span>Create Free QR Code</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        </div>
      </section>

      <!-- ═══ AUTHOR BOX ═══ -->
      <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-12 blog-reveal">
        <div class="bg-surface-container rounded-2xl border border-outline-variant/60 p-6 sm:p-8 flex flex-col sm:flex-row items-start gap-5">
          <div class="w-14 h-14 rounded-2xl bg-zinc-900 text-white flex items-center justify-center text-xl font-bold flex-shrink-0">
            GQ
          </div>
          <div class="space-y-2">
            <p class="font-bold text-on-surface">{post.data.author}</p>
            <p class="text-sm text-on-surface-variant leading-relaxed">
              The GenerateCustomQR team builds free, privacy-first QR code tools used by creators, designers, and businesses worldwide. We write about QR code best practices, design tips, and real-world use cases.
            </p>
            <a href="/about" class="text-sm font-semibold text-on-surface hover:text-zinc-600 transition-colors flex items-center gap-1 mt-1">
              Learn more about us
              <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
        </div>
      </section>

      <!-- ═══ RELATED POSTS ═══ -->
      {relatedPosts.length > 0 && (
        <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 border-t border-outline-variant/50 blog-reveal">
          <div class="flex items-center gap-3 mb-8">
            <div class="w-10 h-10 rounded-xl bg-surface-container text-on-surface-variant flex items-center justify-center border border-outline-variant/40">
              <span class="material-symbols-outlined text-xl">auto_awesome</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-on-surface tracking-tight">Keep Reading</h2>
              <p class="text-xs text-on-surface-variant font-medium">More articles you might enjoy</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedPosts.map((related) => {
              const rCat = categoryLabels[related.data.category] || { label: related.data.category, icon: 'article' };
              return (
                <a
                  href={`/blog/${related.id}`}
                  class="blog-card group block bg-surface-container-lowest rounded-2xl border border-outline-variant/60 overflow-hidden shadow-xs"
                >
                  <div class="h-28 bg-gradient-to-br from-zinc-100 via-zinc-50 to-white relative overflow-hidden">
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="material-symbols-outlined text-4xl text-zinc-200 group-hover:text-zinc-300 transition-colors">description</span>
                    </div>
                    <div class="absolute top-3 left-3">
                      <span class="category-badge" data-cat={related.data.category}>
                        <span class="material-symbols-outlined text-[11px]">{rCat.icon}</span>
                        {rCat.label}
                      </span>
                    </div>
                  </div>
                  <div class="p-4 space-y-2">
                    <h3 class="text-sm font-bold text-on-surface leading-snug group-hover:text-zinc-600 transition-colors line-clamp-2">
                      {related.data.title}
                    </h3>
                    <div class="flex items-center justify-between">
                      <time class="text-xs text-on-surface-variant" datetime={related.data.pubDate.toISOString()}>
                        {formatDate(related.data.pubDate)}
                      </time>
                      <span class="material-symbols-outlined text-[14px] text-on-surface-variant group-hover:translate-x-0.5 transition-transform">
                        arrow_forward
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <!-- ═══ BACK TO BLOG CTA ═══ -->
      <div class="max-w-3xl mx-auto px-4 sm:px-6 pb-16 text-center blog-reveal">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-on-surface-variant hover:text-on-surface transition-colors">
          <span class="material-symbols-outlined text-[16px]">arrow_back</span>
          Back to all articles
        </a>
      </div>

    </main>

    <Footer />
  </div>

  <script>
    // Reading progress bar
    const progressBar = document.getElementById('reading-progress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = window.scrollY;
        const progress = Math.min((scrolled / docHeight) * 100, 100);
        progressBar.style.width = progress + '%';
      }, { passive: true });
    }

    // Scroll reveal animation
    const revealEls = document.querySelectorAll('.blog-reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
    revealEls.forEach(el => observer.observe(el));
  </script>
</BaseLayout>
