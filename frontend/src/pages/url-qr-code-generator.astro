---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRGeneratorApp from '../react/QRGeneratorApp';
import Footer from '../components/layout/Footer.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "URL QR Code Generator", url: "/url-qr-code-generator" }
];

const howTo = {
  name: "How to Convert a Website Link (URL) to a Custom QR Code",
  description: "Create a free, fully customized URL QR code with custom colors, brand logos, and action frames in seconds.",
  steps: [
    { name: "Paste Your URL", text: "Copy your website, landing page, social profile, or web link into the URL input field." },
    { name: "Customize the Design", text: "Choose from 40+ dot patterns, 42 eye frames, and brand color gradients to match your site aesthetics." },
    { name: "Add Your Brand Logo", text: "Upload your company logo or choose from 35+ preset brand icons with automatic contrast padding." },
    { name: "Select an Action Frame", text: "Wrap your code in a text frame with custom call-to-action text like 'SCAN TO VISIT' or 'VIEW WEBSITE'." },
    { name: "Download High-Res Files", text: "Export your URL QR code in vector SVG, print-ready PDF, or HD PNG (up to 8K) — 100% free with no watermarks." }
  ]
};

const faqs = [
  { q: "Do URL QR codes generated here ever expire?", a: "No! All URL QR codes generated on GenerateCustomQR are static and permanent. The website link is encoded directly into the QR code matrix, meaning it will work forever without relying on any external redirection server or subscription." },
  { q: "Can I add Google Analytics UTM parameters to my URL?", a: "Yes! You can append standard UTM parameters (e.g. ?utm_source=qr&utm_medium=print&utm_campaign=summer_sale) directly to your URL before encoding. This allows you to track all QR code visits inside Google Analytics or any analytics platform." },
  { q: "Should I use HTTP or HTTPS in my URL QR code?", a: "We strongly recommend using full HTTPS links (e.g., https://yourwebsite.com). Modern iOS and Android camera apps automatically display a safe, clickable browser notification when detecting secure HTTPS URLs." },
  { q: "What happens if I need to change my website URL later?", a: "Static QR codes encode the exact web address directly into the data matrix. To update the destination, you can set up a 301 redirect on your server from the original URL to your new web address, ensuring old printed codes continue to work." },
  { q: "Is it completely free to download in SVG or PDF vector formats?", a: "Yes — SVG vector files and high-resolution PDF print files are 100% free with zero watermarks or signup requirements." }
];
---
<BaseLayout
  title="URL to QR Code Generator — Convert Links to QR Code Free | GenerateCustomQR"
  description="Convert any website link or URL to a custom QR code for free. Add your logo, pick from 40+ dot styles, custom colors, and action frames. Free PNG, SVG, and PDF downloads with zero watermarks."
  keywords="url to qr code, website link qr code generator, convert link to qr code, url qr code maker, website link qr code, url qr code generator free, link to qr"
  breadcrumbs={breadcrumbs}
  howTo={howTo}
  faqs={faqs}
>
  <style is:global>
    @import '../styles/global.css';
  </style>

  <main id="generator">
    <QRGeneratorApp client:load />
  </main>

  <!-- SEO Content Section -->
  <section class="max-w-4xl mx-auto px-6 py-16 text-on-surface" id="about">
    <div class="text-center mb-12">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-primary bg-primary/10 px-3 py-1 rounded-full mb-3">#1 URL QR Solution</span>
      <h1 class="text-3xl sm:text-5xl font-bold mb-4">URL to QR Code Generator — Convert Website Links Free</h1>
      <p class="text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        Turn any website address, blog post, online menu, landing page, or web link into a high-resolution, custom-branded QR code in seconds. Completely free with zero watermarks and no signup required.
      </p>
    </div>

    <!-- Feature Grid for URL QR Codes -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <div class="p-6 bg-surface-container-low rounded-2xl border border-outline-variant/60">
        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
          <span class="material-symbols-outlined text-2xl">link</span>
        </div>
        <h3 class="font-bold text-lg mb-2">Universal Link Support</h3>
        <p class="text-sm text-on-surface-variant leading-relaxed">Works with any web address: HTTPS sites, YouTube videos, Google Docs, Notion pages, and social profiles.</p>
      </div>
      <div class="p-6 bg-surface-container-low rounded-2xl border border-outline-variant/60">
        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
          <span class="material-symbols-outlined text-2xl">verified</span>
        </div>
        <h3 class="font-bold text-lg mb-2">Permanent & Non-Expiring</h3>
        <p class="text-sm text-on-surface-variant leading-relaxed">Static link encoding means your QR code works forever. No monthly fees, no redirection middleman, no expiration.</p>
      </div>
      <div class="p-6 bg-surface-container-low rounded-2xl border border-outline-variant/60">
        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
          <span class="material-symbols-outlined text-2xl">high_quality</span>
        </div>
        <h3 class="font-bold text-lg mb-2">Vector & 8K Exports</h3>
        <p class="text-sm text-on-surface-variant leading-relaxed">Download infinite-scale SVG vector files for billboards or 8K PNGs for crisp print brochures and business cards.</p>
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="border-t border-outline-variant pt-12 mb-16">
      <h2 class="text-2xl font-bold mb-6 text-center">URL QR Code Feature Comparison</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse max-w-2xl mx-auto">
          <thead>
            <tr class="border-b border-outline-variant">
              <th class="text-left py-3 px-4 font-semibold">Capability</th>
              <th class="text-center py-3 px-4 font-semibold text-primary">GenerateCustomQR</th>
              <th class="text-center py-3 px-4 font-semibold text-on-surface-variant">Other Generators</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">Link Expiry</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">Never Expire</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">14-day trial limit</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">UTM Campaign Tracking</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">Full Support</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">Paid tiers only</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">SVG Vector Export</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">100% Free</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">$10–$40/month</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">Custom Logo Overlay</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">Free + 35 Presets</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">Watermarked</td>
            </tr>
            <tr>
              <td class="py-2.5 px-4">Call-to-Action Frames</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">51 Styles</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">Limited 2–5</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Best Practices Section -->
    <div class="bg-surface-container-low rounded-3xl p-8 sm:p-10 border border-outline-variant/60 mb-16">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary text-3xl">task_alt</span>
        Best Practices for Website URL QR Codes
      </h2>
      <ul class="space-y-4 text-sm text-on-surface-variant leading-relaxed">
        <li class="flex items-start gap-3">
          <span class="material-symbols-outlined text-green-600 text-lg shrink-0 mt-0.5">check_circle</span>
          <div><strong class="text-on-surface">Use Mobile-Optimized Pages:</strong> Always ensure the destination URL points to a responsive, fast-loading mobile page, as 99% of QR codes are scanned on smartphones.</div>
        </li>
        <li class="flex items-start gap-3">
          <span class="material-symbols-outlined text-green-600 text-lg shrink-0 mt-0.5">check_circle</span>
          <div><strong class="text-on-surface">Add Campaign UTM Tags:</strong> Append UTM parameters to your URL (e.g. <code class="bg-surface-container px-1.5 py-0.5 rounded text-xs">?utm_source=flyer&utm_medium=qr</code>) so you can track exact scan traffic in Google Analytics.</div>
        </li>
        <li class="flex items-start gap-3">
          <span class="material-symbols-outlined text-green-600 text-lg shrink-0 mt-0.5">check_circle</span>
          <div><strong class="text-on-surface">Add a Clear Call-to-Action Frame:</strong> Placing an action frame with text like "SCAN TO VISIT WEBSITE" or "TAP TO ORDER" increases scan conversion rates by up to 35%.</div>
        </li>
        <li class="flex items-start gap-3">
          <span class="material-symbols-outlined text-green-600 text-lg shrink-0 mt-0.5">check_circle</span>
          <div><strong class="text-on-surface">Keep High Contrast:</strong> Ensure dark foreground dots over a light background (minimum 4.5:1 contrast ratio) for rapid camera detection.</div>
        </li>
      </ul>
    </div>

    <!-- FAQ Accordion -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group bg-surface-container-low rounded-2xl border border-outline-variant/60 p-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-on-surface cursor-pointer list-none">
              <span>{faq.q}</span>
              <span class="material-symbols-outlined transition-transform duration-300 group-open:rotate-180 text-primary">expand_more</span>
            </summary>
            <p class="mt-3 text-sm text-on-surface-variant leading-relaxed">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
