---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRGeneratorApp from '../react/QRGeneratorApp';
import Footer from '../components/layout/Footer.astro';
---
<BaseLayout
  title="QR Code Maker — Free Custom QR Code Generator | 40+ Styles, Logo, Batch"
  description="Create stunning custom QR codes with 40+ dot styles, 51 text frames, 48 templates, and logo embedding. The best free QR code creator to make a QR code online."
  keywords="QR code generator, custom QR code, QR code maker, QR code creator, make a QR code, free QR code, QR code with logo, QR code design, wifi QR code, vcard QR code, batch QR generator"
>
  <!-- Import global styles -->
  <style is:global>
    @import '../styles/global.css';
  </style>

  <!-- 
    The entire QR Generator app loads as a React "client island".
    client:load = hydrates immediately on page load (needed for interactive tool).
  -->
  <main id="generator">
    <QRGeneratorApp client:load />
  </main>

  <!-- 
    ======================================================
    EPIC SHOWCASE SECTION (BELOW GENERATOR)
    ======================================================
  -->

  <!-- 1. HERO STATS BAR -->
  <section class="border-y border-outline-variant/50 bg-surface-container-lowest/80 backdrop-blur-md py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 rounded-2xl bg-surface/50 border border-outline-variant/30 hover:border-primary/30 transition-all">
          <span class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight block">40+</span>
          <span class="text-xs sm:text-sm font-semibold text-on-surface-variant mt-1 block">Matrix Dot Styles</span>
        </div>
        <div class="p-4 rounded-2xl bg-surface/50 border border-outline-variant/30 hover:border-primary/30 transition-all">
          <span class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight block">51</span>
          <span class="text-xs sm:text-sm font-semibold text-on-surface-variant mt-1 block">Custom Text Frames</span>
        </div>
        <div class="p-4 rounded-2xl bg-surface/50 border border-outline-variant/30 hover:border-primary/30 transition-all">
          <span class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight block">48</span>
          <span class="text-xs sm:text-sm font-semibold text-on-surface-variant mt-1 block">One-Click Presets</span>
        </div>
        <div class="p-4 rounded-2xl bg-surface/50 border border-outline-variant/30 hover:border-primary/30 transition-all">
          <span class="text-3xl sm:text-4xl font-extrabold text-emerald-600 tracking-tight block">100%</span>
          <span class="text-xs sm:text-sm font-semibold text-on-surface-variant mt-1 block">Free · No Signup</span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-24">

    <!-- 2. FEATURE HIGHLIGHTS GRID -->
    <section id="features" class="space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-wider">
          Why Choose QRStream
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-on-surface tracking-tight">
          Everything You Need to Build <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-hover">Award-Winning QR Codes</span>
        </h2>
        <p class="text-base text-on-surface-variant leading-relaxed">
          Unmatched design freedom meets enterprise-grade engine capabilities. Create scannable, visually striking codes in seconds.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {/* Card 1 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-violet-50 text-violet-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">palette</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">40+ Matrix Dot Styles</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            From classic squares and smooth circles to diamonds, stars, lotus, sparkles, and fluid waves — customize every module pattern.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Circles</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Stars</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Gradients</span>
          </div>
        </div>

        {/* Card 2 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-pink-50 text-pink-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">image</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">Smart Logo Embedding</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Upload your custom brand logo or pick from 30+ preset icons (Instagram, WhatsApp, WiFi). Includes auto background padding & dot clearance.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">PNG / SVG</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Auto Clear</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">30+ Icons</span>
          </div>
        </div>

        {/* Card 3 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">download</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">High-Res PNG, SVG & PDF</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Export pixel-perfect PNGs up to 8192px, infinitely scalable SVG vectors for billboards, or print-ready 300 DPI PDFs — all free.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Up to 8K</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">SVG Vector</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">300 DPI PDF</span>
          </div>
        </div>

        {/* Card 4 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">crop_free</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">51 Decorative Frames</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Wrap your QR code in eye-catching text callouts, speech bubbles, ribbon banners, coffee cups, or ticket stubs with custom label text.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Custom Text</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">51 Shapes</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Call to Action</span>
          </div>
        </div>

        {/* Card 5 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">style</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">48 Ready Presets</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            One-click designer presets for business cards, WiFi stickers, restaurant menus, social media, events, and retail packaging.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Business</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Social</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">WiFi</span>
          </div>
        </div>

        {/* Card 6 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">dataset</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">Batch CSV Generator</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Upload a CSV file to generate up to 500 custom QR codes in a single ZIP file. Map custom data and filenames effortlessly.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">CSV Upload</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">ZIP Export</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Up to 500</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. INTERACTIVE 12 CONTENT TYPES SHOWCASE -->
    <section id="content-types" class="space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-wider">
          Supported Formats
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-on-surface tracking-tight">
          Encode Anything Into a Scannable QR Code
        </h2>
        <p class="text-base text-on-surface-variant leading-relaxed">
          From simple website URLs to digital business cards, encrypted WiFi credentials, and crypto payments.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {[
          { id: "url", icon: "link", title: "Website URL", desc: "Direct visitors to any web link" },
          { id: "wifi", icon: "wifi", title: "WiFi Credentials", desc: "Auto-connect without typing passwords" },
          { id: "vcard", icon: "contact_page", title: "vCard Contact", desc: "Digital business card saved to contacts" },
          { id: "email", icon: "mail", title: "Email Message", desc: "Pre-fill recipient, subject & body" },
          { id: "sms", icon: "sms", title: "SMS Message", desc: "Send SMS with pre-written text" },
          { id: "phone", icon: "call", title: "Phone Call", desc: "Dial a phone number directly" },
          { id: "event", icon: "event", title: "Calendar Event", desc: "Add event to Google/Apple Calendar" },
          { id: "text", icon: "subject", title: "Plain Text", desc: "Display raw text or notes on scan" },
          { id: "location", icon: "location_on", title: "Maps Location", desc: "Open Google Maps or coordinates" },
          { id: "crypto", icon: "currency_bitcoin", title: "Crypto Wallet", desc: "Bitcoin, Ethereum, USDT transfers" },
          { id: "paypal", icon: "payments", title: "PayPal Link", desc: "Receive payments or donations" },
          { id: "appstore", icon: "apps", title: "App Store", desc: "Redirect to iOS or Android apps" },
        ].map(item => (
          <button
            type="button"
            onclick={`window.dispatchEvent(new CustomEvent('select-qr-content-type', { detail: { type: '${item.id}' } }))`}
            class="p-4 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 shadow-2xs hover:border-primary/50 hover:shadow-md transition-all group flex flex-col justify-between text-left cursor-pointer"
          >
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
                <span class="material-symbols-outlined text-xl">{item.icon}</span>
              </div>
              <h3 class="text-sm font-bold text-on-surface group-hover:text-primary transition-colors">{item.title}</h3>
              <p class="text-xs text-on-surface-variant leading-relaxed">{item.desc}</p>
            </div>
            <div class="pt-3 flex items-center gap-1 text-[11px] font-bold text-primary opacity-0 group-hover:opacity-100 transition-opacity">
              <span>Create Now</span>
              <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </div>
          </button>
        ))}
      </div>
    </section>

    <!-- 4. FAQ ACCORDION -->
    <section id="faq" class="space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-wider">
          Got Questions?
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-on-surface tracking-tight">
          Frequently Asked Questions
        </h2>
      </div>

      <div class="space-y-4 max-w-3xl mx-auto">
        <details class="group border border-outline-variant/60 rounded-2xl bg-surface-container-lowest overflow-hidden shadow-2xs">
          <summary class="flex justify-between items-center p-5 min-h-[56px] cursor-pointer font-bold text-on-surface hover:bg-surface-container-low transition-colors select-none">
            Is QRStream completely free to use?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-on-surface-variant text-sm sm:text-base leading-relaxed border-t border-outline-variant/30 space-y-2">
            <p>Yes, 100% free! There are no hidden fees, no subscriptions, no watermarks, and no registration required.</p>
            <p>You can create unlimited QR codes and export high-resolution PNG, SVG, or PDF files with complete commercial rights.</p>
          </div>
        </details>

        <details class="group border border-outline-variant/60 rounded-2xl bg-surface-container-lowest overflow-hidden shadow-2xs">
          <summary class="flex justify-between items-center p-5 min-h-[56px] cursor-pointer font-bold text-on-surface hover:bg-surface-container-low transition-colors select-none">
            Can I add a logo to my QR code without breaking scan ability?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-on-surface-variant text-sm sm:text-base leading-relaxed border-t border-outline-variant/30">
            Yes! QRStream automatically switches error correction to <strong>Level H (High)</strong> when you add a logo. Level H allows up to 30% of the QR data to be covered while remaining 100% scannable by any smartphone camera.
          </div>
        </details>

        <details class="group border border-outline-variant/60 rounded-2xl bg-surface-container-lowest overflow-hidden shadow-2xs">
          <summary class="flex justify-between items-center p-5 min-h-[56px] cursor-pointer font-bold text-on-surface hover:bg-surface-container-low transition-colors select-none">
            What download formats are supported?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-on-surface-variant text-sm sm:text-base leading-relaxed border-t border-outline-variant/30">
            We support 3 formats:
            <ul class="list-disc list-inside mt-2 space-y-1">
              <li><strong>PNG:</strong> Custom resolution up to 8192 × 8192 pixels.</li>
              <li><strong>SVG:</strong> Vector format with infinite scaling for billboards & print graphics.</li>
              <li><strong>PDF:</strong> Print-ready document formatted at 300 DPI.</li>
            </ul>
          </div>
        </details>

        <details class="group border border-outline-variant/60 rounded-2xl bg-surface-container-lowest overflow-hidden shadow-2xs">
          <summary class="flex justify-between items-center p-5 min-h-[56px] cursor-pointer font-bold text-on-surface hover:bg-surface-container-low transition-colors select-none">
            How does the Batch CSV generation work?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-on-surface-variant text-sm sm:text-base leading-relaxed border-t border-outline-variant/30">
            Select "Batch Generator" in the navigation or select "Batch CSV" under Content. Upload a CSV file with your URLs or data. Map the CSV columns to data and filename fields, apply your design settings, and download all generated QR codes as a single ZIP file!
          </div>
        </details>

        <details class="group border border-outline-variant/60 rounded-2xl bg-surface-container-lowest overflow-hidden shadow-2xs">
          <summary class="flex justify-between items-center p-5 min-h-[56px] cursor-pointer font-bold text-on-surface hover:bg-surface-container-low transition-colors select-none">
            Are my generated QR codes stored on your servers?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-on-surface-variant text-sm sm:text-base leading-relaxed border-t border-outline-variant/30">
            No! QRStream is completely stateless and privacy-first. We do not store your QR content, personal data, or generated images on any database. Everything is rendered on the fly directly to your browser.
          </div>
        </details>
      </div>
    </section>

    <!-- 5. EPIC CTA BANNER -->
    <section class="rounded-3xl bg-gradient-to-br from-zinc-950 via-zinc-900 to-zinc-800 text-white p-8 sm:p-12 shadow-2xl relative overflow-hidden text-center space-y-6">
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto space-y-4">
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight">
          Ready to Create Your Custom QR Code?
        </h2>
        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed">
          No sign-up required. Choose from 40+ dot styles, embed your logo, add frames, and download high-res PNG or SVG vectors instantly.
        </p>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#generator"
            class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold bg-white text-zinc-900 hover:bg-zinc-100 transition-all shadow-lg hover:scale-105 active:scale-95 flex items-center justify-center gap-2 text-base"
          >
            <span class="material-symbols-outlined text-xl text-primary">qr_code_2</span>
            <span>Create QR Code Now</span>
          </a>
          <a
            href="/how-to-use"
            class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-all hover:scale-105 active:scale-95 flex items-center justify-center gap-2 text-base backdrop-blur-md"
          >
            <span class="material-symbols-outlined text-xl">help_outline</span>
            <span>How to Use Guide</span>
          </a>
        </div>
      </div>
    </section>

  </div>

  <Footer />
</BaseLayout>
