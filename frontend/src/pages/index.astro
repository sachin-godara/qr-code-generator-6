---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRGeneratorApp from '../react/QRGeneratorApp';
import Footer from '../components/layout/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 3);

const breadcrumbs = [
  { name: "Home", url: "/" }
];

const howTo = {
  name: "How to Create a Custom QR Code",
  description: "Design and generate a fully customized QR code with logo, colors, gradients, and frames in under 2 minutes — 100% free.",
  steps: [
    { name: "Enter your content", text: "Choose a content type (URL, text, WiFi, vCard, email, SMS, event, etc.) and enter the data you want to encode." },
    { name: "Customize the design", text: "Choose from 40+ dot styles, 19 eye frames, 23 eyeball patterns, and apply color gradients to create a unique look." },
    { name: "Add a logo", text: "Upload your own logo or choose from 46 preset brand icons with automatic background removal and dot clearance control." },
    { name: "Pick a frame", text: "Wrap your QR code in one of 51 decorative text frames with custom CTA text, fonts, and colors." },
    { name: "Download for free", text: "Export your QR code in PNG (up to 4096px), SVG (vector), or PDF (300 DPI) — completely free, no watermark, no signup." }
  ]
};

const faqs = [
  { q: "How do I create a custom QR code?", a: "Enter your URL, text, or contact information, choose from 39 dot styles and 28 eye patterns, customize colors and gradients, add a logo from 46 Presets or upload your own, pick a decorative frame, and download your QR code in PNG, SVG, or PDF format — completely free." },
  { q: "Is the QR code generator free?", a: "Yes, GenerateCustomQR is 100% free with all features unlocked — no signup, no watermarks, no usage limits. You get full access to 40+ dot styles, 51 text frames, 121 templates, logo embedding, batch generation, and PNG/SVG/PDF export at no cost." },
  { q: "What types of QR codes can I create?", a: "You can create QR codes for 12 different content types: URLs, plain text, WiFi credentials, vCards (contact cards), emails, SMS messages, calendar events, phone numbers, cryptocurrency addresses, Google Maps locations, PayPal payment links, and App Store links." },
  { q: "Can I add a logo to my QR code?", a: "Yes, you can upload your own logo or choose from 46 preset brand icons including Instagram, WhatsApp, YouTube, Facebook, and more. Features include automatic background removal, adjustable dot clearance around the logo, multiple card shapes, and brand or custom color modes." },
  { q: "What download formats are available?", a: "You can download QR codes in three formats: PNG (up to 4096×4096 pixels for print), SVG (infinitely scalable vector for designers), and PDF (300 DPI print-ready). All formats are free with no watermarks. You can also copy the QR code directly to your clipboard." },
  { q: "Can I generate QR codes in bulk?", a: "Yes, GenerateCustomQR supports batch generation of up to 500 QR codes at once. Upload a CSV file with your data, map the columns, choose your design settings, and download all QR codes as a ZIP file in PNG, SVG, or PDF format." },
  { q: "Do QR codes created here expire?", a: "No! All QR codes generated on GenerateCustomQR are static and permanent. The data is encoded directly into the QR code image, so it works forever without any server, subscription, or tracking dependency." }
];
---
<BaseLayout
  title="Free Custom QR Code Generator with Logo — No Watermark"
  description="Create custom QR codes 100% free with logo embedding, 40+ dot styles, and color gradients. Download in vector SVG, PDF, or high-res PNG with no watermark."
  keywords="qr code generator, custom qr code with logo, free qr code generator no watermark, qr code maker without signup, aesthetic qr code generator, printable qr code high resolution, bulk qr code generator, create qr code online, qr code generator online, custom qr code design, qr code maker online free, qr code png download, qr code svg download"
  breadcrumbs={breadcrumbs}
  howTo={howTo}
  faqs={faqs}
>
  <!-- Import global styles -->
  <style is:global>
    @import '../styles/global.css';
  </style>

  <!-- 
    The entire QR Generator app loads as a React "client island".
    client:load = hydrates immediately on page load (needed for interactive tool).
  -->
  <main id="generator">
    <h1 class="sr-only">Free Custom QR Code Generator with Logo &amp; 40+ Styles — No Watermark</h1>
    <QRGeneratorApp client:load />
  </main>

  <!-- 
    ======================================================
    EPIC SHOWCASE SECTION (BELOW GENERATOR)
    ======================================================
  -->

  <!-- 1. HERO STATS BAR -->
  <section class="border-y border-outline-variant/50 bg-surface-container-lowest/80 backdrop-blur-md py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 rounded-2xl bg-surface/50 border border-outline-variant/30 hover:border-primary/30 transition-all">
          <span class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight block">39</span>
          <span class="text-xs sm:text-sm font-semibold text-on-surface-variant mt-1 block">Matrix Dot Styles</span>
        </div>
        <div class="p-4 rounded-2xl bg-surface/50 border border-outline-variant/30 hover:border-primary/30 transition-all">
          <span class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight block">51</span>
          <span class="text-xs sm:text-sm font-semibold text-on-surface-variant mt-1 block">Custom Text Frames</span>
        </div>
        <div class="p-4 rounded-2xl bg-surface/50 border border-outline-variant/30 hover:border-primary/30 transition-all">
          <span class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight block">121</span>
          <span class="text-xs sm:text-sm font-semibold text-on-surface-variant mt-1 block">One-Click Presets</span>
        </div>
        <div class="p-4 rounded-2xl bg-surface/50 border border-outline-variant/30 hover:border-primary/30 transition-all">
          <span class="text-3xl sm:text-4xl font-extrabold text-emerald-600 tracking-tight block">100%</span>
          <span class="text-xs sm:text-sm font-semibold text-on-surface-variant mt-1 block">Free · No Signup</span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-24">

    <!-- 1.5 TRUST & E-E-A-T CREDIBILITY BAR -->
    <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="space-y-1">
        <div class="flex items-center justify-center gap-1 text-amber-500 font-black text-lg">
          <span>★ 4.9 / 5</span>
        </div>
        <p class="text-xs text-on-surface-variant font-medium">Rated by 2,840+ Creators</p>
      </div>
      <div class="space-y-1">
        <a
          href="https://www.iso.org/standard/62021.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-on-surface font-bold text-base flex items-center justify-center gap-1 hover:text-primary transition-colors"
          title="ISO/IEC 18004 International QR Code Specification"
        >
          <span class="material-symbols-outlined text-primary text-xl" aria-hidden="true">verified</span>
          <span>ISO/IEC 18004</span>
        </a>
        <p class="text-xs text-on-surface-variant font-medium">Standard QR Compliance</p>
      </div>
      <div class="space-y-1">
        <div class="text-on-surface font-bold text-base flex items-center justify-center gap-1">
          <span class="material-symbols-outlined text-emerald-600 text-xl" aria-hidden="true">lock</span>
          <span>100% Private</span>
        </div>
        <p class="text-xs text-on-surface-variant font-medium">Zero Server Data Storage</p>
      </div>
      <div class="space-y-1">
        <div class="text-on-surface font-bold text-base flex items-center justify-center gap-1">
          <span class="material-symbols-outlined text-indigo-600 text-xl" aria-hidden="true">workspace_premium</span>
          <span>Commercial Free</span>
        </div>
        <p class="text-xs text-on-surface-variant font-medium">No Watermarks or Subscriptions</p>
      </div>
    </div>

    <!-- 2. FEATURE HIGHLIGHTS GRID -->
    <section id="features" class="space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-wider">
          Why Choose GenerateCustomQR
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-on-surface tracking-tight">
          Everything You Need to Build <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-hover">Award-Winning QR Codes</span>
        </h2>
        <p class="text-base text-on-surface-variant leading-relaxed">
          Unmatched design freedom meets enterprise-grade engine capabilities. Create scannable, visually striking codes in seconds.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {/* Card 1 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-violet-50 text-violet-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">palette</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">39 Matrix Dot Styles</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            From classic squares and smooth circles to diamonds, stars, lotus, sparkles, and fluid waves — customize every module pattern.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Circles</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Stars</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Gradients</span>
          </div>
        </div>

        {/* Card 2 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-pink-50 text-pink-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">image</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">Smart Logo Embedding</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Upload your custom brand logo or pick from 46 preset icons (Instagram, WhatsApp, WiFi). Includes auto background padding & dot clearance.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">PNG / SVG</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Auto Clear</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">46 Icons</span>
          </div>
        </div>

        {/* Card 3 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">download</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">High-Res PNG, SVG & PDF</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Export pixel-perfect PNGs up to 8192px, infinitely scalable SVG vectors for billboards, or print-ready 300 DPI PDFs — all free.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Up to 8K</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">SVG Vector</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">300 DPI PDF</span>
          </div>
        </div>

        {/* Card 4 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">crop_free</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">51 Decorative Frames</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Wrap your QR code in eye-catching text callouts, speech bubbles, ribbon banners, coffee cups, or ticket stubs with custom label text.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Custom Text</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">51 Shapes</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Call to Action</span>
          </div>
        </div>

        {/* Card 5 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">style</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">121 Ready Presets</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            One-click designer presets for business cards, WiFi stickers, restaurant menus, social media, events, and retail packaging.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Business</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Social</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">WiFi</span>
          </div>
        </div>

        {/* Card 6 */}
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm hover-lift space-y-4 group">
          <div class="w-12 h-12 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">dataset</span>
          </div>
          <h3 class="text-lg font-bold text-on-surface">Batch CSV Generator</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Upload a CSV file to generate up to 500 custom QR codes in a single ZIP file. Map custom data and filenames effortlessly.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">CSV Upload</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">ZIP Export</span>
            <span class="px-2.5 py-0.5 rounded-md bg-surface text-[11px] font-medium text-on-surface-variant border border-outline-variant/40">Up to 500</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. INTERACTIVE 12 CONTENT TYPES SHOWCASE -->
    <section id="content-types" class="space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-wider">
          Supported Formats
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-on-surface tracking-tight">
          Encode Anything Into a Scannable QR Code
        </h2>
        <p class="text-base text-on-surface-variant leading-relaxed">
          From simple website URLs to digital business cards, encrypted WiFi credentials, and crypto payments.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {[
          { id: "url", icon: "link", title: "Website URL", desc: "Direct visitors to any web link", label: "Make URL QR" },
          { id: "wifi", icon: "wifi", title: "WiFi Credentials", desc: "Auto-connect without typing passwords", label: "Make WiFi QR" },
          { id: "vcard", icon: "contact_page", title: "vCard Contact", desc: "Digital business card saved to contacts", label: "Make vCard QR" },
          { id: "email", icon: "mail", title: "Email Message", desc: "Pre-fill recipient, subject & body", label: "Make Email QR" },
          { id: "sms", icon: "sms", title: "SMS Message", desc: "Send SMS with pre-written text", label: "Make SMS QR" },
          { id: "phone", icon: "call", title: "Phone Call", desc: "Dial a phone number directly", label: "Make Phone QR" },
          { id: "event", icon: "event", title: "Calendar Event", desc: "Add event to Google/Apple Calendar", label: "Make Event QR" },
          { id: "text", icon: "subject", title: "Plain Text", desc: "Display raw text or notes on scan", label: "Make Text QR" },
          { id: "location", icon: "location_on", title: "Maps Location", desc: "Open Google Maps or coordinates", label: "Make Maps QR" },
          { id: "crypto", icon: "currency_bitcoin", title: "Crypto Wallet", desc: "Bitcoin, Ethereum, USDT transfers", label: "Make Crypto QR" },
          { id: "paypal", icon: "payments", title: "PayPal Link", desc: "Receive payments or donations", label: "Make PayPal QR" },
          { id: "appstore", icon: "apps", title: "App Store", desc: "Redirect to iOS or Android apps", label: "Make App QR" },
        ].map(item => (
          <button
            type="button"
            onclick={`window.dispatchEvent(new CustomEvent('select-qr-content-type', { detail: { type: '${item.id}' } }))`}
            class="p-4 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 shadow-2xs hover:border-primary/50 hover:shadow-md transition-all group flex flex-col justify-between text-left cursor-pointer"
          >
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
                <span class="material-symbols-outlined text-xl" aria-hidden="true">{item.icon}</span>
              </div>
              <span class="text-sm font-bold text-on-surface group-hover:text-primary transition-colors block">{item.title}</span>
              <p class="text-xs text-on-surface-variant leading-relaxed">{item.desc}</p>
            </div>
            <div class="pt-3 flex items-center gap-1 text-[11px] font-bold text-primary opacity-0 group-hover:opacity-100 transition-opacity">
              <span>{item.label}</span>
              <span class="material-symbols-outlined text-xs" aria-hidden="true">arrow_forward</span>
            </div>
          </button>
        ))}
      </div>
    </section>

    <!-- 4. STEP-BY-STEP HOW IT WORKS GUIDE -->
    <section id="how-it-works" class="space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-wider">
          Simple Workflow
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-on-surface tracking-tight">
          How to Create a Custom QR Code in 4 Steps
        </h2>
        <p class="text-base text-on-surface-variant leading-relaxed">
          Follow our intuitive design pipeline to produce print-ready, scannable QR codes in under 60 seconds.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm space-y-4 relative">
          <div class="w-10 h-10 rounded-xl bg-primary text-white font-black text-lg flex items-center justify-center shadow-md shadow-primary/20">
            1
          </div>
          <h3 class="text-lg font-bold text-on-surface">Select Content Type</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Choose your payload: website URL, guest WiFi, digital vCard contact, email draft, phone number, or event calendar invite.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm space-y-4 relative">
          <div class="w-10 h-10 rounded-xl bg-primary text-white font-black text-lg flex items-center justify-center shadow-md shadow-primary/20">
            2
          </div>
          <h3 class="text-lg font-bold text-on-surface">Customize Dot Patterns</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Pick from 39 matrix dot styles, 25 eye frames, 20 eyeballs, and multi-color linear or radial gradient palettes.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm space-y-4 relative">
          <div class="w-10 h-10 rounded-xl bg-primary text-white font-black text-lg flex items-center justify-center shadow-md shadow-primary/20">
            3
          </div>
          <h3 class="text-lg font-bold text-on-surface">Embed Brand Logo</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Upload your company SVG or PNG icon. Our engine automatically applies Level H error correction and safe quiet zone padding.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm space-y-4 relative">
          <div class="w-10 h-10 rounded-xl bg-primary text-white font-black text-lg flex items-center justify-center shadow-md shadow-primary/20">
            4
          </div>
          <h3 class="text-lg font-bold text-on-surface">Export in High-Res</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Download your customized QR code in lossless vector SVG for commercial printing, 300 DPI PDF, or high-res PNG up to 8K.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. LATEST FROM THE BLOG -->
    <section class="space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-3">
          <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-wider">Knowledge Hub</span>
          <h2 class="text-3xl font-black text-on-surface tracking-tight">QR Code Guides & Tips</h2>
          <p class="text-on-surface-variant max-w-xl">Learn how to make the most out of your QR codes with our latest guides, tutorials, and best practices.</p>
        </div>
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-primary-dark transition-colors whitespace-nowrap">
          View all articles <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {recentPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="group flex flex-col h-full border border-outline-variant/50 rounded-3xl overflow-hidden bg-surface-container-lowest hover:border-primary/30 hover:shadow-xl hover:shadow-primary/5 transition-all duration-300 transform hover:-translate-y-1">
            <div class="p-6 flex flex-col h-full">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-surface-container-high text-on-surface">
                  {post.data.category.replace('-', ' ')}
                </span>
                <span class="text-xs font-medium text-on-surface-variant">
                  {post.data.readingTime} min read
                </span>
              </div>
              <h3 class="text-xl font-bold text-on-surface mb-3 leading-tight group-hover:text-primary transition-colors line-clamp-2">
                {post.data.title}
