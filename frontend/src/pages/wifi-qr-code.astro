---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRGeneratorApp from '../react/QRGeneratorApp';
import Footer from '../components/layout/Footer.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "WiFi QR Code Generator", url: "/wifi-qr-code" }
];

const howTo = {
  name: "How to Create a WiFi QR Code",
  description: "Create a WiFi QR code that lets guests connect to your network instantly by scanning with their phone camera.",
  steps: [
    { name: "Select WiFi content type", text: "Open QR Code Maker and choose 'WiFi' from the content type selector in the Content tab." },
    { name: "Enter your network details", text: "Type your WiFi network name (SSID), select the security type (WPA/WPA2 or WEP), and enter your WiFi password." },
    { name: "Customize the design", text: "Choose from 40+ dot styles, add colors and gradients, pick a decorative frame, and optionally add a WiFi logo from the preset icons." },
    { name: "Download your WiFi QR code", text: "Download your QR code in PNG, SVG, or PDF format. Print it and display it at your restaurant, office, or home for guests to scan." }
  ]
};
---
<BaseLayout
  title="Free WiFi QR Code Generator — Share WiFi Password Instantly | QR Code Maker"
  description="Create a free WiFi QR code to share your network password instantly. Perfect for cafes, hotels, guests, and offices. No signup required."
  keywords="wifi qr code, share wifi password, wifi qr code generator, free wifi qr code, qr code for wifi"
  ogImage="/og-wifi.png"
  breadcrumbs={breadcrumbs}
  howTo={howTo}
>
  <style is:global>
    @import '../styles/global.css';
  </style>

  <main id="generator">
    <QRGeneratorApp client:load />
  </main>

  <section class="max-w-4xl mx-auto px-6 py-16 text-on-surface" id="about">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-center">Free WiFi QR Code Generator</h1>
    <p class="text-lg text-on-surface-variant text-center max-w-2xl mx-auto mb-12">
      Create a WiFi QR code that lets anyone connect to your network instantly — just scan with a phone camera. 
      No need to spell out complicated passwords. Perfect for restaurants, cafes, hotels, offices, Airbnbs, and home guest networks.
    </p>

    <!-- How It Works -->
    <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6 mb-16">
      <div class="text-center p-4">
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary text-2xl">wifi</span>
        </div>
        <h3 class="font-semibold mb-1">1. Select WiFi</h3>
        <p class="text-sm text-on-surface-variant">Choose WiFi as your QR code content type</p>
      </div>
      <div class="text-center p-4">
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary text-2xl">edit</span>
        </div>
        <h3 class="font-semibold mb-1">2. Enter Details</h3>
        <p class="text-sm text-on-surface-variant">Add your SSID, password, and security type</p>
      </div>
      <div class="text-center p-4">
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary text-2xl">palette</span>
        </div>
        <h3 class="font-semibold mb-1">3. Customize</h3>
        <p class="text-sm text-on-surface-variant">Style with colors, frames, and logos</p>
      </div>
      <div class="text-center p-4">
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary text-2xl">download</span>
        </div>
        <h3 class="font-semibold mb-1">4. Download</h3>
        <p class="text-sm text-on-surface-variant">Get PNG, SVG, or PDF — print and display</p>
      </div>
    </div>

    <!-- Use Cases -->
    <div class="border-t border-outline-variant pt-12 mb-12">
      <h2 class="text-2xl font-bold mb-6 text-center">Where to Use WiFi QR Codes</h2>
      <div class="grid sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
        <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary mt-0.5">restaurant</span>
          <div>
            <h3 class="font-semibold text-sm">Restaurants & Cafes</h3>
            <p class="text-xs text-on-surface-variant mt-1">Place WiFi QR codes on tables, menus, or at the counter so customers connect without asking staff.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary mt-0.5">hotel</span>
          <div>
            <h3 class="font-semibold text-sm">Hotels & Airbnbs</h3>
            <p class="text-xs text-on-surface-variant mt-1">Include in welcome packets or nightstand cards. Guests connect in seconds without reception calls.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary mt-0.5">business</span>
          <div>
            <h3 class="font-semibold text-sm">Offices & Co-working</h3>
            <p class="text-xs text-on-surface-variant mt-1">Display in meeting rooms and lobbies. Visitors join guest WiFi without IT support.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary mt-0.5">home</span>
          <div>
            <h3 class="font-semibold text-sm">Home Networks</h3>
            <p class="text-xs text-on-surface-variant mt-1">Frame a styled WiFi QR code near your router. Friends and family connect instantly.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ -->
    <div class="border-t border-outline-variant pt-12" id="faq">
      <h2 class="text-2xl font-bold mb-8 text-center">WiFi QR Code FAQ</h2>
      <div class="space-y-4 max-w-2xl mx-auto">
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            Is my WiFi password safe in the QR code?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            Your WiFi credentials are encoded directly into the QR code image — they are never sent to or stored on any server. 
            The QR code is generated entirely in your browser and backend without logging. However, anyone who scans the printed 
            QR code will be able to connect to your network, so treat it like you would a written-down password.
          </p>
        </details>
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            Which phones can scan WiFi QR codes?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            All modern smartphones support WiFi QR codes natively. On iPhone (iOS 11+), simply open the Camera app and point it 
            at the QR code. On Android (10+), use the Camera or Google Lens. The phone will prompt you to join the network automatically.
          </p>
        </details>
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            What security types are supported?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            QR Code Maker supports WPA/WPA2 (most common), WEP (legacy), and open/no-password networks. 
            Select the security type that matches your router's configuration for the QR code to work correctly.
          </p>
        </details>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

