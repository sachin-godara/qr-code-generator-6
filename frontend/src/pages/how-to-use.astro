---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "How to Use", url: "/how-to-use" }
];

const steps = [
  {
    number: "01",
    emoji: "📝",
    title: "Choose Your Content Type",
    description: "Select from 12 content types: URL, Plain Text, WiFi credentials, vCard contact, Email, SMS, Phone, App Store link, Event (iCal), Crypto wallet, or batch CSV upload. Each type has smart, tailored input fields.",
    tags: ["URL", "WiFi", "vCard", "Email", "SMS", "Batch CSV"],
    hint: "Tip: Use vCard to create a scannable digital business card instantly."
  },
  {
    number: "02",
    emoji: "🎨",
    title: "Design Your QR Style",
    description: "Choose from 39 dot patterns (squares, circles, rounded, fluid, leaves, diamonds, and more), 28 eye frame shapes, and matching eyeball styles. Mix and match to create a completely unique look.",
    tags: ["39 Dot Styles", "28 eye frames", "Custom Colors"],
    hint: "Tip: Use rounded or circular dots for a modern, premium feel."
  },
  {
    number: "03",
    emoji: "🖼️",
    title: "Add Your Logo",
    description: "Upload a custom PNG/JPG/SVG logo or pick from 46 preset brand icons. Set logo size, padding color, and shape (square or circle). The generator automatically selects H-level error correction to keep your QR scannable.",
    tags: ["Custom Upload", "46 Presets", "Auto Error Correction"],
    hint: "Tip: Use a white or matching background pad around dark logos."
  },
  {
    number: "04",
    emoji: "✨",
    title: "Apply Frames & Effects",
    description: "Wrap your QR code in one of 51 text frames with custom label text and fonts. Add shadow effects (glow, drop shadow, inset), canvas decorations, rounded corners, and background images.",
    tags: ["51 Text Frames", "Shadow Effects", "Background Images"],
    hint: "Tip: A simple bold frame with your website URL boosts engagement."
  },
  {
    number: "05",
    emoji: "⬇️",
    title: "Download & Share",
    description: "Export in PNG (up to 8K resolution), SVG (infinite vector scale), or PDF (print-ready). Batch mode exports all codes as a ZIP. Everything is completely free — no watermarks, no account, no limits.",
    tags: ["PNG up to 8K", "SVG Vector", "PDF Print-Ready", "Batch ZIP"],
    hint: "Tip: Use SVG for print materials — scales to any size perfectly."
  }
];

const features = [
  { icon: "qr_code_2",     color: "bg-violet-50 text-violet-600",   title: "12 Content Types",     desc: "URL, Text, WiFi, vCard, Email, SMS, Phone, App, Event, Crypto, Batch" },
  { icon: "grain",         color: "bg-blue-50 text-blue-600",       title: "39 Dot Patterns",     desc: "Squares, circles, rounded, fluid, stars, leaves, diamonds, hexagons" },
  { icon: "visibility",   color: "bg-sky-50 text-sky-600",          title: "28 eye frames",        desc: "Mix and match eye frames and eyeballs for a completely custom look" },
  { icon: "crop_free",     color: "bg-indigo-50 text-indigo-600",   title: "51 Text Frames",       desc: "Customizable label text, font, and color to brand every code" },
  { icon: "style",         color: "bg-fuchsia-50 text-fuchsia-600", title: "121 Templates",         desc: "One-click professional presets: Business, Social, Event, Crypto" },
  { icon: "image",         color: "bg-pink-50 text-pink-600",       title: "Logo Embedding",       desc: "Upload custom logo or pick from 46 brand presets with auto padding" },
  { icon: "gradient",      color: "bg-rose-50 text-rose-600",       title: "Gradient Modes",       desc: "Linear and radial gradients across dots, eyes, and background" },
  { icon: "auto_awesome",  color: "bg-orange-50 text-orange-600",   title: "Shadow & Glow Effects",  desc: "Glow, drop shadow, and inset shadow effects for depth and drama" },
  { icon: "wallpaper",     color: "bg-amber-50 text-amber-600",     title: "Background Images",    desc: "Use any image as QR canvas background for creative branding" },
  { icon: "dataset",       color: "bg-lime-50 text-lime-600",       title: "Batch ZIP Export",     desc: "Generate hundreds of unique QR codes from a CSV file in seconds" },
  { icon: "history",       color: "bg-green-50 text-green-600",     title: "Undo / Redo History",  desc: "Full design history with Ctrl+Z / Ctrl+Shift+Z keyboard shortcuts" },
  { icon: "preview",       color: "bg-teal-50 text-teal-600",       title: "Live Real-Time Preview",  desc: "Instant preview updates as you customize — no page reloads" },
];

const doTips = [
  { text: "Use Error Correction **H** when embedding a logo — it recovers up to 30% of the code." },
  { text: "Maintain a **4.5:1 contrast ratio** between foreground dots and background for reliable scanning." },
  { text: "Keep the **quiet zone** (white border) around the QR at least 4 module widths wide." },
  { text: "Test your QR code with **3 different scanner apps** before printing large batches." },
  { text: "For print, export as **SVG** or **PDF** to ensure crisp edges at any scale." },
];

const dontTips = [
  { text: "Don't **invert dark/light colors** without testing — some scanners fail on dark backgrounds." },
  { text: "Don't print QR codes **smaller than 2cm × 2cm** — scanners struggle at that size." },
  { text: "Don't use **low-contrast color combinations** (e.g., light gray on white)." },
  { text: "Don't crop the **finder patterns** (the three corner squares) when adding frames." },
  { text: "Don't use Error Correction **L** when your QR will be displayed on a textured surface." },
];

const exports = [
  {
    format: "PNG",
    icon: "photo_size_select_large",
    resolution: "Up to 8192 × 8192 px",
    useCase: "Digital displays, websites, social media, email signatures",
    pros: "Universal compatibility, small file size",
    notFor: "Large-scale print that needs to be resized"
  },
  {
    format: "SVG",
    icon: "polyline",
    resolution: "Infinite (vector)",
    useCase: "Print materials, business cards, billboards, signage",
    pros: "Scales to any size with zero quality loss",
    notFor: "Environments that don't support SVG (e.g., some email clients)"
  },
  {
    format: "PDF",
    icon: "picture_as_pdf",
    resolution: "Print-ready (300 DPI equivalent)",
    useCase: "Professional print shops, brochures, packaging, posters",
    pros: "Print-ready, embeds fonts and vectors, industry standard",
    notFor: "Web embeds or dynamic use cases"
  },
];

const faqs = [
  { q: "Is QR Code Maker really 100% free?", a: "Yes — every single feature is completely free. No paywalls, no premium tiers, no watermarks, and no sign-up required. You can generate unlimited QR codes with full customization and download in any format for free." },
  { q: "Can I use generated QR codes commercially?", a: "Yes, all QR codes you create are yours to use freely for any purpose, including commercial products, marketing materials, packaging, and client work." },
  { q: "How do I make sure my QR code will scan reliably?", a: "Use Error Correction level H when adding a logo, maintain a 4.5:1 contrast ratio between dots and background, keep the quiet zone (white border), and test with multiple scanner apps before printing. Our Pro Tips section covers all best practices in detail." },
  { q: "What is the maximum batch size?", a: "The batch generator can handle CSV files with hundreds of rows. Each row generates one unique QR code. All codes are exported as a single ZIP file download." },
  { q: "What's the difference between dot styles?", a: "Dot styles change the shape of every module (data cell) in your QR code. Options include classic squares, perfect circles, rounded corners, flowing fluid shapes, stars, diamonds, leaves, hexagons, and more. Each style creates a distinct visual character while remaining fully scannable." },
  { q: "Can I add my company logo to every QR code?", a: "Yes — upload a PNG, JPG, or SVG logo once and it will be embedded in the center of your QR code. You can control the logo size, padding color, and shape. Error Correction H is automatically recommended when a logo is detected." },
  { q: "Do QR codes expire?", a: "Static QR codes (the type this tool generates) never expire. They are simple data-encoded images with no tracking, no server dependency, and no expiry date. As long as the destination URL exists, the code will always work." },
  { q: "Which scanner apps work best for testing?", a: "We recommend testing with at least 3 apps: the native iOS Camera app, Google Lens on Android, and a dedicated scanner like QR Code Reader by Scan. Testing cross-platform ensures compatibility for all your users." },
  { q: "What's the difference between Eye Frames and Eyeballs?", a: "Eye Frames are the outer border of the three corner squares (finder patterns). Eyeballs are the inner square inside each finder pattern. Mixing different styles for frames and eyeballs creates a highly unique QR code appearance." },
  { q: "Can I undo mistakes while designing?", a: "Yes — every change is tracked in the design history. Press Ctrl+Z (or ⌘+Z on Mac) to undo, and Ctrl+Shift+Z to redo. You can step back through your entire design session." },
];

const howTo = {
  name: "How to Make a Custom QR Code in 5 Steps",
  description: "Learn how to create a fully customized QR code with colors, logos, frames, and effects — completely free, no signup required.",
  steps: steps.map(s => ({ name: s.title, text: s.description }))
};
---
<BaseLayout
  title="How to Make a QR Code — Create a QR Code for Free | GenerateCustomQR"
  description="Learn how to make a QR code for free in 5 simple steps. Complete guide to creating stunning custom QR codes, adding logos, and ensuring scannability."
  keywords="how to make a qr code, create a qr code, make a qr code, create qr code, how to use QR code maker, QR code guide, how to create qr code for website, qr code tutorial, qr code step by step, how to generate qr code"
  ogImage="/og-howto.jpg"
  breadcrumbs={breadcrumbs}
  howTo={howTo}
  faqs={faqs}
>
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/how-to-use.css';
  </style>
  
  <Header />

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  SECTION 1: CINEMATIC HERO               ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="htu-hero-bg relative overflow-hidden min-h-[92vh] flex flex-col items-center justify-center px-6 py-24 text-center">
    <!-- Floating QR silhouettes -->
    <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
      <!-- Top-left silhouette -->
      <div class="absolute top-10 left-8 sm:left-16 opacity-[0.07] htu-float-a">
        <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
          <rect x="4" y="4" width="48" height="48" rx="6" fill="#18181b"/>
          <rect x="14" y="14" width="28" height="28" rx="3" fill="#ffffff"/>
          <rect x="19" y="19" width="18" height="18" rx="2" fill="#18181b"/>
          <rect x="68" y="4" width="48" height="48" rx="6" fill="#18181b"/>
          <rect x="78" y="14" width="28" height="28" rx="3" fill="#ffffff"/>
          <rect x="83" y="19" width="18" height="18" rx="2" fill="#18181b"/>
          <rect x="4" y="68" width="48" height="48" rx="6" fill="#18181b"/>
          <rect x="14" y="78" width="28" height="28" rx="3" fill="#ffffff"/>
          <rect x="19" y="83" width="18" height="18" rx="2" fill="#18181b"/>
          <rect x="68" y="68" width="8" height="8" fill="#18181b"/>
          <rect x="80" y="68" width="8" height="8" fill="#18181b"/>
          <rect x="92" y="68" width="8" height="8" fill="#18181b"/>
          <rect x="104" y="68" width="8" height="8" fill="#18181b"/>
          <rect x="68" y="80" width="8" height="8" fill="#18181b"/>
          <rect x="80" y="80" width="8" height="8" fill="#18181b"/>
          <rect x="92" y="92" width="8" height="8" fill="#18181b"/>
          <rect x="104" y="80" width="8" height="8" fill="#18181b"/>
          <rect x="68" y="92" width="8" height="8" fill="#18181b"/>
          <rect x="80" y="104" width="8" height="8" fill="#18181b"/>
          <rect x="104" y="104" width="8" height="8" fill="#18181b"/>
        </svg>
      </div>
      <!-- Bottom-right silhouette -->
      <div class="absolute bottom-16 right-8 sm:right-20 opacity-[0.06] htu-float-b">
        <svg width="90" height="90" viewBox="0 0 90 90" fill="none">
          <rect x="3" y="3" width="36" height="36" rx="5" fill="#7c3aed"/>
          <rect x="10" y="10" width="22" height="22" rx="2" fill="#ffffff"/>
          <rect x="15" y="15" width="12" height="12" rx="1" fill="#7c3aed"/>
          <rect x="51" y="3" width="36" height="36" rx="5" fill="#7c3aed"/>
          <rect x="58" y="10" width="22" height="22" rx="2" fill="#ffffff"/>
          <rect x="63" y="15" width="12" height="12" rx="1" fill="#7c3aed"/>
          <rect x="3" y="51" width="36" height="36" rx="5" fill="#7c3aed"/>
          <rect x="10" y="58" width="22" height="22" rx="2" fill="#ffffff"/>
          <rect x="15" y="63" width="12" height="12" rx="1" fill="#7c3aed"/>
          <rect x="51" y="51" width="6" height="6" fill="#7c3aed"/>
          <rect x="60" y="51" width="6" height="6" fill="#7c3aed"/>
          <rect x="69" y="60" width="6" height="6" fill="#7c3aed"/>
          <rect x="78" y="51" width="6" height="6" fill="#7c3aed"/>
          <rect x="51" y="60" width="6" height="6" fill="#7c3aed"/>
          <rect x="60" y="78" width="6" height="6" fill="#7c3aed"/>
        </svg>
      </div>
      <!-- Center-right silhouette -->
      <div class="absolute top-1/3 right-4 sm:right-12 opacity-[0.05] htu-float-c hidden sm:block">
        <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
          <rect x="2" y="2" width="24" height="24" rx="3" fill="#2563eb"/>
          <rect x="6" y="6" width="16" height="16" rx="2" fill="#ffffff"/>
          <rect x="9" y="9" width="10" height="10" rx="1" fill="#2563eb"/>
          <rect x="34" y="2" width="24" height="24" rx="3" fill="#2563eb"/>
          <rect x="38" y="6" width="16" height="16" rx="2" fill="#ffffff"/>
          <rect x="41" y="9" width="10" height="10" rx="1" fill="#2563eb"/>
          <rect x="2" y="34" width="24" height="24" rx="3" fill="#2563eb"/>
          <rect x="6" y="38" width="16" height="16" rx="2" fill="#ffffff"/>
          <rect x="9" y="41" width="10" height="10" rx="1" fill="#2563eb"/>
          <rect x="34" y="34" width="5" height="5" fill="#2563eb"/>
          <rect x="42" y="34" width="5" height="5" fill="#2563eb"/>
          <rect x="50" y="42" width="5" height="5" fill="#2563eb"/>
          <rect x="34" y="50" width="5" height="5" fill="#2563eb"/>
        </svg>
      </div>
    </div>

    <!-- Pill badge -->
    <div class="htu-reveal inline-flex items-center gap-2 bg-white/80 border border-white/60 backdrop-blur-sm rounded-full px-4 py-1.5 text-sm font-semibold text-on-surface-variant mb-6 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
      Complete Guide — Updated 2025
    </div>

    <!-- Main headline -->
    <h1 class="htu-reveal delay-1 text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight leading-[1.05] mb-6 max-w-4xl">
      Master
      <span class="htu-accent-text"> QR Code Maker</span>
      <br />in Minutes
    </h1>

    <p class="htu-reveal delay-2 text-lg sm:text-xl text-on-surface-variant max-w-2xl mb-10 leading-relaxed">
      Everything you need to create stunning, scannable QR codes — from your first code to batch exports for hundreds. No experience required.
    </p>

    <!-- CTA Buttons -->
    <div class="htu-reveal delay-3 flex flex-wrap items-center justify-center gap-4 mb-16">
      <a
        href="/"
        class="inline-flex items-center gap-2.5 bg-primary text-on-primary font-bold text-base px-7 py-3.5 rounded-xl shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
        id="hero-start-creating-btn"
      >
        <span class="material-symbols-outlined text-[20px] group-hover:rotate-12 transition-transform duration-300">qr_code_2</span>
        Start Creating Free
      </a>
      <a
        href="#steps"
        class="inline-flex items-center gap-2.5 bg-white border border-outline-variant text-on-surface font-semibold text-base px-6 py-3.5 rounded-xl hover:shadow-md hover:-translate-y-1 transition-all duration-300 group"
        id="hero-see-how-btn"
      >
        See How It Works
        <span class="material-symbols-outlined text-[20px] group-hover:translate-y-0.5 transition-transform duration-300">expand_more</span>
      </a>
    </div>

    <!-- Quick stats row -->
    <div class="htu-reveal delay-4 flex flex-wrap items-center justify-center gap-8 sm:gap-12">
      {[
        { value: "39", label: "Dot Styles" },
        { value: "51",  label: "Text Frames" },
        { value: "121",  label: "Templates" },
        { value: "100%", label: "Free Forever" },
      ].map(stat => (
        <div class="text-center">
          <div class="text-3xl font-bold text-on-surface tracking-tight">{stat.value}</div>
          <div class="text-xs font-medium text-on-surface-variant uppercase tracking-widest mt-0.5">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  SECTION 2: 5-STEP WALKTHROUGH          ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section id="steps" class="max-w-5xl mx-auto px-6 py-24">
    <div class="text-center mb-16 htu-reveal">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-on-surface-variant bg-surface-container px-3 py-1 rounded-full mb-4">Step by Step</span>
      <h2 class="text-4xl sm:text-5xl font-bold text-on-surface mb-4">Five Steps to a Perfect QR Code</h2>
      <div class="htu-section-divider"></div>
    </div>

    <div class="space-y-6" id="steps-list">
      {steps.map((step, i) => (
        <div
          class={`htu-step-card p-6 sm:p-8 htu-reveal delay-${i + 1}`}
          id={`step-card-${i + 1}`}
        >
          <div class="flex flex-col sm:flex-row gap-5 sm:gap-8">
            <!-- Left: number + emoji -->
            <div class="flex sm:flex-col items-center sm:items-center gap-3 sm:gap-2 flex-shrink-0">
              <div class="htu-step-badge">{step.number}</div>
              <div class="text-3xl">{step.emoji}</div>
            </div>
            <!-- Right: content -->
            <div class="flex-1 min-w-0">
              <h3 class="text-xl font-bold text-on-surface mb-3">{step.title}</h3>
              <p class="text-on-surface-variant leading-relaxed mb-4">{step.description}</p>
              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mb-4">
                {step.tags.map(tag => (
                  <span class="px-2.5 py-1 bg-surface-container text-on-surface-variant text-xs font-semibold rounded-full border border-outline-variant/50">
                    {tag}
                  </span>
                ))}
              </div>
              <!-- Hint box -->
              <div class="flex items-start gap-2.5 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-sm text-amber-800 font-medium">
                <span class="material-symbols-outlined text-[18px] text-amber-500 flex-shrink-0 mt-0.5">lightbulb</span>
                {step.hint}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  SECTION 3: FEATURE SHOWCASE GRID       ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="bg-gradient-to-b from-surface-container/40 to-transparent py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16 htu-reveal">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-on-surface-variant bg-white px-3 py-1 rounded-full border border-outline-variant mb-4">Full Feature Set</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-on-surface mb-4">Everything You Can Create</h2>
        <p class="text-on-surface-variant max-w-xl mx-auto">12 content types, unlimited design combinations, and zero paywalls. Here's the complete arsenal at your fingertips.</p>
        <div class="htu-section-divider"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="features-grid">
        {features.map((feat, i) => (
          <div
            class={`htu-glass-card rounded-2xl p-6 htu-reveal delay-${(i % 3) + 1}`}
            id={`feature-card-${i + 1}`}
          >
            <div class={`htu-feature-icon ${feat.color} rounded-2xl mb-4`}>
              <span class="material-symbols-outlined text-[24px]">{feat.icon}</span>
            </div>
            <h3 class="font-bold text-on-surface text-base mb-1.5">{feat.title}</h3>
            <p class="text-sm text-on-surface-variant leading-relaxed">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  SECTION 4: PRO TIPS & BEST PRACTICES  ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="max-w-5xl mx-auto px-6 py-24">
    <div class="text-center mb-16 htu-reveal">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-on-surface-variant bg-surface-container px-3 py-1 rounded-full mb-4">Expert Advice</span>
      <h2 class="text-4xl sm:text-5xl font-bold text-on-surface mb-4">Pro Tips for Reliable Scanning</h2>
      <p class="text-on-surface-variant max-w-xl mx-auto">Follow these proven best practices to ensure your QR codes scan flawlessly in every environment.</p>
      <div class="htu-section-divider"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Do's -->
      <div class="htu-reveal delay-1">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-xl bg-green-100 flex items-center justify-center">
            <span class="material-symbols-outlined text-green-600 text-[20px]">check_circle</span>
          </div>
          <h3 class="text-xl font-bold text-green-800">Best Practices ✅</h3>
        </div>
        <div class="space-y-3">
          {doTips.map((tip, i) => (
            <div class="htu-tip-do flex items-start gap-3" id={`do-tip-${i + 1}`}>
              <span class="material-symbols-outlined text-green-500 text-[18px] flex-shrink-0 mt-0.5">done</span>
              <p class="text-sm text-green-900 leading-relaxed" set:html={tip.text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
            </div>
          ))}
        </div>
      </div>
      <!-- Don'ts -->
      <div class="htu-reveal delay-2">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-xl bg-red-100 flex items-center justify-center">
            <span class="material-symbols-outlined text-red-500 text-[20px]">cancel</span>
          </div>
          <h3 class="text-xl font-bold text-red-800">Common Mistakes ❌</h3>
        </div>
        <div class="space-y-3">
          {dontTips.map((tip, i) => (
            <div class="htu-tip-dont flex items-start gap-3" id={`dont-tip-${i + 1}`}>
              <span class="material-symbols-outlined text-red-400 text-[18px] flex-shrink-0 mt-0.5">close</span>
              <p class="text-sm text-red-900 leading-relaxed" set:html={tip.text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  SECTION 5: EXPORT FORMAT COMPARISON    ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="bg-gradient-to-b from-transparent via-surface-container/30 to-transparent py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16 htu-reveal">
