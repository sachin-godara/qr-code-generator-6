---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRGeneratorApp from '../react/QRGeneratorApp';
import Footer from '../components/layout/Footer.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Event QR Code Generator", url: "/event-qr-code" }
];

const howTo = {
  name: "How to Create an Event QR Code",
  description: "Generate a QR code that adds a calendar event to someone's phone when scanned.",
  steps: [
    { name: "Select Event content type", text: "Open QR Code Maker and choose 'Event' from the content type options." },
    { name: "Enter event details", text: "Add the event title, description, location, start date/time, and end date/time." },
    { name: "Design your QR code", text: "Customize with colors, event-themed templates, and add a calendar logo from presets." },
    { name: "Download and share", text: "Download in PNG, SVG, or PDF. Add to invitations, posters, tickets, or email signatures." }
  ]
};
---
<BaseLayout
  title="Free Event QR Code Generator — Calendar Invite QR | QR Code Maker"
  description="Create a free event QR code that adds calendar events to any phone. Perfect for invitations, tickets, conference badges, and event posters. No signup required."
  keywords="event qr code, calendar qr code, event qr code generator, qr code for events, calendar invite qr code, ics qr code"
  breadcrumbs={breadcrumbs}
  howTo={howTo}
>
  <style is:global>
    @import '../styles/global.css';
  </style>

  <main id="generator">
    <QRGeneratorApp client:load />
  </main>

  <section class="max-w-4xl mx-auto px-6 py-16 text-on-surface" id="about">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-center">Free Event QR Code Generator</h1>
    <p class="text-lg text-on-surface-variant text-center max-w-2xl mx-auto mb-12">
      Generate QR codes that add events directly to someone's calendar when scanned. 
      Include event title, description, location, start and end times. 
      Perfect for wedding invitations, concert tickets, conference badges, and event posters.
    </p>

    <div class="grid sm:grid-cols-2 gap-4 max-w-2xl mx-auto mb-12">
      <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-container-lowest border border-outline-variant">
        <span class="material-symbols-outlined text-primary mt-0.5">celebration</span>
        <div>
          <h3 class="font-semibold text-sm">Weddings & Parties</h3>
          <p class="text-xs text-on-surface-variant mt-1">Add a QR code to save-the-dates and invitations so guests instantly add the event to their calendar.</p>
        </div>
      </div>
      <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-container-lowest border border-outline-variant">
        <span class="material-symbols-outlined text-primary mt-0.5">stadium</span>
        <div>
          <h3 class="font-semibold text-sm">Conferences & Meetups</h3>
          <p class="text-xs text-on-surface-variant mt-1">Print on badges, programs, or signage. Attendees scan to save session times and venue details.</p>
        </div>
      </div>
      <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-container-lowest border border-outline-variant">
        <span class="material-symbols-outlined text-primary mt-0.5">confirmation_number</span>
        <div>
          <h3 class="font-semibold text-sm">Tickets & Flyers</h3>
          <p class="text-xs text-on-surface-variant mt-1">Add to digital or printed tickets so attendees never forget when and where to show up.</p>
        </div>
      </div>
      <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-container-lowest border border-outline-variant">
        <span class="material-symbols-outlined text-primary mt-0.5">school</span>
        <div>
          <h3 class="font-semibold text-sm">Classes & Workshops</h3>
          <p class="text-xs text-on-surface-variant mt-1">Share class schedules, workshop times, and recurring sessions with a single scannable QR code.</p>
        </div>
      </div>
    </div>

    <div class="border-t border-outline-variant pt-12" id="faq">
      <h2 class="text-2xl font-bold mb-8 text-center">Event QR Code FAQ</h2>
      <div class="space-y-4 max-w-2xl mx-auto">
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            Which calendar apps are supported?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            Event QR codes use the standard iCalendar (ICS) format, which is compatible with Google Calendar, 
            Apple Calendar, Outlook, Samsung Calendar, and virtually every calendar app on iOS and Android.
          </p>
        </details>
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            Can I include a location link?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            Yes, the location field accepts any text — including a physical address or a Google Maps link. 
            When the event is added to the calendar, the location will be clickable for navigation.
          </p>
        </details>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

