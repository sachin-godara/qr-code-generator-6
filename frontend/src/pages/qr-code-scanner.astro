---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import QRScannerApp from '../react/scanner/QRScannerApp';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "QR Code Scanner", url: "/qr-code-scanner" }
];

const faqs = [
  { q: "Do I need to download a QR code reader app?", a: "No! Most modern smartphones have a QR code scanner built directly into the native Camera app. Simply open your camera, point it at the code, and tap the link that appears. Alternatively, you can use our free web-based scanner above without downloading anything." },
  { q: "How do I scan a QR code on Android?", a: "Open your Camera app and point it at the QR code. If a link doesn't appear automatically, look for the Google Lens icon in your camera (it looks like a small camera lens). Tap it to activate Lens and scan the code. You can also use the free web scanner on this page." },
  { q: "How do I scan a QR code on an iPhone (iOS)?", a: "Open the default Camera app from your Home Screen, Control Center, or Lock Screen. Select the rear-facing camera and hold your device so that the QR code appears in the viewfinder. Your device will recognize the QR code and show a notification. Tap the notification to open the link associated with the QR code." },
  { q: "Can I scan a QR code from a screenshot or image?", a: "Yes! If someone sent you a QR code in a text or email and you saved it to your photos, you can use the 'Upload Image' tab on our scanner above. Simply select the saved image, and our tool will instantly decode it." },
  { q: "Why won't my QR code scan?", a: "Common reasons a QR code won't scan include: poor lighting, blurry printing, the code is too small, there isn't enough contrast between the dark dots and the light background, or the 'quiet zone' (the white space around the outside) has been covered up." }
];
---
<BaseLayout
  title="Free QR Code Scanner & Reader — Scan from Camera or Image"
  description="Instantly scan and read QR codes online. Use your device's camera or upload a saved QR code image. 100% free, no app download required, works on Android and iOS."
  keywords="qr code scanner, qr code reader, how to scan a qr code, how to scan qr code on android, read qr code, scan qr code online, free qr code scanner"
>
  <!-- Import global styles -->
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/legal.css';
  </style>

  <div class="min-h-screen bg-surface flex flex-col">
    <Header />
    <!-- Main Content wrapper -->
    <div class="flex-1 flex flex-col">
      
      <!-- Premium Hero Section -->
      <section class="relative pt-24 pb-16 lg:pt-32 lg:pb-24 overflow-hidden isolate px-4">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-surface to-surface"></div>
        <div class="absolute inset-y-0 right-1/2 -z-10 -mr-96 w-[200%] origin-top-right skew-x-[-30deg] bg-surface-container-lowest shadow-xl shadow-primary/5 ring-1 ring-primary/10 sm:-mr-80 lg:-mr-96"></div>
        
        <div class="max-w-4xl mx-auto text-center space-y-8 relative">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-semibold tracking-wide border border-primary/20">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            Online Scanner
          </div>
          
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-on-surface tracking-tight leading-[1.1]">
            Free QR Code <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-500">Scanner</span>
          </h1>
          
          <p class="text-lg sm:text-xl text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
            Instantly decode any QR code without downloading a sketchy app. Use your camera or upload a saved image directly from your gallery.
          </p>

          <!-- Client-side React Scanner App -->
          <div class="mt-12 text-left">
            <QRScannerApp client:only="react" />
          </div>
        </div>
      </section>

      <!-- Educational Content Section -->
      <section class="py-16 bg-surface-container-lowest px-4 border-t border-outline-variant/30">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-black text-on-surface mb-8 text-center">How to Scan a QR Code</h2>
          
          <div class="grid md:grid-cols-2 gap-8 mb-16">
            <div class="bg-surface-container rounded-3xl p-8 border border-outline-variant/50">
              <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-2xl">phone_iphone</span>
              </div>
              <h3 class="text-xl font-bold text-on-surface mb-3">On iPhone (iOS)</h3>
              <p class="text-on-surface-variant leading-relaxed">
                You do not need a third-party app. Simply open the native <strong>Camera</strong> app on your iPhone, point it at the QR code so it appears in the viewfinder, and tap the yellow link that pops up.
              </p>
            </div>

            <div class="bg-surface-container rounded-3xl p-8 border border-outline-variant/50">
              <div class="w-12 h-12 bg-green-100 text-green-600 rounded-xl flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-2xl">android</span>
              </div>
              <h3 class="text-xl font-bold text-on-surface mb-3">On Android</h3>
              <p class="text-on-surface-variant leading-relaxed">
                Most modern Android phones support scanning directly from the <strong>Camera</strong> app. If yours doesn't, tap the <strong>Google Lens</strong> icon (the small camera symbol) in the search bar or camera app to scan.
              </p>
            </div>
          </div>

          <!-- FAQ Section -->
          <div class="bg-surface rounded-3xl p-8 md:p-12 border border-outline-variant shadow-lg">
            <h2 class="text-3xl font-black text-on-surface mb-8">Frequently Asked Questions</h2>
            <div class="space-y-6">
              {faqs.map((faq) => (
                <div class="border-b border-outline-variant/50 pb-6 last:border-0 last:pb-0">
                  <h3 class="text-lg font-bold text-on-surface mb-2">{faq.q}</h3>
                  <p class="text-on-surface-variant leading-relaxed">{faq.a}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- CTA Banner -->
          <div class="mt-16 bg-gradient-to-r from-primary to-emerald-600 rounded-3xl p-8 md:p-12 text-center text-white shadow-xl relative overflow-hidden isolate">
            <div class="absolute inset-0 -z-10 bg-[url('/grain.png')] opacity-20 mix-blend-overlay"></div>
            <h2 class="text-3xl font-black mb-4">Need to Make a QR Code Instead?</h2>
            <p class="text-primary-50 text-lg mb-8 max-w-2xl mx-auto">
              Our free QR Code Creator lets you generate stunning codes with custom colors, shapes, and logos in seconds.
            </p>
            <a href="/" class="inline-flex items-center gap-2 bg-white text-primary px-8 py-4 rounded-full font-bold hover:bg-surface-container-lowest transition-colors shadow-lg">
              <span class="material-symbols-outlined">qr_code_2</span>
              Create a QR Code for Free
            </a>
          </div>

        </div>
      </section>

    </div>
    
    <Footer />
  </div>
</BaseLayout>
