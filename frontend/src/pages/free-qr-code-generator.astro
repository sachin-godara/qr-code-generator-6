---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRGeneratorApp from '../react/QRGeneratorApp';
import Footer from '../components/layout/Footer.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Free QR Code Generator", url: "/free-qr-code-generator" }
];

const howTo = {
  name: "How to Generate a Free Custom QR Code",
  description: "Create a fully customized QR code with colors, logos, and frames — completely free, no signup required.",
  steps: [
    { name: "Enter your content", text: "Choose a content type (URL, text, WiFi, vCard, etc.) and enter the data you want to encode." },
    { name: "Choose a design template", text: "Browse 121 ready-made templates or start from scratch with 39 dot styles and eye patterns." },
    { name: "Customize colors and effects", text: "Pick foreground/background colors, add gradients, apply shadow effects, and adjust canvas settings." },
    { name: "Add a logo", text: "Upload your own logo or choose from 46 preset brand icons with automatic background removal." },
    { name: "Download for free", text: "Export your QR code in PNG, SVG, or PDF — all completely free, no watermarks, no signup." }
  ]
};
const faqs = [
  { q: "Is this QR code generator really 100% free?", a: "Yes! GenerateCustomQR is completely free with no hidden fees, no watermarks, no signup required, and no premium tiers. Every feature — including logo embedding, 40+ dot styles, batch generation, and SVG/PDF export — is available at zero cost." },
  { q: "Do I need to create an account to generate QR codes?", a: "No. You can start creating QR codes immediately without signing up, logging in, or providing any personal information. Your data stays in your browser." },
  { q: "What makes this better than other free QR code generators?", a: "Unlike most competitors that lock design features behind paid plans, GenerateCustomQR gives you full access to 40+ dot styles, 51 text frames, 121 templates, logo embedding, batch CSV generation, and high-resolution PNG/SVG/PDF downloads — all completely free." },
  { q: "Can I use the QR codes for commercial purposes?", a: "Yes! All QR codes you generate are yours to use freely for any purpose, including marketing materials, product packaging, business cards, restaurant menus, and client projects." },
  { q: "Do the QR codes expire or stop working?", a: "No. QR codes generated here are static — the data is encoded directly into the image. They never expire, require no server, and work forever as long as the encoded URL or content exists." }
];
---
<BaseLayout
  title="Free QR Code Generator — Custom Design, No Signup, No Watermark | GenerateCustomQR"
  description="100% free QR code generator with 39 dot styles, 51 text frames, 121 Templates, and logo embedding. No signup, no watermarks. Download in PNG, SVG, or PDF."
  keywords="free qr code generator, qr code generator free, free qr code maker, qr code generator no signup, qr code generator no watermark, custom qr code free, qr code maker online free, qr code generator no expiration, free qr code no login"
  ogImage="/og-free.jpg"
  breadcrumbs={breadcrumbs}
  howTo={howTo}
  faqs={faqs}
>
  <style is:global>
    @import '../styles/global.css';
  </style>

  <main id="generator">
    <QRGeneratorApp client:load />
  </main>

  <section class="max-w-4xl mx-auto px-6 py-16 text-on-surface" id="about">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-center">Free QR Code Generator — No Signup, No Watermarks</h1>
    <p class="text-lg text-on-surface-variant text-center max-w-2xl mx-auto mb-12">
      GenerateCustomQR is the most customizable free QR code generator online. Unlike other tools that hide 
      features behind paywalls, every single feature is free — 39 dot styles, 51 text frames, 121 Templates, 
      logo embedding, batch generation, and PNG/SVG/PDF export. No signup. No watermarks. No limits.
    </p>

    <div class="border-t border-outline-variant pt-12 mb-12">
      <h2 class="text-2xl font-bold mb-6 text-center">Why GenerateCustomQR is the Best Free Option</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse max-w-2xl mx-auto">
          <thead>
            <tr class="border-b border-outline-variant">
              <th class="text-left py-3 px-4 font-semibold">Feature</th>
              <th class="text-center py-3 px-4 font-semibold text-primary">GenerateCustomQR</th>
              <th class="text-center py-3 px-4 font-semibold text-on-surface-variant">Others</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">Price</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">100% Free</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">$5–$50/month</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">Signup Required</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">No</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">Usually yes</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">Watermarks</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">None</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">On free tier</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">Dot Styles</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">39</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">8–25</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">Text Frames</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">51</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">3–12</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">PDF Export</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">Free</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">Paid only</td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-2.5 px-4">Batch Generation</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">Up to 500</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">Paid only</td>
            </tr>
            <tr>
              <td class="py-2.5 px-4">Content Types</td>
              <td class="text-center py-2.5 px-4 font-semibold text-primary">12</td>
              <td class="text-center py-2.5 px-4 text-on-surface-variant">5–8 free</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="border-t border-outline-variant pt-12 mb-12">
      <h2 class="text-2xl font-bold mb-6 text-center">Everything You Get for Free</h2>
      <div class="grid sm:grid-cols-2 gap-3 max-w-2xl mx-auto">
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">39 unique dot module styles</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">19 eye frames + 23 eyeball styles</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">51 decorative text & CTA frames</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">22 layout frame designs</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">121 ready-made templates</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">46 preset logo icons</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">Custom logo upload + bg removal</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">PNG, SVG, and PDF export</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">Transparent background</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">Batch CSV generation (500 max)</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">4 gradient types</span>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm">Per-eye independent styling</span>
        </div>
      </div>
    </div>

    <div class="border-t border-outline-variant pt-12" id="faq">
      <h2 class="text-2xl font-bold mb-8 text-center">Free QR Code Generator FAQ</h2>
      <div class="space-y-4 max-w-2xl mx-auto">
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            Is it really 100% free?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            Yes — every feature is completely free with no strings attached. No signup required, no watermarks, no usage limits, 
            no premium tier. You get full access to all 39 dot styles, 51 text frames, 121 Templates, logo embedding, 
            batch generation, and all export formats (PNG, SVG, PDF) at no cost.
          </p>
        </details>
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            Do the QR codes expire?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            No. The QR codes you create are static — the data is encoded directly into the image. 
            They will work forever as long as the content they point to (like a URL) remains active. 
            There is no expiration date and no ongoing subscription needed.
          </p>
        </details>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

