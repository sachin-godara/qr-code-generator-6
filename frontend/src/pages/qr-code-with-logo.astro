---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRGeneratorApp from '../react/QRGeneratorApp';
import Footer from '../components/layout/Footer.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "QR Code with Logo", url: "/qr-code-with-logo" }
];

const howTo = {
  name: "How to Add a Logo to a QR Code",
  description: "Create a branded QR code with your company logo embedded in the center while keeping it fully scannable.",
  steps: [
    { name: "Enter your content", text: "Type a URL, text, or other content for your QR code in the Content tab." },
    { name: "Go to the Logo tab", text: "Click the Logo tab in the sidebar to access logo embedding options." },
    { name: "Upload or choose a preset logo", text: "Upload your own logo image or select from 30+ preset brand icons (Instagram, WhatsApp, YouTube, etc.)." },
    { name: "Adjust logo settings", text: "Fine-tune the logo size, card shape, dot clearance, and optionally enable background removal for a clean look." },
    { name: "Download your branded QR code", text: "Download in PNG, SVG, or PDF. The QR code automatically uses high error correction to stay scannable with the logo." }
  ]
};
---
<BaseLayout
  title="QR Code with Logo — Free Logo QR Code Generator | QR Code Maker"
  description="Add your company logo to a QR code for free. Upload custom logos or use 30+ preset brand icons. Auto background removal, dot clearance, and error correction to stay scannable."
  keywords="qr code with logo, logo qr code generator, branded qr code, custom logo qr code, qr code with image, business qr code with logo"
  breadcrumbs={breadcrumbs}
  howTo={howTo}
>
  <style is:global>
    @import '../styles/global.css';
  </style>

  <main id="generator">
    <QRGeneratorApp client:load />
  </main>

  <section class="max-w-4xl mx-auto px-6 py-16 text-on-surface" id="about">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-center">QR Code with Logo — Free Generator</h1>
    <p class="text-lg text-on-surface-variant text-center max-w-2xl mx-auto mb-12">
      Make your QR codes instantly recognizable by embedding your brand logo in the center. 
      Upload any image or choose from 30+ preset brand icons. Our smart error correction ensures 
      your QR code stays 100% scannable — even with large logos.
    </p>

    <div class="grid sm:grid-cols-3 gap-8 mb-16">
      <div class="text-center p-4">
        <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary text-3xl">upload</span>
        </div>
        <h2 class="font-semibold text-lg mb-2">Upload Any Logo</h2>
        <p class="text-sm text-on-surface-variant">Upload PNG, JPG, or SVG logos. Built-in background removal strips white or colored backgrounds automatically.</p>
      </div>
      <div class="text-center p-4">
        <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary text-3xl">grid_view</span>
        </div>
        <h2 class="font-semibold text-lg mb-2">30+ Preset Icons</h2>
        <p class="text-sm text-on-surface-variant">Choose from Instagram, WhatsApp, YouTube, Facebook, TikTok, LinkedIn, Discord, Spotify, and more — with brand colors.</p>
      </div>
      <div class="text-center p-4">
        <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary text-3xl">tune</span>
        </div>
        <h2 class="font-semibold text-lg mb-2">Smart Dot Clearance</h2>
        <p class="text-sm text-on-surface-variant">Adjustable clearance zone around your logo removes interfering QR dots. No other free tool offers this level of control.</p>
      </div>
    </div>

    <div class="border-t border-outline-variant pt-12 mb-12">
      <h2 class="text-2xl font-bold mb-6 text-center">Logo Features You Won't Find Elsewhere</h2>
      <div class="space-y-3 max-w-2xl mx-auto">
        <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary">check_circle</span>
          <span class="text-sm"><strong>Automatic Background Removal</strong> — strips white/colored logo backgrounds with adjustable tolerance</span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary">check_circle</span>
          <span class="text-sm"><strong>Dot Clearance Slider</strong> — controls how much space around the logo is cleared of QR dots</span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary">check_circle</span>
          <span class="text-sm"><strong>Card Shapes</strong> — place your logo in a circle or rounded square card with customizable padding</span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary">check_circle</span>
          <span class="text-sm"><strong>Icon Styles</strong> — badge, duotone, and glyph rendering modes for preset icons</span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest border border-outline-variant">
          <span class="material-symbols-outlined text-primary">check_circle</span>
          <span class="text-sm"><strong>Brand & Custom Colors</strong> — use official brand colors or pick your own for preset icons</span>
        </div>
      </div>
    </div>

    <div class="border-t border-outline-variant pt-12" id="faq">
      <h2 class="text-2xl font-bold mb-8 text-center">Logo QR Code FAQ</h2>
      <div class="space-y-4 max-w-2xl mx-auto">
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            Will adding a logo make my QR code unscannable?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            No — QR Code Maker automatically uses the highest error correction level (Level H, 30% redundancy) 
            when a logo is present. This means up to 30% of the QR data can be obscured and it will still scan. 
            Combined with the dot clearance feature, your QR code remains reliable.
          </p>
        </details>
        <details class="group border border-outline-variant rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm">
          <summary class="flex justify-between items-center p-4 min-h-[56px] cursor-pointer font-semibold hover:bg-surface-container-low transition-colors select-none">
            What logo file formats are supported?
            <span class="material-symbols-outlined transition-transform group-open:rotate-180 text-primary">expand_more</span>
          </summary>
          <p class="px-4 pb-4 pt-1 text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/30">
            You can upload PNG, JPG, JPEG, GIF, SVG, and WebP logo files. For best results, use a PNG with 
            transparent background or enable the built-in background removal tool to strip solid-color backgrounds.
          </p>
        </details>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

